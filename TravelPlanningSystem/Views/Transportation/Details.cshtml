@using TravelPlanningSystem.Models.Transportation
@model Trip

@{
    ViewData["Title"] = "Trip Details";
    var avgRating = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.Rating), 1) : 0;
    var discountedPrice = Model.BaseFare * (1 - Model.DiscountPercentage / 100);
}

<link rel="stylesheet"
      href="~/css/transportation.css"
      asp-append-version="true" />

<section class="trip-details-section">

    <div class="container-fluid px-5">

        <!-- Back Button -->
        <div class="back-navigation">
            <a asp-controller="Transportation" asp-action="Index" class="back-link">
                <i class="bi bi-chevron-left"></i> Back to results
            </a>
        </div>

        <div class="trip-details-container">

            <!-- Main Content -->
            <main class="details-main">

                <!-- Trip Header -->
                <div class="details-header">
                    <div class="route-section">
                        <h1>@Model.Route?.Origin → @Model.Route?.Destination</h1>
                        <p class="route-date">@Model.DepartureTime.ToString("dddd, MMMM d, yyyy")</p>
                    </div>

                    <div class="status-badge-large @Model.Status.ToLower()">
                        @Model.Status
                    </div>
                </div>

                <!-- Trip Timing & Route Info -->
                <div class="trip-timing-card">

                    <div class="timing-row">
                        <div class="timing-column">
                            <div class="time-display">
                                <span class="time">@Model.DepartureTime.ToString("HH:mm")</span>
                                <span class="label">Departure</span>
                                <span class="location">@Model.Route?.Origin</span>
                            </div>
                        </div>

                        <div class="timing-column timing-middle">
                            <div class="duration-display">
                                <div class="timeline"></div>
                                <span class="duration">
                                    @{
                                        var duration = Model.ArrivalTime - Model.DepartureTime;
                                        var hours = (int)duration.TotalHours;
                                        var minutes = duration.Minutes;
                                    }
                                    @if (hours > 0)
                                    {
                                        @:@hours h @minutes min
                                    }
                                    else
                                    {
                                        @:@minutes min
                                    }
                                </span>
                            </div>
                        </div>

                        <div class="timing-column">
                            <div class="time-display">
                                <span class="time">@Model.ArrivalTime.ToString("HH:mm")</span>
                                <span class="label">Arrival</span>
                                <span class="location">@Model.Route?.Destination</span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Route?.Stops))
                    {
                        <div class="stops-info">
                            <strong>Stops:</strong> @Model.Route.Stops
                        </div>
                    }

                </div>

                <!-- Vehicle Information -->
                <div class="vehicle-details-card">

                    <h2>Vehicle Information</h2>

                    <div class="vehicle-grid">
                        <div class="vehicle-item">
                            <span class="label">Vehicle Type</span>
                            <span class="value">@Model.Vehicle?.VehicleType</span>
                        </div>
                        <div class="vehicle-item">
                            <span class="label">Model</span>
                            <span class="value">@Model.Vehicle?.VehicleModel</span>
                        </div>
                        <div class="vehicle-item">
                            <span class="label">Seating Capacity</span>
                            <span class="value">@Model.Vehicle?.SeatingCapacity seats</span>
                        </div>
                        <div class="vehicle-item">
                            <span class="label">Year</span>
                            <span class="value">@Model.Vehicle?.ManufactureYear</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Vehicle?.Amenities))
                    {
                        <div class="amenities-section">
                            <h3>Amenities</h3>
                            <div class="amenities-list">
                                @foreach (var amenity in Model.Vehicle.Amenities.Split(','))
                                {
                                    <span class="amenity-tag">
                                        <i class="bi bi-check-circle"></i> @amenity.Trim()
                                    </span>
                                }
                            </div>
                        </div>
                    }

                </div>

                <!-- Availability & Pricing -->
                <div class="availability-pricing-card">

                    <h2>Availability & Pricing</h2>

                    <div class="availability-grid">
                        <div class="availability-item">
                            <span class="label">Total Seats</span>
                            <span class="value">@Model.TotalSeats</span>
                        </div>
                        <div class="availability-item">
                            <span class="label">Available Seats</span>
                            <span class="value @(Model.AvailableSeats > 0 ? "available" : "unavailable")">
                                @Model.AvailableSeats
                            </span>
                        </div>
                        <div class="availability-item">
                            <span class="label">Booked Seats</span>
                            <span class="value">@(Model.TotalSeats - Model.AvailableSeats)</span>
                        </div>
                        <div class="availability-item">
                            <span class="label">Occupancy Rate</span>
                            <span class="value">@Math.Round((decimal)(Model.TotalSeats - Model.AvailableSeats) / Model.TotalSeats * 100, 0)%</span>
                        </div>
                    </div>

                    <div class="progress-bar-section">
                        <span class="label">Seat Availability</span>
                        <div class="progress">
                            <div class="progress-fill" style="width: @(Model.AvailableSeats > 0 ? (decimal)Model.AvailableSeats / Model.TotalSeats * 100 : 0)%"></div>
                        </div>
                    </div>

                </div>

               <!-- Ratings & Reviews (增强版) -->
                <div class="reviews-card" id="reviewsSection">

                    <div class="reviews-header d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h2 class="mb-1">Passenger Reviews</h2>
                            <div class="average-rating">
                                <i class="bi bi-star-fill text-warning"></i>
                                <span class="rating">@avgRating</span>
                                <span class="count">(@Model.Reviews.Count() reviews)</span>
                            </div>
                        </div>

                        <!-- ⭐ 点击弹出写评价弹窗 -->
                        <button type="button" class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#writeReviewModal">
                            <i class="bi bi-pencil-square"></i> Write a Review
                        </button>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="reviews-list">
                        @if (Model.Reviews.Any())
                        {
                            @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt).Take(8))
                            {
                                <div class="review-item">
                                    <div class="review-header d-flex justify-content-between">
                                        <div class="reviewer-info">
                                            <span class="reviewer-name fw-bold">@review.User?.FirstName @review.User?.LastName</span>
                                            <span class="review-date text-muted small ms-2">@review.CreatedAt.ToString("MMM d, yyyy")</span>
                                        </div>
                                        <div class="review-rating text-warning">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(review.Title))
                                    {
                                        <h4 class="review-title fw-bold mt-2 fs-6">@review.Title</h4>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                                    {
                                        <p class="review-comment text-muted mb-0">@review.Comment</p>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-chat-square-heart fs-3 d-block mb-2"></i>
                                <span>No reviews for this journey yet. Be the first passenger to share your experience!</span>
                            </div>
                        }
                    </div>

                </div>

                <!-- ⭐ 写评价弹窗 Modal -->
                <div class="modal fade" id="writeReviewModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-controller="Transportation" asp-action="AddReview" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="TripId" value="@Model.TripId" />
                                <input type="hidden" name="Rating" id="selectedStarRating" value="5" />

                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold" style="color: #06143b;">
                                        <i class="bi bi-star-fill text-warning"></i> Review Your Journey
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>

                                <div class="modal-body">
                                    <!-- 交互式五星评分条 -->
                                    <div class="text-center mb-3">
                                        <label class="form-label small fw-bold d-block text-muted">How was your overall experience?</label>
                                        <div id="starRatingGroup" class="fs-2 text-warning" style="cursor: pointer;">
                                            <i class="bi bi-star-fill star-btn" data-star="1"></i>
                                            <i class="bi bi-star-fill star-btn" data-star="2"></i>
                                            <i class="bi bi-star-fill star-btn" data-star="3"></i>
                                            <i class="bi bi-star-fill star-btn" data-star="4"></i>
                                            <i class="bi bi-star-fill star-btn" data-star="5"></i>
                                        </div>
                                        <span id="starRatingDesc" class="badge bg-light text-primary border mt-1">5 Stars - Excellent</span>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Review Title</label>
                                        <input type="text" name="Title" class="form-control" placeholder="e.g. Comfortable ride &amp; on time!" required />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Your Review Comments</label>
                                        <textarea name="Comment" class="form-control" rows="4" placeholder="Tell other passengers about the vehicle cleanliness, punctuality and driver service..." required></textarea>
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary fw-bold px-4">Submit Review</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 星级点击互动脚本 -->
                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const stars = document.querySelectorAll('.star-btn');
                        const ratingInput = document.getElementById('selectedStarRating');
                        const desc = document.getElementById('starRatingDesc');
                        const descriptions = ['', '1 Star - Poor', '2 Stars - Fair', '3 Stars - Good', '4 Stars - Very Good', '5 Stars - Excellent'];

                        stars.forEach(s => {
                            s.addEventListener('click', function () {
                                const val = parseInt(this.getAttribute('data-star'));
                                ratingInput.value = val;
                                desc.innerText = descriptions[val];

                                stars.forEach((item, idx) => {
                                    if (idx < val) {
                                        item.classList.remove('bi-star');
                                        item.classList.add('bi-star-fill');
                                    } else {
                                        item.classList.remove('bi-star-fill');
                                        item.classList.add('bi-star');
                                    }
                                });
                            });
                        });
                    });
                </script>

            </main>

            <!-- Sidebar - Booking Info -->
            <aside class="details-sidebar">

                <div class="booking-card">

                    <div class="booking-header">
                        <h2>Trip Summary</h2>
                    </div>

                    <div class="booking-details">

                        <div class="detail-row">
                            <span class="label">Route</span>
                            <span class="value">@Model.Route?.Origin → @Model.Route?.Destination</span>
                        </div>

                        <div class="detail-row">
                            <span class="label">Date</span>
                            <span class="value">@Model.DepartureTime.ToString("ddd, MMM d")</span>
                        </div>

                        <div class="detail-row">
                            <span class="label">Departure</span>
                            <span class="value">@Model.DepartureTime.ToString("HH:mm")</span>
                        </div>

                        <div class="detail-row">
                            <span class="label">Vehicle</span>
                            <span class="value">@Model.Vehicle?.VehicleModel</span>
                        </div>

                        <div class="detail-row border-top">
                            <span class="label">Base Fare</span>
                            <span class="value">RM @Model.BaseFare.ToString("F2")</span>
                        </div>

                        @if (Model.DiscountPercentage > 0)
                        {
                            <div class="detail-row discount">
                                <span class="label">Discount (@Model.DiscountPercentage%)</span>
                                <span class="value discount-value">-RM @((Model.BaseFare * Model.DiscountPercentage / 100)).ToString("F2")</span>
                            </div>
                        }

                    </div>

                    <div class="total-price">
                        <span class="label">Total Price</span>
                        <span class="price">RM @discountedPrice.ToString("F2")</span>
                    </div>

                    @if (Model.AvailableSeats > 0)
                    {
                    <a asp-controller="Transportation" 
                        asp-action="Book" 
                        asp-route-id="@Model.TripId" 
                        class="btn btn-book-now text-center text-decoration-none d-block">
                        Select Seats & Book Now <i class="bi bi-arrow-right"></i>
                    </a>
                    }
                    else
                    {
                        <button class="btn btn-unavailable" disabled>
                            No Seats Available
                        </button>
                    }

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="notes-card">
                        <h3>Important Notes</h3>
                        <p>@Model.Notes</p>
                    </div>
                }

            </aside>

        </div>

    </div>

</section>
