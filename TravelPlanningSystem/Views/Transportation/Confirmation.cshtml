@model TravelPlanningSystem.Models.Transportation.TransportationBooking

@{
    ViewData["Title"] = "E-Receipt & Boarding Pass - " + Model.BookingReference;
    var trip = Model.Trip!;
}

<link rel="stylesheet" href="~/css/transportation.css" asp-append-version="true" />

<style>
    .confirmation-page { background: #eef2ff; padding: 40px 0 80px; min-height: 90vh; }
    
    /* ⭐ 精修外围卡片：细腻包边 + 圆角裁剪，彻底消除生硬外框 */
    .ticket-container {
        max-width: 860px;
        margin: 0 auto;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 16px 40px rgba(6, 20, 59, 0.08);
        overflow: hidden;
        border: 1px solid #cbd5e1;
    }

    .ticket-top-banner {
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: #fff;
        padding: 24px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .ticket-brand h2 { font-size: 1.55rem; font-weight: 800; margin: 0; color: #fff !important; display: flex; align-items: center; gap: 10px; }
    .ticket-brand small { color: rgba(255,255,255,0.85); font-size: 0.8rem; letter-spacing: 0.5px; }
    .ticket-status-pill {
        background: #22c55e !important;
        color: #fff !important;
        font-weight: 800;
        font-size: 0.75rem;
        padding: 6px 15px;
        border-radius: 30px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .ticket-main { padding: 28px 32px 15px; }

    /* 路线与航轴 */
    .route-visualizer {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 18px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }
    .station-city { font-size: 1.35rem; font-weight: 800; color: #06143b; line-height: 1.2; }
    .station-time { font-size: 1.15rem; font-weight: 700; color: #2563eb; }
    
    .route-mid-track { flex: 1; padding: 0 25px; text-align: center; }
    .track-line { height: 2px; background: #cbd5e1; position: relative; margin: 10px 0; }
    .track-line::before, .track-line::after { content: ''; position: absolute; width: 8px; height: 8px; border-radius: 50%; background: #2563eb; top: -3px; }
    .track-line::before { left: 0; }
    .track-line::after { right: 0; }
    .bus-indicator { display: inline-block; background: #2563eb; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 3px 12px; border-radius: 20px; }

    /* 核心信息网格 */
    .meta-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px 20px;
        margin-bottom: 20px;
        padding-bottom: 18px;
        border-bottom: 1px solid #e2e8f0;
    }
    .meta-item .label { font-size: 0.72rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 2px; display: block; }
    .meta-item .val { font-size: 1rem; font-weight: 800; color: #0f172a; white-space: nowrap; }

    /* 乘客名单表格 */
    .passengers-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 20px;
    }
    .passenger-table { width: 100%; border-collapse: collapse; margin-bottom: 0; }
    .passenger-table th { background: #f1f5f9; font-size: 0.75rem; font-weight: 800; color: #475569; text-transform: uppercase; padding: 10px 14px; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
    .passenger-table td { padding: 11px 14px; font-size: 0.9rem; border-bottom: 1px solid #f1f5f9; vertical-align: middle; white-space: nowrap; }
    .seat-token { background: #2563eb !important; color: #fff !important; font-weight: 800; font-size: 0.8rem; padding: 4px 10px; border-radius: 6px; }

    /* ⭐ 精致化收据账单卡片 (彻底解决 Net Total 换行错位问题) */
    .receipt-invoice-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 22px;
    }
    .invoice-item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        font-size: 0.88rem;
        color: #475569;
    }
    .invoice-item-row span { display: flex; align-items: center; gap: 6px; }
    .invoice-item-row strong { color: #0f172a; font-weight: 700; }
    
    .invoice-total-row {
        border-top: 1.5px dashed #cbd5e1;
        padding-top: 12px;
        margin-top: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .invoice-total-label { font-size: 0.92rem; font-weight: 800; color: #06143b; text-transform: uppercase; letter-spacing: 0.5px; }
    .invoice-total-price { font-size: 1.35rem; font-weight: 800; color: #16a34a; }

    /* 打孔撕票线 */
    .ticket-divider-wrap { position: relative; display: flex; align-items: center; padding: 4px 0; }
    .notch-left, .notch-right { position: absolute; width: 24px; height: 24px; background: #eef2ff; border-radius: 50%; z-index: 2; }
    .notch-left { left: -12px; }
    .notch-right { right: -12px; }
    .dashed-rip-line { width: 100%; border-top: 2px dashed #cbd5e1; margin: 0 12px; }

    .ticket-stub { background: #fafbfc; padding: 20px 32px 24px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
    .qr-area img { width: 110px; height: 110px; border-radius: 8px; border: 1px solid #cbd5e1; background: #fff; padding: 4px; }

    /* ⭐ 打印引擎优化 */
    @@media print {
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        @@page {
            size: A4 portrait;
            margin: 0.8cm 1cm;
        }
        
        nav, header, footer, .navbar, .main-navbar, .no-print, .btn, .dashboard-heading {
            display: none !important;
        }

        body, .confirmation-page {
            background: #fff !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* 打印时去除外部硬框重影，保持优雅圆角 */
        .container, .container-fluid {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .ticket-container {
            width: 100% !important;
            max-width: 100% !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 14px !important;
            box-shadow: none !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
            overflow: hidden !important;
        }

        .ticket-top-banner {
            background: #1e3a8a !important;
            color: #fff !important;
            padding: 18px 24px !important;
        }
        .ticket-brand h2 { color: #fff !important; }
        .ticket-status-pill { background: #22c55e !important; color: #fff !important; }
        .seat-token { background: #2563eb !important; color: #fff !important; }
        .route-visualizer { background: #f8fafc !important; }
        .receipt-invoice-card { background: #f8fafc !important; }
        .ticket-stub { background: #fafbfc !important; }

        .ticket-main { padding: 18px 24px 10px !important; }
        .meta-grid { margin-bottom: 14px !important; padding-bottom: 12px !important; }
        .passenger-table th, .passenger-table td { padding: 8px 10px !important; font-size: 8.5pt !important; }

        .notch-left, .notch-right { display: none !important; }
    }
</style>

<div class="confirmation-page">
    <div class="container">
        
        <!-- 顶部成功提示 -->
        <div class="text-center mb-4 no-print">
            <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3 shadow-sm" style="width: 56px; height: 56px; font-size: 1.7rem;">
                <i class="bi bi-check-lg"></i>
            </div>
            <h2 class="fw-bold" style="color: #06143b;">Booking Confirmed &amp; Issued!</h2>
            <p class="text-muted">Your payment was successful and your official boarding pass has been generated.</p>
        </div>

        <!-- ⭐ 电子车票卡片 -->
        <div class="ticket-container" id="eTicketCard">
            
            <!-- 头部品牌条 -->
            <div class="ticket-top-banner">
                <div class="ticket-brand">
                    <h2><i class="bi bi-bus-front-fill"></i> TravelMate Express</h2>
                    <small>OFFICIAL PASSENGER BOARDING PASS &bull; TAX INVOICE RECEIPT</small>
                </div>
                <div class="ticket-status-pill">
                    <i class="bi bi-check-circle-fill"></i> @Model.BookingStatus
                </div>
            </div>

            <!-- 主体行程区 -->
            <div class="ticket-main">
                
                <!-- 行程路线航轴 -->
                <div class="route-visualizer">
                    <div style="min-width: 170px;">
                        <div class="station-city">@trip.Route?.Origin</div>
                        <div class="station-time"><i class="bi bi-clock"></i> @trip.DepartureTime.ToString("HH:mm")</div>
                        <small class="text-muted">Origin Terminal</small>
                    </div>

                    <div class="route-mid-track">
                        <span class="bus-indicator">
                            <i class="bi bi-bus-front"></i> @Math.Round((trip.ArrivalTime - trip.DepartureTime).TotalHours, 1)h &bull; Non-Stop Express
                        </span>
                        <div class="track-line"></div>
                        <span class="badge bg-light text-primary border px-2 py-1" style="font-size: 0.7rem; font-weight: 700;">CONFIRMED SERVICE</span>
                    </div>

                    <div style="min-width: 170px; text-align: right;">
                        <div class="station-city">@trip.Route?.Destination</div>
                        <div class="station-time"><i class="bi bi-clock"></i> @trip.ArrivalTime.ToString("HH:mm")</div>
                        <small class="text-muted">Arrival Destination</small>
                    </div>
                </div>

                <!-- 核心订单信息网格 -->
                <div class="meta-grid">
                    <div class="meta-item">
                        <span class="label">Booking Reference</span>
                        <span class="val text-primary font-monospace fs-5">@Model.BookingReference</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Travel Date</span>
                        <span class="val">@trip.DepartureTime.ToString("ddd, dd MMM yyyy")</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Vehicle / Fleet</span>
                        <span class="val">@trip.Vehicle?.VehicleModel</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Primary Contact</span>
                        <span class="val">@Model.ContactName</span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Payment Method</span>
                        <span class="val text-dark">
                            <i class="bi bi-wallet2 text-primary"></i> @Model.PaymentMethod
                        </span>
                    </div>
                    <div class="meta-item">
                        <span class="label">Total Paid Amount</span>
                        <span class="val text-success fs-5">RM @Model.TotalAmount.ToString("F2")</span>
                    </div>
                </div>

                <!-- 乘客名单明细 -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0" style="color: #06143b; font-size: 0.98rem;">
                        <i class="bi bi-people-fill text-primary"></i> Passenger Manifest &amp; Seat Assignment
                    </h5>
                    <small class="text-muted">@Model.Passengers.Count Passenger(s)</small>
                </div>

                <div class="passengers-card">
                    <table class="passenger-table">
                        <thead>
                            <tr>
                                <th>Passenger Name</th>
                                <th>IC / Passport Number</th>
                                <th class="text-center">Category</th>
                                <th class="text-center">Assigned Seat</th>
                                <th>Baggage Allowance</th>
                                <th class="text-center">Protection</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Passengers)
                            {
                                <tr>
                                    <td class="fw-bold fs-6">@p.FullName</td>
                                    <td class="font-monospace fw-bold text-muted">@p.IdNumber</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@p.PassengerType</span></td>
                                    <td class="text-center"><span class="seat-token">Seat @p.SeatNumber</span></td>
                                    <td>@p.BaggageOption</td>
                                    <td class="text-center">
                                        @if (p.HasTravelInsurance)
                                        {
                                            <span class="text-success fw-bold"><i class="bi bi-shield-check"></i> Insured</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- ⭐ 优雅收据账单卡片：左侧明细，右侧金额独立对齐，绝不错位折行 -->
                <div class="receipt-invoice-card">
                    <div class="invoice-item-row">
                        <span><i class="bi bi-ticket-perforated text-muted"></i> Bus Seats Base Fare (@Model.Passengers.Count Pax)</span>
                        <strong>RM @Model.BaseFareTotal.ToString("F2")</strong>
                    </div>

                    @if (Model.BaggageFeeTotal > 0)
                    {
                        <div class="invoice-item-row">
                            <span><i class="bi bi-suitcase-lg text-muted"></i> Extra Baggage Allowance Add-ons</span>
                            <strong>+ RM @Model.BaggageFeeTotal.ToString("F2")</strong>
                        </div>
                    }

                    @if (Model.InsuranceFeeTotal > 0)
                    {
                        <div class="invoice-item-row">
                            <span><i class="bi bi-shield-check text-muted"></i> Travel Medical &amp; Trip Protection Insurance</span>
                            <strong>+ RM @Model.InsuranceFeeTotal.ToString("F2")</strong>
                        </div>
                    }

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="invoice-item-row text-success">
                            <span><i class="bi bi-tag-fill"></i> Promo Code Discount (@Model.PromoCode)</span>
                            <strong>- RM @Model.DiscountAmount.ToString("F2")</strong>
                        </div>
                    }

                    <div class="invoice-total-row">
                        <div>
                            <span class="invoice-total-label">NET TOTAL AMOUNT PAID</span>
                            <small class="d-block text-muted" style="font-size: 0.76rem;">
                                Inclusive of all SST, terminal service charges &bull; Paid via @Model.PaymentMethod
                            </small>
                        </div>
                        <div class="invoice-total-price">
                            RM @Model.TotalAmount.ToString("F2")
                        </div>
                    </div>
                </div>

            </div>

            <!-- 车票撕票线与凹槽 -->
            <div class="ticket-divider-wrap">
                <div class="notch-left"></div>
                <div class="dashed-rip-line"></div>
                <div class="notch-right"></div>
            </div>

            <!-- 底部存根与防伪条码 -->
            <div class="ticket-stub">
                <div style="max-width: 580px;">
                    <!-- 模拟条形码 SVG -->
                    <div class="mb-2">
                        <svg width="220" height="28" viewBox="0 0 220 28" style="display: block;">
                            <rect x="0" y="0" width="4" height="28" fill="#1e293b"/>
                            <rect x="6" y="0" width="2" height="28" fill="#1e293b"/>
                            <rect x="12" y="0" width="6" height="28" fill="#1e293b"/>
                            <rect x="22" y="0" width="2" height="28" fill="#1e293b"/>
                            <rect x="28" y="0" width="8" height="28" fill="#1e293b"/>
                            <rect x="40" y="0" width="3" height="28" fill="#1e293b"/>
                            <rect x="48" y="0" width="5" height="28" fill="#1e293b"/>
                            <rect x="58" y="0" width="2" height="28" fill="#1e293b"/>
                            <rect x="65" y="0" width="7" height="28" fill="#1e293b"/>
                            <rect x="76" y="0" width="4" height="28" fill="#1e293b"/>
                            <rect x="85" y="0" width="2" height="28" fill="#1e293b"/>
                            <rect x="92" y="0" width="6" height="28" fill="#1e293b"/>
                            <rect x="103" y="0" width="3" height="28" fill="#1e293b"/>
                            <rect x="110" y="0" width="5" height="28" fill="#1e293b"/>
                            <rect x="120" y="0" width="2" height="28" fill="#1e293b"/>
                            <rect x="126" y="0" width="8" height="28" fill="#1e293b"/>
                            <rect x="138" y="0" width="3" height="28" fill="#1e293b"/>
                            <rect x="146" y="0" width="5" height="28" fill="#1e293b"/>
                            <rect x="156" y="0" width="2" height="28" fill="#1e293b"/>
                            <rect x="162" y="0" width="6" height="28" fill="#1e293b"/>
                            <rect x="174" y="0" width="4" height="28" fill="#1e293b"/>
                            <rect x="182" y="0" width="7" height="28" fill="#1e293b"/>
                            <rect x="194" y="0" width="2" height="28" fill="#1e293b"/>
                            <rect x="200" y="0" width="5" height="28" fill="#1e293b"/>
                            <rect x="210" y="0" width="4" height="28" fill="#1e293b"/>
                        </svg>
                        <span class="font-monospace text-muted" style="font-size: 0.68rem; letter-spacing: 2px;">@Model.BookingReference</span>
                    </div>

                    <h6 class="fw-bold mb-1" style="color: #06143b; font-size: 0.88rem;">Official Boarding Instructions</h6>
                    <p class="text-muted small mb-1" style="font-size: 0.78rem; line-height: 1.35;">
                        Please present this digital e-receipt or printed boarding slip at the terminal check-in counter. 
                        Passengers are advised to arrive <strong>15 minutes</strong> prior to scheduled departure.
                    </p>
                    <div class="text-muted font-monospace" style="font-size: 0.72rem;">
                        GATE VERIFIED &bull; TERMINAL DISPATCH OK &bull; STATUS: <strong>ACTIVE TICKET</strong>
                    </div>
                </div>

                <div class="qr-area">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=115x115&data=@Model.BookingReference" alt="Boarding QR Code" />
                    <div class="small fw-bold text-muted mt-1" style="font-size: 0.72rem;">Scan for Gate Entry</div>
                </div>
            </div>

        </div>

        <!-- 底部功能按钮 -->
        <div class="text-center mt-4 no-print d-flex justify-content-center gap-3">
            <button onclick="window.print()" class="btn btn-outline-primary btn-lg px-4 fw-bold shadow-sm">
                <i class="bi bi-printer"></i> Print E-Receipt
            </button>
            <a asp-action="MyBookings" class="btn btn-secondary btn-lg px-4 fw-bold shadow-sm">
                <i class="bi bi-ticket-detailed"></i> View My Bookings
            </a>
            <a asp-action="Index" class="btn btn-primary btn-lg px-4 fw-bold shadow-sm">
                <i class="bi bi-compass"></i> Book Another Trip
            </a>
        </div>

    </div>
</div>