@model TravelPlanningSystem.ViewModels.TransportationSearchViewModel

@{
    ViewData["Title"] = "Search Coaches & VIP Vans - TravelMate";
}

<link rel="stylesheet" href="~/css/transportation.css" asp-append-version="true" />

<style>
    .flight-style-hero {
        background: radial-gradient(circle at 85% 20%, #1e3a8a 0%, #0a1931 55%, #050d1a 100%);
        color: #fff;
        padding: 60px 0 110px;
        position: relative;
        overflow: hidden;
    }
    
    .hero-eyebrow {
        color: #60a5fa;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        display: block;
        margin-bottom: 12px;
    }
    
    .flight-style-hero h1 {
        font-size: 2.8rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }

    .flight-style-hero p {
        color: #94a3b8;
        font-size: 1.05rem;
        max-width: 520px;
        line-height: 1.5;
    }

    .hero-animation-box {
        position: absolute;
        right: 8%;
        top: 25px;
        width: 380px;
        height: 180px;
        pointer-events: none;
    }
    
    .live-badge {
        position: absolute;
        top: 15px;
        right: 25px;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 5px 14px;
        border-radius: 30px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
        animation: pulse 1.8s infinite;
    }
    @@keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(34, 197, 94, 0); }
        100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
    }

    .travel-arc { position: absolute; width: 100%; height: 100%; }
    .bus-moving-icon {
        position: absolute;
        font-size: 1.8rem;
        color: #60a5fa;
        filter: drop-shadow(0 0 12px rgba(96, 165, 250, 0.8));
        animation: vehicleFloat 4s ease-in-out infinite;
        top: 60px;
        right: 120px;
    }
    @@keyframes vehicleFloat {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(-3deg); }
    }

    .floating-search-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(6, 20, 59, 0.12);
        padding: 32px 36px;
        margin-top: -65px;
        position: relative;
        z-index: 10;
        border: 1px solid #f1f5f9;
    }

    .search-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }
    .search-card-top h3 { font-size: 1.35rem; font-weight: 800; color: #06143b; margin: 0 0 4px; }
    .search-card-top p { color: #64748b; font-size: 0.88rem; margin: 0; }
    
    .service-pill-tabs {
        display: inline-flex;
        background: #f1f5f9;
        padding: 4px;
        border-radius: 30px;
        margin-bottom: 18px;
        gap: 4px;
    }
    .pill-tab {
        border: none;
        background: transparent;
        color: #64748b;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 7px 18px;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .pill-tab.active {
        background: #fff;
        color: #2563eb;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .search-grid-layout {
        display: grid;
        grid-template-columns: 2fr 45px 2fr 1.6fr;
        gap: 12px;
        align-items: center;
        margin-bottom: 18px;
    }

    .location-input-wrap { position: relative; }
    .location-input-wrap label { font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 4px; display: block; }
    .location-field { position: relative; display: flex; align-items: center; }
    .location-field i { position: absolute; left: 14px; color: #2563eb; font-size: 1.1rem; }
    .location-field input {
        width: 100%;
        padding: 13px 14px 13px 40px;
        border-radius: 12px;
        border: 1.5px solid #cbd5e1;
        font-weight: 600;
        font-size: 0.95rem;
        color: #0f172a;
        transition: all 0.2s ease;
    }
    .location-field input:focus { border-color: #2563eb; outline: none; box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15); }

    .autocomplete-list {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(6, 20, 59, 0.15);
        border: 1px solid #e2e8f0;
        margin-top: 6px;
        z-index: 100;
        max-height: 220px;
        overflow-y: auto;
        display: none;
    }
    .autocomplete-item {
        padding: 10px 16px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #1e293b;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: background 0.15s ease;
    }
    .autocomplete-item:hover { background: #f1f5f9; color: #2563eb; }

    .swap-btn-wrap { padding-top: 20px; text-align: center; }
    .swap-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1.5px solid #cbd5e1;
        background: #fff;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .swap-btn:hover { background: #eef2ff; color: #2563eb; border-color: #2563eb; transform: rotate(180deg); }

    .bottom-search-row { display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap; }
    .secondary-inputs { display: flex; gap: 15px; align-items: center; }
    .search-btn-primary {
        background: #2563eb;
        color: #fff;
        border: none;
        padding: 12px 34px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
        transition: all 0.2s ease;
    }
    .search-btn-primary:hover { background: #1d4ed8; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(37, 99, 235, 0.4); }

    .trips-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 22px;
    }
    
    .pro-journey-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 4px 20px rgba(6, 20, 59, 0.04);
        transition: all 0.26s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
    }
    .pro-journey-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #3b82f6, #60a5fa);
        opacity: 0;
        transition: opacity 0.2s ease;
    }
    .pro-journey-card:hover {
        transform: translateY(-6px);
        border-color: #93c5fd;
        box-shadow: 0 16px 36px rgba(37, 99, 235, 0.12);
    }
    .pro-journey-card:hover::before {
        opacity: 1;
    }

    .card-meta-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }
    .vehicle-tag {
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 8px;
        letter-spacing: 0.5px;
    }
    .vehicle-tag.vip { background: #fdf4ff; color: #a855f7; border: 1px solid #f0abfc; }
    .vehicle-tag.coach { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
    .vehicle-tag.express { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
    
    .travel-date-tag {
        font-size: 0.78rem;
        font-weight: 700;
        color: #64748b;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .route-title-box {
        margin-bottom: 18px;
    }
    .route-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #06143b;
        display: flex;
        align-items: center;
        gap: 8px;
        line-height: 1.3;
        margin: 0;
    }
    .route-title i {
        color: #2563eb;
        font-size: 0.95rem;
    }

    .card-timeline {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }
    .timeline-node { text-align: left; }
    .timeline-node.end { text-align: right; }
    .node-time { font-size: 1.25rem; font-weight: 800; color: #06143b; line-height: 1; display: block; margin-bottom: 3px; }
    .node-label { font-size: 0.7rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; }

    .timeline-track-mid {
        flex: 1;
        padding: 0 16px;
        text-align: center;
    }
    .duration-text {
        font-size: 0.75rem;
        font-weight: 800;
        color: #2563eb;
        background: #eff6ff;
        padding: 2px 8px;
        border-radius: 10px;
        display: inline-block;
        margin-bottom: 4px;
    }
    .timeline-bar {
        height: 2px;
        background: #cbd5e1;
        position: relative;
        margin: 4px 0;
    }
    .timeline-bar::before, .timeline-bar::after {
        content: '';
        position: absolute;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #2563eb;
        top: -2px;
    }
    .timeline-bar::before { left: 0; }
    .timeline-bar::after { right: 0; }

    .card-fleet-status {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8rem;
        margin-bottom: 18px;
        color: #64748b;
    }
    .fleet-model {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 60%;
    }
    .seats-alert-badge {
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
    }
    .seats-alert-badge.available { background: #eff6ff; color: #2563eb; }
    .seats-alert-badge.urgent { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }

    .card-bottom-checkout {
        border-top: 1px dashed #e2e8f0;
        padding-top: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .price-group { line-height: 1; }
    .price-strike { font-size: 0.75rem; color: #94a3b8; text-decoration: line-through; display: block; margin-bottom: 2px; }
    .price-now { font-size: 1.45rem; font-weight: 800; color: #06143b; }
    .price-unit { font-size: 0.75rem; color: #64748b; font-weight: 600; }

    .btn-select-journey {
        background: #2563eb;
        color: #fff;
        font-weight: 700;
        font-size: 0.88rem;
        padding: 10px 18px;
        border-radius: 10px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }
    .btn-select-journey:hover {
        background: #1d4ed8;
        color: #fff;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    }
    .btn-select-journey i {
        transition: transform 0.2s ease;
    }
    .btn-select-journey:hover i {
        transform: translateX(4px);
    }

    .price-quick-chips {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
        flex-wrap: wrap;
        align-items: center;
    }
    .price-chip {
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .price-chip:hover { border-color: #3b82f6; color: #2563eb; background: #eff6ff; }
    .price-chip.active { background: #2563eb; color: #fff; border-color: #2563eb; box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25); }

    .results-loading-overlay { opacity: 0.4; pointer-events: none; transition: opacity 0.2s ease; }
</style>

<section class="flight-style-hero">
    <div class="container-fluid px-5 position-relative">
        <div>
            <span class="hero-eyebrow">
                <i class="bi bi-bus-front-fill me-1"></i> INTERCITY COACH &amp; VIP VAN EXPRESS
            </span>
            <h1>Where will you travel next?</h1>
            <p>Check live coach schedules, compare database ticket fares and reserve your seat instantly.</p>
        </div>

        <div class="hero-animation-box">
            <div class="live-badge">
                <span class="pulse-dot"></span>
                <span>LIVE EXPRESS SEARCH</span>
            </div>

            <svg class="travel-arc" viewBox="0 0 380 180">
                <path d="M 40 140 Q 200 30 340 70" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="2.5" stroke-dasharray="6 6" />
                <circle cx="40" cy="140" r="4" fill="#60a5fa" />
                <circle cx="340" cy="70" r="5" fill="#22c55e" />
            </svg>

            <div class="bus-moving-icon">
                <i class="bi bi-bus-front-fill"></i>
            </div>
        </div>
    </div>
</section>

<div class="container-fluid px-5">
    <div class="floating-search-card">
        
        <div class="search-card-top">
            <div>
                <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 1px;">PLAN YOUR JOURNEY</span>
                <h3>Search and compare intercity bus &amp; coach</h3>
                <p>Choose your destination and we will check live schedules with local seat availability.</p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-broadcast text-success me-1"></i> Live status</span>
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-shield-check text-primary me-1"></i> Secure booking</span>
            </div>
        </div>

        <div class="service-pill-tabs">
            <button type="button" 
                    class="pill-tab @(string.IsNullOrEmpty(Model.VehicleType) ? "active" : "")" 
                    onclick="filterByVehicle('')">
                <i class="bi bi-grid-fill me-1"></i> All Services
            </button>
            <button type="button" 
                    class="pill-tab @(Model.VehicleType == "VIP Van" ? "active" : "")" 
                    onclick="filterByVehicle('VIP Van')">
                <i class="bi bi-star-fill text-warning me-1"></i> VIP Van Luxury
            </button>
            <button type="button" 
                    class="pill-tab @(Model.VehicleType == "Luxury Coach" ? "active" : "")" 
                    onclick="filterByVehicle('Luxury Coach')">
                <i class="bi bi-bus-front me-1"></i> Luxury Coach
            </button>
            <button type="button" 
                    class="pill-tab @(Model.VehicleType == "Express Bus" ? "active" : "")" 
                    onclick="filterByVehicle('Express Bus')">
                <i class="bi bi-lightning-charge-fill text-primary me-1"></i> Express Bus
            </button>
        </div>

        <form id="mainSearchForm" method="get" asp-controller="Transportation" asp-action="Index">
            <input type="hidden" asp-for="Page" value="1" id="mainSearchPage" />
            <input type="hidden" id="filterVehicleTypeHidden" asp-for="VehicleType" />
            <input type="hidden" id="minPriceHidden" asp-for="MinPrice" />
            <input type="hidden" id="maxPriceHidden" asp-for="MaxPrice" />

            <div class="search-grid-layout">
                
                <div class="location-input-wrap">
                    <label>Leaving from</label>
                    <div class="location-field">
                        <i class="bi bi-geo-alt-fill"></i>
                        <input type="text" asp-for="Origin" id="originInput" placeholder="Type city (e.g. Kuala Lumpur)" autocomplete="off" />
                    </div>
                    <div class="autocomplete-list" id="originDropdown">
                        @foreach (var o in Model.Origins)
                        {
                            <div class="autocomplete-item" onclick="selectOrigin('@o')">
                                <i class="bi bi-pin-map text-primary"></i> <span>@o</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="swap-btn-wrap">
                    <button type="button" class="swap-btn" id="swapLocationBtn" title="Swap Origin & Destination">
                        <i class="bi bi-arrow-left-right"></i>
                    </button>
                </div>

                <div class="location-input-wrap">
                    <label>Going to</label>
                    <div class="location-field">
                        <i class="bi bi-compass-fill"></i>
                        <input type="text" asp-for="Destination" id="destinationInput" placeholder="Type destination (e.g. Penang, Genting)" autocomplete="off" />
                    </div>
                    <div class="autocomplete-list" id="destinationDropdown">
                        @foreach (var d in Model.Destinations)
                        {
                            <div class="autocomplete-item" onclick="selectDestination('@d')">
                                <i class="bi bi-geo-alt text-danger"></i> <span>@d</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="location-input-wrap">
                    <label>Departure Date</label>
                    <div class="location-field">
                        <i class="bi bi-calendar3"></i>
                        <input type="date" asp-for="DepartureDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" id="departureDateInput" />
                    </div>
                </div>

            </div>

            <div class="bottom-search-row">
                <div class="secondary-inputs">
                    <div>
                        <select asp-for="SortBy" id="sortBySelect" class="form-select form-select-sm border-secondary-subtle">
                            <option value="departure">Sort: Earliest departure</option>
                            <option value="price-low">Price: Low to High</option>
                            <option value="price-high">Price: High to Low</option>
                            <option value="duration">Fastest duration</option>
                        </select>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" asp-for="OnlyAvailableSeats" class="form-check-input" id="onlySeatsChk" />
                        <label class="form-check-label small fw-bold text-muted" for="onlySeatsChk">
                            Only available seats
                        </label>
                    </div>
                </div>

                <button type="submit" class="search-btn-primary" id="searchSubmitBtn">
                    <i class="bi bi-search"></i> Search live coaches
                </button>
            </div>
        </form>

    </div>
</div>

<section class="results-section mt-5">
    <div class="container-fluid px-5">
        <div class="results-container">

            <aside class="filter-sidebar">
                <div class="filter-header">
                    <h3>Filters</h3>
                    @if (Model.HasFiltersApplied)
                    {
                        <a href="@Url.Action("Index", "Transportation")" class="clear-filters" onclick="triggerAjaxFilter(this.href); return false;">Clear all</a>
                    }
                </div>

                <form id="advancedFilterForm" method="get" asp-controller="Transportation" asp-action="Index">
                    <input type="hidden" asp-for="Origin" id="advOrigin" />
                    <input type="hidden" asp-for="Destination" id="advDestination" />
                    <input type="hidden" asp-for="DepartureDate" id="advDate" />
                    <input type="hidden" asp-for="Page" value="1" />

                    <div class="filter-group">
                        <h4>Price Range (RM)</h4>
                        <div class="price-inputs">
                            <input type="number" asp-for="MinPrice" id="sidebarMinPrice" min="0" placeholder="Min" class="form-control" />
                            <span>-</span>
                            <input type="number" asp-for="MaxPrice" id="sidebarMaxPrice" min="0" placeholder="Max" class="form-control" />
                        </div>
                        <span asp-validation-for="MinPrice" class="text-danger small d-block mt-1"></span>
                        <span asp-validation-for="MaxPrice" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="filter-group">
                        <h4>Vehicle Type</h4>
                        <select asp-for="VehicleType" id="sidebarVehicleType" class="form-select" asp-items="@(new SelectList(Model.VehicleTypes))">
                            <option value="">All types</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <h4>Minimum Rating</h4>
                        <select asp-for="MinimumRating" id="sidebarRating" class="form-select">
                            <option value="">All ratings</option>
                            <option value="1">1+ Stars</option>
                            <option value="2">2+ Stars</option>
                            <option value="3">3+ Stars</option>
                            <option value="4">4+ Stars</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <div class="form-check">
                            <input type="checkbox" asp-for="OnlyAvailableSeats" id="sidebarOnlySeats" class="form-check-input" />
                            <label class="form-check-label" for="sidebarOnlySeats">Only available seats</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-filter">Apply Filters</button>
                </form>
            </aside>

            <main class="results-main" id="resultsMainArea">

                <div class="price-quick-chips">
                    <span class="small fw-bold text-muted me-2"><i class="bi bi-tag-fill text-primary"></i> Quick Fares:</span>
                    <button type="button" class="price-chip @(!Model.MinPrice.HasValue && !Model.MaxPrice.HasValue ? "active" : "")" onclick="setQuickPrice('', '')">
                        All Prices
                    </button>
                    <button type="button" class="price-chip @(Model.MaxPrice == 35 ? "active" : "")" onclick="setQuickPrice('', 35)">
                        Under RM 35 (Budget)
                    </button>
                    <button type="button" class="price-chip @(Model.MinPrice == 35 && Model.MaxPrice == 50 ? "active" : "")" onclick="setQuickPrice(35, 50)">
                        RM 35 - RM 50 (Popular)
                    </button>
                    <button type="button" class="price-chip @(Model.MinPrice == 50 ? "active" : "")" onclick="setQuickPrice(50, '')">
                        Above RM 50 (VIP Luxury)
                    </button>
                </div>

                @if (Model.Trips.Any())
                {
                    <div class="results-header">
                        <h2>Available Coach &amp; Van Schedules</h2>
                        <p class="results-count">Showing @Model.Trips.Count() of @Model.TotalCount results</p>
                    </div>

                    <div class="trips-grid">
                        @foreach (var trip in Model.Trips)
                        {
                            var avgRating = trip.Reviews.Any() ? Math.Round(trip.Reviews.Average(r => r.Rating), 1) : 0;
                            var discountedPrice = trip.BaseFare * (1 - trip.DiscountPercentage / 100);
                            var isVip = trip.Vehicle?.VehicleType == "VIP Van";
                            var isExpress = trip.Vehicle?.VehicleType == "Express Bus";

                            <div class="pro-journey-card">
                                <div>
                                    <div class="card-meta-top">
                                        <span class="vehicle-tag @(isVip ? "vip" : isExpress ? "express" : "coach")">
                                            <i class="bi @(isVip ? "bi-star-fill" : "bi-bus-front") me-1"></i>
                                            @trip.Vehicle?.VehicleType
                                        </span>
                                        <span class="travel-date-tag">
                                            <i class="bi bi-calendar3 me-1"></i>@trip.DepartureTime.ToString("ddd, dd MMM")
                                        </span>
                                    </div>

                                    <div class="route-title-box">
                                        <h3 class="route-title">
                                            <span>@trip.Route?.Origin</span>
                                            <i class="bi bi-arrow-right"></i>
                                            <span class="text-primary">@trip.Route?.Destination</span>
                                        </h3>
                                    </div>

                                    <div class="card-timeline">
                                        <div class="timeline-node">
                                            <span class="node-time">@trip.DepartureTime.ToString("HH:mm")</span>
                                            <span class="node-label">Depart</span>
                                        </div>

                                        <div class="timeline-track-mid">
                                            <span class="duration-text">
                                                @Math.Round((trip.ArrivalTime - trip.DepartureTime).TotalHours, 1)h
                                            </span>
                                            <div class="timeline-bar"></div>
                                            <small class="text-muted d-block" style="font-size: 0.68rem; font-weight: 700;">Direct Service</small>
                                        </div>

                                        <div class="timeline-node end">
                                            <span class="node-time">@trip.ArrivalTime.ToString("HH:mm")</span>
                                            <span class="node-label">Arrive</span>
                                        </div>
                                    </div>

                                    <div class="card-fleet-status">
                                        <div class="fleet-model">
                                            <i class="bi bi-bus-front text-muted me-1"></i>@trip.Vehicle?.VehicleModel
                                        </div>
                                        <div>
                                            @if (trip.AvailableSeats <= 5 && trip.AvailableSeats > 0)
                                            {
                                                <span class="seats-alert-badge urgent">
                                                    <i class="bi bi-fire me-1"></i>Only @trip.AvailableSeats seats left!
                                                </span>
                                            }
                                            else if (trip.AvailableSeats > 0)
                                            {
                                                <span class="seats-alert-badge available">
                                                    <i class="bi bi-chair me-1"></i>@trip.AvailableSeats seats left
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Sold Out</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="card-bottom-checkout">
                                    <div class="price-group">
                                        @if (trip.DiscountPercentage > 0)
                                        {
                                            <span class="price-strike">RM @trip.BaseFare.ToString("F2")</span>
                                        }
                                        <span class="price-now">RM @discountedPrice.ToString("F2")</span>
                                        <span class="price-unit">/ seat</span>
                                    </div>

                                    <a asp-controller="Transportation" asp-action="Details" asp-route-id="@trip.TripId" class="btn-select-journey">
                                        <span>Select Seats</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="pagination-nav mt-4">
                            <ul class="pagination">
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.Page ? "active" : "")">
                                        <a asp-action="Index"
                                           asp-route-origin="@Model.Origin"
                                           asp-route-destination="@Model.Destination"
                                           asp-route-departureDate="@Model.DepartureDate?.ToString("yyyy-MM-dd")"
                                           asp-route-vehicleType="@Model.VehicleType"
                                           asp-route-minPrice="@Model.MinPrice"
                                           asp-route-maxPrice="@Model.MaxPrice"
                                           asp-route-page="@i"
                                           onclick="triggerAjaxFilter(this.href); return false;"
                                           class="page-link">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="no-results text-center py-5">
                        <i class="bi bi-search display-3 text-muted mb-3 d-block"></i>
                        <h3 class="fw-bold" style="color: #06143b;">No coach schedules found</h3>
                        <p class="text-muted">Try adjusting your destination, departure date or price range.</p>
                        <a href="@Url.Action("Index", "Transportation")" onclick="triggerAjaxFilter(this.href); return false;" class="btn btn-primary px-4 py-2 fw-bold">Clear all filters</a>
                    </div>
                }
            </main>
        </div>
    </div>
</section>

<script>
    setupAutocomplete('originInput', 'originDropdown');
    setupAutocomplete('destinationInput', 'destinationDropdown');

    function setupAutocomplete(inputId, dropdownId) {
        const input = document.getElementById(inputId);
        const dropdown = document.getElementById(dropdownId);
        if (!input || !dropdown) return;

        input.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            const items = dropdown.querySelectorAll('.autocomplete-item');
            let hasMatch = false;

            items.forEach(item => {
                const text = item.innerText.toLowerCase();
                if (query === '' || text.includes(query)) {
                    item.style.display = 'flex';
                    hasMatch = true;
                } else {
                    item.style.display = 'none';
                }
            });

            dropdown.style.display = hasMatch ? 'block' : 'none';
        });

        input.addEventListener('focus', function () {
            dropdown.style.display = 'block';
        });

        document.addEventListener('click', function (e) {
            if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });
    }

    function selectOrigin(val) {
        document.getElementById('originInput').value = val;
        document.getElementById('originDropdown').style.display = 'none';
    }

    function selectDestination(val) {
        document.getElementById('destinationInput').value = val;
        document.getElementById('destinationDropdown').style.display = 'none';
    }

    document.getElementById('swapLocationBtn')?.addEventListener('click', function () {
        const originEl = document.getElementById('originInput');
        const destEl = document.getElementById('destinationInput');
        
        const temp = originEl.value;
        originEl.value = destEl.value;
        destEl.value = temp;

        this.style.transform = 'rotate(180deg)';
        setTimeout(() => { this.style.transform = 'none'; }, 300);
    });

    function filterByVehicle(type) {
        document.getElementById('filterVehicleTypeHidden').value = type;
        document.querySelectorAll('.pill-tab').forEach(tab => tab.classList.remove('active'));
        
        const currentForm = document.getElementById('mainSearchForm');
        submitFormViaAjax(currentForm);
    }

    function setQuickPrice(min, max) {
        document.getElementById('minPriceHidden').value = min;
        document.getElementById('maxPriceHidden').value = max;
        
        document.getElementById('sidebarMinPrice').value = min;
        document.getElementById('sidebarMaxPrice').value = max;

        const currentForm = document.getElementById('mainSearchForm');
        submitFormViaAjax(currentForm);
    }

    function submitFormViaAjax(form) {
        const formData = new FormData(form);
        const params = new URLSearchParams(formData);
        const targetUrl = form.action + '?' + params.toString();
        triggerAjaxFilter(targetUrl);
    }

    function triggerAjaxFilter(url) {
        const mainArea = document.getElementById('resultsMainArea');
        if (!mainArea) {
            window.location.href = url;
            return;
        }

        mainArea.classList.add('results-loading-overlay');

        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(res => res.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newContent = doc.getElementById('resultsMainArea');
                
                if (newContent) {
                    mainArea.innerHTML = newContent.innerHTML;
                    window.history.pushState({}, '', url);
                } else {
                    window.location.href = url;
                }
            })
            .catch(err => {
                window.location.href = url;
            })
            .finally(() => {
                mainArea.classList.remove('results-loading-overlay');
            });
    }

    document.getElementById('mainSearchForm')?.addEventListener('submit', function (e) {
        e.preventDefault();
        submitFormViaAjax(this);
    });

    document.getElementById('advancedFilterForm')?.addEventListener('submit', function (e) {
        e.preventDefault();
        submitFormViaAjax(this);
    });
</script>