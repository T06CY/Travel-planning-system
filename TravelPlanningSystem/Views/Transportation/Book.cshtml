@model TravelPlanningSystem.ViewModels.TransportationBookingViewModel

@{
    ViewData["Title"] = "Select Seats & Checkout - TravelMate";
    var trip = Model.Trip!;
}

<link rel="stylesheet" href="~/css/transportation.css" asp-append-version="true" />

<style>
    .booking-wrapper { background: #f3f5fb; padding: 40px 0; min-height: 85vh; }
    .booking-card { background: #fff; border-radius: 16px; padding: 25px; box-shadow: 0 10px 30px rgba(6,20,59,0.06); margin-bottom: 25px; }
    .booking-card h3 { font-size: 1.25rem; font-weight: 700; color: #06143b; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
    
    /* 车舱座位图样式 */
    .bus-cabin { background: #eef2ff; border: 2px solid #cfd5e6; border-radius: 30px; padding: 25px 20px; max-width: 380px; margin: 0 auto; position: relative; }
    .bus-front { text-align: center; border-bottom: 2px dashed #cfd5e6; padding-bottom: 12px; margin-bottom: 20px; color: #6d7895; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; }
    .seat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; justify-items: center; }
    
    .seat-item { width: 52px; height: 52px; border-radius: 10px; border: 2px solid #cfd5e6; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.2s ease; position: relative; user-select: none; }
    .seat-item:hover:not(.booked) { transform: translateY(-2px); border-color: #4158ff; color: #4158ff; }
    .seat-item.booked { background: #e2e5ec; border-color: #d1d5db; color: #9ca3af; cursor: not-allowed; opacity: 0.7; }
    .seat-item.selected { background: #4158ff; border-color: #4158ff; color: #fff; box-shadow: 0 4px 12px rgba(65,88,255,0.4); transform: scale(1.05); }
    
    .seat-legend { display: flex; justify-content: center; gap: 20px; margin-top: 20px; font-size: 0.85rem; color: #06143b; }
    .legend-item { display: flex; align-items: center; gap: 8px; }
    .legend-box { width: 18px; height: 18px; border-radius: 4px; border: 2px solid #cfd5e6; }
    .legend-box.available { background: #fff; }
    .legend-box.booked { background: #e2e5ec; border-color: #d1d5db; }
    .legend-box.selected { background: #4158ff; border-color: #4158ff; }
    
    /* 乘客表单 */
    .passenger-block { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; margin-bottom: 15px; }
    .passenger-block h4 { font-size: 1rem; font-weight: 700; color: #4158ff; margin-bottom: 15px; display: flex; justify-content: space-between; }
    
    /* 侧边汇总栏 */
    .summary-sidebar { position: sticky; top: 20px; background: #fff; border-radius: 16px; padding: 25px; box-shadow: 0 10px 30px rgba(6,20,59,0.08); }
    .summary-row { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 0.95rem; color: #6d7895; }
    .summary-row.total { border-top: 2px dashed #cfd5e6; padding-top: 15px; margin-top: 15px; font-size: 1.25rem; font-weight: 800; color: #06143b; }
    .btn-pay { background: #4158ff; color: #fff; border: none; width: 100%; padding: 14px; border-radius: 12px; font-weight: 700; font-size: 1.05rem; transition: all 0.2s ease; margin-top: 15px; }
    .btn-pay:hover { background: #2746d8; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(65,88,255,0.35); }
</style>

<div class="booking-wrapper">
    <div class="container">
        <!-- 顶部返回 -->
        <div class="mb-4">
            <a asp-action="Details" asp-route-id="@trip.TripId" class="text-decoration-none text-muted">
                <i class="bi bi-arrow-left"></i> Back to Trip Details
            </a>
            <h2 class="fw-bold mt-2" style="color: #06143b;">Select Seats & Book</h2>
            <p class="text-muted">@trip.Route?.Origin <i class="bi bi-arrow-right"></i> @trip.Route?.Destination • @trip.DepartureTime.ToString("ddd, MMM d, yyyy")</p>
        </div>

        <form id="bookingForm" asp-action="Book" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TripId" />
            <input type="hidden" id="baseFareInput" value="@Model.BaseFarePerSeat" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

            <div class="row">
                <!-- 左侧：选座 + 乘客信息 + 支付 -->
                <div class="col-lg-8">
                    
                    <!-- 1. 可视化选座地图 (Interactive Seat Selection) -->
                    <div class="booking-card">
                        <h3><i class="bi bi-grid-3x3-gap-fill text-primary"></i> 1. Select Your Seats</h3>
                        <p class="text-muted small">Click on available seats to select. Click again to unselect.</p>
                        
                        <div class="bus-cabin">
                            <div class="bus-front">
                                <i class="bi bi-compass"></i> Front / Driver Cabin
                            </div>
                            <div class="seat-grid">
                                @foreach (var seat in Model.Seats)
                                {
                                    <div class="seat-item @(seat.IsAvailable ? "" : "booked")" 
                                         data-seat="@seat.SeatNumber" 
                                         data-seat-id="@seat.SeatId"
                                         title="@seat.SeatNumber (@seat.SeatClass - @seat.SeatType)">
                                        <i class="bi bi-chair"></i>
                                        <span>@seat.SeatNumber</span>
                                    </div>
                                }
                            </div>
                            <div class="seat-legend">
                                <div class="legend-item"><div class="legend-box available"></div> Available</div>
                                <div class="legend-item"><div class="legend-box selected"></div> Selected</div>
                                <div class="legend-item"><div class="legend-box booked"></div> Booked</div>
                            </div>
                        </div>

                        <!-- 隐藏存储选中的座位号 -->
                        <div id="hiddenSeatInputs"></div>
                    </div>

                    <!-- 2. 乘客名册明细 (Passenger Roster Details) -->
                    <div class="booking-card">
                        <h3><i class="bi bi-people-fill text-primary"></i> 2. Passenger Details</h3>
                        <div id="noSeatSelectedAlert" class="alert alert-warning">
                            <i class="bi bi-info-circle"></i> Please select at least one seat on the seat map above to enter passenger details.
                        </div>
                        <div id="passengersContainer"></div>
                    </div>

                    <!-- 3. 联络人信息 (Contact Details) -->
                    <div class="booking-card">
                        <h3><i class="bi bi-person-lines-fill text-primary"></i> 3. Contact Information</h3>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="ContactName" class="form-label fw-bold">Full Name</label>
                                <input asp-for="ContactName" class="form-control" placeholder="John Doe" required />
                                <span asp-validation-for="ContactName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ContactEmail" class="form-label fw-bold">Email Address</label>
                                <input asp-for="ContactEmail" type="email" class="form-control" placeholder="john@example.com" required />
                                <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ContactPhone" class="form-label fw-bold">Phone Number</label>
                                <input asp-for="ContactPhone" class="form-control" placeholder="+60 12-345 6789" required />
                                <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 4. 支付方式 (Payment Method) -->
                    <div class="booking-card">
                        <h3><i class="bi bi-credit-card-2-front-fill text-primary"></i> 4. Payment Method</h3>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-check p-3 border rounded">
                                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Online Banking (FPX)" id="payFpx" checked>
                                    <label class="form-check-label fw-bold" for="payFpx">
                                        <i class="bi bi-bank"></i> Online Banking (FPX)
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check p-3 border rounded">
                                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Credit / Debit Card" id="payCard">
                                    <label class="form-check-label fw-bold" for="payCard">
                                        <i class="bi bi-credit-card"></i> Credit / Debit Card
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check p-3 border rounded">
                                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Touch 'n Go eWallet" id="payTng">
                                    <label class="form-check-label fw-bold" for="payTng">
                                        <i class="bi bi-wallet2"></i> Touch 'n Go eWallet
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- 右侧：订单汇总核算与结账 (Checkout Sidebar) -->
                <div class="col-lg-4">
                    <div class="summary-sidebar">
                        <h4 class="fw-bold mb-3" style="color: #06143b;">Booking Summary</h4>
                        
                        <div class="summary-row">
                            <span>Route</span>
                            <span class="fw-bold text-dark">@trip.Route?.Origin → @trip.Route?.Destination</span>
                        </div>
                        <div class="summary-row">
                            <span>Departure</span>
                            <span>@trip.DepartureTime.ToString("HH:mm, dd MMM")</span>
                        </div>
                        <div class="summary-row">
                            <span>Vehicle</span>
                            <span>@trip.Vehicle?.VehicleModel</span>
                        </div>
                        
                        <hr class="my-3" />

                        <div class="summary-row">
                            <span>Selected Seats (<span id="seatCountText">0</span>)</span>
                            <span id="selectedSeatsList" class="fw-bold text-primary">None</span>
                        </div>
                        <div class="summary-row">
                            <span>Seats Subtotal</span>
                            <span id="baseSubtotalText">RM 0.00</span>
                        </div>
                        <div class="summary-row">
                            <span>Baggage Add-ons</span>
                            <span id="baggageTotalText">RM 0.00</span>
                        </div>
                        <div class="summary-row">
                            <span>Travel Insurance</span>
                            <span id="insuranceTotalText">RM 0.00</span>
                        </div>

                        <!-- 优惠码输入 (Promo Code) -->
                        <div class="mt-3 mb-3">
                            <label class="form-label small fw-bold">Have a Promo Code?</label>
                            <div class="input-group">
                                <input type="text" id="promoCodeInput" asp-for="PromoCode" class="form-control text-uppercase" placeholder="e.g. TRAVEL2026" />
                                <button type="button" id="applyPromoBtn" class="btn btn-outline-primary">Apply</button>
                            </div>
                            <span id="promoMessage" class="small d-block mt-1"></span>
                        </div>

                        <div class="summary-row text-success" id="discountRow" style="display: none;">
                            <span>Discount</span>
                            <span id="discountText">- RM 0.00</span>
                        </div>

                        <div class="summary-row total">
                            <span>Total Amount</span>
                            <span class="text-primary" id="grandTotalText">RM 0.00</span>
                        </div>

                        <button type="submit" class="btn-pay" id="submitBookingBtn" disabled>
                            Confirm & Pay Now
                        </button>
                        <p class="text-center text-muted small mt-2">
                            <i class="bi bi-shield-check text-success"></i> Safe & Secure 256-Bit SSL Checkout
                        </p>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- 交互脚本：座位选择、动态乘客表单与实时算价 -->
<script>
    let selectedSeats = [];
    const baseFare = parseFloat(document.getElementById('baseFareInput').value);
    let discount = 0;

    // 选座点击事件
    document.querySelectorAll('.seat-item:not(.booked)').forEach(seatEl => {
        seatEl.addEventListener('click', function () {
            const seatNum = this.getAttribute('data-seat');
            if (this.classList.contains('selected')) {
                this.classList.remove('selected');
                selectedSeats = selectedSeats.filter(s => s !== seatNum);
            } else {
                this.classList.add('selected');
                selectedSeats.push(seatNum);
            }
            updateBookingUI();
        });
    });

    function updateBookingUI() {
        // 1. 更新隐藏 Input 供 Form POST
        const hiddenContainer = document.getElementById('hiddenSeatInputs');
        hiddenContainer.innerHTML = '';
        selectedSeats.forEach(seat => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'SelectedSeatNumbers';
            input.value = seat;
            hiddenContainer.appendChild(input);
        });

        // 2. 动态渲染每位乘客名册表单
        const passengersContainer = document.getElementById('passengersContainer');
        const alertBox = document.getElementById('noSeatSelectedAlert');

        if (selectedSeats.length === 0) {
            alertBox.style.display = 'block';
            passengersContainer.innerHTML = '';
            document.getElementById('submitBookingBtn').disabled = true;
        } else {
            alertBox.style.display = 'none';
            document.getElementById('submitBookingBtn').disabled = false;

            let html = '';
            selectedSeats.forEach((seat, idx) => {
                html += `
                    <div class="passenger-block">
                        <h4>
                            <span><i class="bi bi-person"></i> Passenger ${idx + 1}</span>
                            <span class="badge bg-primary">Seat ${seat}</span>
                        </h4>
                        <input type="hidden" name="Passengers[${idx}].SeatNumber" value="${seat}" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Full Name (as in IC/Passport)</label>
                                <input type="text" name="Passengers[${idx}].FullName" class="form-control form-control-sm" placeholder="e.g. Tan Ah Kow" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">IC / Passport Number</label>
                                <input type="text" name="Passengers[${idx}].IdNumber" class="form-control form-control-sm" placeholder="e.g. 980101-14-5566" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold">Type</label>
                                <select name="Passengers[${idx}].PassengerType" class="form-select form-select-sm">
                                    <option value="Adult">Adult</option>
                                    <option value="Child">Child</option>
                                    <option value="Senior">Senior</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Baggage Allowance</label>
                                <select name="Passengers[${idx}].BaggagePrice" class="form-select form-select-sm baggage-select" onchange="calculateGrandTotal()">
                                    <option value="0" data-name="Standard (20kg)">Standard 20kg (Included)</option>
                                    <option value="15" data-name="Extra +10kg">Extra +10kg (+RM 15.00)</option>
                                    <option value="25" data-name="Extra +20kg">Extra +20kg (+RM 25.00)</option>
                                </select>
                            </div>
                            <div class="col-md-6 d-flex align-items-center mt-4">
                                <div class="form-check">
                                    <input class="form-check-input insurance-check" type="checkbox" name="Passengers[${idx}].HasInsurance" value="true" onchange="calculateGrandTotal()" id="ins_${idx}">
                                    <label class="form-check-label small" for="ins_${idx}">
                                        Travel Protection Insurance (+RM 5.00)
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            passengersContainer.innerHTML = html;
        }

        // 3. 计算并刷新金额
        calculateGrandTotal();
    }

    function calculateGrandTotal() {
        const count = selectedSeats.length;
        document.getElementById('seatCountText').innerText = count;
        document.getElementById('selectedSeatsList').innerText = count > 0 ? selectedSeats.join(', ') : 'None';

        const baseTotal = count * baseFare;
        document.getElementById('baseSubtotalText').innerText = 'RM ' + baseTotal.toFixed(2);

        // 计算行李加购费
        let baggageTotal = 0;
        document.querySelectorAll('.baggage-select').forEach(sel => {
            baggageTotal += parseFloat(sel.value || 0);
        });
        document.getElementById('baggageTotalText').innerText = 'RM ' + baggageTotal.toFixed(2);

        // 计算保险费
        let insuranceTotal = 0;
        document.querySelectorAll('.insurance-check').forEach(chk => {
            if (chk.checked) insuranceTotal += 5.00;
        });
        document.getElementById('insuranceTotalText').innerText = 'RM ' + insuranceTotal.toFixed(2);

        // 优惠码处理
        const promoCode = document.getElementById('promoCodeInput').value.trim().toUpperCase();
        if (promoCode === 'TRAVEL2026' && count > 0) {
            discount = baseTotal * 0.15;
            document.getElementById('discountRow').style.display = 'flex';
            document.getElementById('discountText').innerText = '- RM ' + discount.toFixed(2);
        } else if (promoCode === 'PROMO10' && count > 0) {
            discount = Math.min(baseTotal, 10.00);
            document.getElementById('discountRow').style.display = 'flex';
            document.getElementById('discountText').innerText = '- RM ' + discount.toFixed(2);
        } else {
            discount = 0;
            document.getElementById('discountRow').style.display = 'none';
        }

        const grandTotal = Math.max(0, baseTotal + baggageTotal + insuranceTotal - discount);
        document.getElementById('grandTotalText').innerText = 'RM ' + grandTotal.toFixed(2);
    }

    // 优惠码点击激活
    document.getElementById('applyPromoBtn')?.addEventListener('click', function () {
        const promoCode = document.getElementById('promoCodeInput').value.trim().toUpperCase();
        const msg = document.getElementById('promoMessage');
        if (promoCode === 'TRAVEL2026') {
            msg.className = 'small d-block mt-1 text-success';
            msg.innerText = 'Promo code applied: 15% OFF base fare!';
        } else if (promoCode === 'PROMO10') {
            msg.className = 'small d-block mt-1 text-success';
            msg.innerText = 'Promo code applied: RM 10.00 OFF!';
        } else {
            msg.className = 'small d-block mt-1 text-danger';
            msg.innerText = 'Invalid or expired promo code.';
        }
        calculateGrandTotal();
    });
</script>