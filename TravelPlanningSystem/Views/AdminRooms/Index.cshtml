@model IEnumerable<TravelPlanningSystem.Models.HotelRoom>
@{ ViewData["Title"] = "Room management"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Room management</h1><p class="text-muted mb-0">Maintain hotel room listings and photos.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus"></i> Add room</a></div><form class="row g-2 mb-3"><div class="col-sm-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search hotel, room or destination" /></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div></form>@if(TempData["Message"] is string message){<div class="alert alert-info">@message</div>}<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Hotel / room</th><th>Destination</th><th>Price</th><th>Inventory</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var room in Model){<tr><td><strong>@room.HotelName</strong><br/><small>@room.RoomName</small></td><td>@room.Destination</td><td>RM @room.PricePerNight.ToString("N2")</td><td>@room.TotalRooms room(s)</td><td>@(room.IsActive ? "Active" : "Inactive")</td><td><a asp-action="Details" asp-route-id="@room.HotelRoomId" class="btn btn-sm btn-outline-primary">Manage</a></td></tr>}</tbody></table></div>
