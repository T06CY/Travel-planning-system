@model IEnumerable<TravelPlanningSystem.Models.HotelRoom>

@{
    ViewData["Title"] = "Room Management";
}

<link rel="stylesheet" href="~/css/flight.css" asp-append-version="true" />

<div class="flight-admin-page">
    <div class="admin-page-header">
        <div>
            <span class="flight-eyebrow">HOTEL OPERATIONS</span>
            <h1>Room Management</h1>
            <p>Maintain room listings, inventory, pricing, photos and availability.</p>
        </div>
        <a asp-action="Create" class="primary-flight-btn"><i class="bi bi-plus-lg"></i> Add room</a>
    </div>

    @if (TempData["Message"] is not null)
    {
        <div class="flight-alert success">@TempData["Message"]</div>
    }

    <div class="admin-flight-card">
        <form method="get" class="admin-filter-bar">
            <div class="flight-field">
                <label>Search</label>
                <input name="search" value="@ViewBag.Search" placeholder="Hotel, room or destination" />
            </div>
            <div class="flight-field">
                <label>Status</label>
                <select name="active">
                    <option value="">All statuses</option>
                    @if (ViewBag.Active is bool active && active)
                    {
                        <option value="true" selected>Active</option>
                    }
                    else
                    {
                        <option value="true">Active</option>
                    }
                    @if (ViewBag.Active is bool inactive && !inactive)
                    {
                        <option value="false" selected>Inactive</option>
                    }
                    else
                    {
                        <option value="false">Inactive</option>
                    }
                </select>
            </div>
            <button class="primary-flight-btn" type="submit"><i class="bi bi-search"></i> Filter</button>
            <a asp-action="Index" class="secondary-flight-btn">Clear</a>
        </form>

        <div class="admin-table-wrap">
            <table class="admin-flight-table">
                <thead>
                    <tr>
                        <th>Hotel / Room</th>
                        <th>Destination</th>
                        <th>Room type</th>
                        <th>Price</th>
                        <th>Inventory</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-flights">
                                    <i class="bi bi-building-x"></i>
                                    <div><strong>No rooms found</strong><p>Add a room or change the filters.</p></div>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var room in Model)
                    {
                        <tr>
                            <td>
                                <div class="admin-airline-cell">
                                    @{ var photo = room.Photos.OrderByDescending(p => p.IsPrimary).ThenBy(p => p.DisplayOrder).FirstOrDefault(); }
                                    @if (photo is not null)
                                    {
                                        <img src="@photo.PhotoUrl" alt="" />
                                    }
                                    else
                                    {
                                        <span class="airline-fallback"><i class="bi bi-building"></i></span>
                                    }
                                    <div><strong>@room.HotelName</strong><small>@room.RoomName</small></div>
                                </div>
                            </td>
                            <td><strong>@room.Destination</strong><small class="table-subtext">@room.Address</small></td>
                            <td>@room.RoomType</td>
                            <td>RM @room.PricePerNight.ToString("N2")<small class="table-subtext">per night</small></td>
                            <td><strong>@room.TotalRooms</strong><small class="table-subtext">room(s), up to @room.Capacity guests</small></td>
                            <td>
                                <form asp-action="ToggleActive" method="post" class="status-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@room.HotelRoomId" />
                                    <button type="submit" class="status-text-button">
                                        @if (room.IsActive)
                                        {
                                            <span class="hotel-status active"><i class="bi bi-check-circle-fill"></i> Active</span>
                                        }
                                        else
                                        {
                                            <span class="hotel-status inactive"><i class="bi bi-dash-circle-fill"></i> Inactive</span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a asp-action="Edit" asp-route-id="@room.HotelRoomId" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@room.HotelRoomId" class="danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .status-text-button { padding: 0; border: 0; background: transparent; }
    .status-text-button:hover { cursor: pointer; opacity: .8; }
    .hotel-status { display: inline-flex; align-items: center; gap: 5px; padding: 5px 9px; border-radius: 999px; font-size: .75rem; font-weight: 700; }
    .hotel-status.active { color: #147a43; background: #e3f7eb; }
    .hotel-status.inactive { color: #b42332; background: #fde7e9; }
</style>