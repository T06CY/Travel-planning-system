@model TravelPlanningSystem.Models.HotelRoom
<h1>Delete hotel room</h1><div class="alert alert-warning">@if(Model.Reservations.Any()){<span>This room has reservation history and will be deactivated instead of deleted.</span>}else{<span>This will permanently delete the room and its photo records.</span>}</div><h3>@Model.HotelName — @Model.RoomName</h3><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.HotelRoomId" /><button class="btn btn-danger">Confirm</button> <a asp-action="Details" asp-route-id="@Model.HotelRoomId" class="btn btn-outline-secondary">Cancel</a></form>
