@model TravelPlanningSystem.Models.HotelRoom

@{
    ViewData["Title"] = "Remove Room";
}

<link rel="stylesheet" href="~/css/flight.css" asp-append-version="true" />

<div class="flight-admin-page">
    <div class="delete-confirm-card">
        <div class="delete-icon"><i class="bi bi-exclamation-triangle"></i></div>
        <span class="flight-eyebrow">CONFIRM ACTION</span>
        <h1>Remove @Model.HotelName?</h1>
        <p>@Model.RoomName · @Model.Destination<br />RM @Model.PricePerNight.ToString("N2") per night</p>

        @if (Model.Reservations.Any())
        {
            <div class="flight-alert error">This room has reservation history and will be deactivated and hidden instead of permanently deleted.</div>
        }
        else
        {
            <div class="flight-alert error">This will permanently delete the room and its photo records.</div>
        }

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.HotelRoomId" />
            <a asp-action="Details" asp-route-id="@Model.HotelRoomId" class="secondary-flight-btn">Keep room</a>
            <button type="submit" class="danger-flight-btn">Remove room</button>
        </form>
    </div>
</div>
