@model TravelPlanningSystem.Models.HotelRoom
@{ ViewData["Title"] = "Room photos"; }<h1>Photos — @Model.RoomName</h1><form asp-action="UploadPhotos" method="post" enctype="multipart/form-data" class="card p-3 my-3"><input type="hidden" name="hotelRoomId" value="@Model.HotelRoomId" /><input type="file" name="photos" class="form-control hotel-photo-upload" accept="image/jpeg,image/png,image/webp" multiple required /><button class="btn btn-primary mt-3 align-self-start">Upload photos</button></form><div class="row g-3">@foreach(var photo in Model.Photos){<div class="col-md-4"><div class="card"><img src="@photo.PhotoUrl" class="hotel-thumb" alt="@photo.Caption" /><div class="card-body">@if(photo.IsPrimary){<span class="badge text-bg-success">Primary</span>}<div class="mt-2"><form asp-action="SetPrimaryPhoto" method="post" class="d-inline"><input name="id" value="@photo.HotelRoomPhotoId" type="hidden" /><button class="btn btn-sm btn-outline-primary">Set primary</button></form><form asp-action="DeletePhoto" method="post" class="d-inline"><input name="id" value="@photo.HotelRoomPhotoId" type="hidden" /><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div></div>}</div><a asp-action="Details" asp-route-id="@Model.HotelRoomId" class="btn btn-outline-secondary mt-4">Back</a>
@section Scripts { <script src="~/js/hotel-photo-processing.js" asp-append-version="true"></script> }
