@model TravelPlanningSystem.ViewModels.HotelRoomFormViewModel

<div asp-validation-summary="ModelOnly" class="flight-validation"></div>

<div class="admin-form-grid">
    <div class="flight-field">
        <label asp-for="HotelName"></label>
        <input asp-for="HotelName" placeholder="Example: TravelMate Grand Hotel" />
        <span asp-validation-for="HotelName"></span>
    </div>
    <div class="flight-field">
        <label asp-for="RoomName"></label>
        <input asp-for="RoomName" placeholder="Example: Deluxe King Room" />
        <span asp-validation-for="RoomName"></span>
    </div>
    <div class="flight-field">
        <label asp-for="RoomType"></label>
        <input asp-for="RoomType" placeholder="Example: Master Room" />
        <span asp-validation-for="RoomType"></span>
    </div>
    <div class="flight-field">
        <label asp-for="Destination"></label>
        <input asp-for="Destination" placeholder="City or destination" />
        <span asp-validation-for="Destination"></span>
    </div>
    <div class="flight-field wide-field">
        <label asp-for="Address"></label>
        <input asp-for="Address" />
        <span asp-validation-for="Address"></span>
    </div>
    <div class="flight-field wide-field">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="5"></textarea>
        <span asp-validation-for="Description"></span>
    </div>
    <div class="flight-field">
        <label asp-for="PricePerNight"></label>
        <input asp-for="PricePerNight" type="number" step="0.01" />
        <span asp-validation-for="PricePerNight"></span>
    </div>
    <div class="flight-field">
        <label asp-for="Capacity"></label>
        <input asp-for="Capacity" type="number" min="1" />
        <span asp-validation-for="Capacity"></span>
    </div>
    <div class="flight-field">
        <label asp-for="TotalRooms"></label>
        <input asp-for="TotalRooms" type="number" min="1" />
        <span asp-validation-for="TotalRooms"></span>
    </div>
    <div class="flight-field">
        <label asp-for="StarRating"></label>
        <input asp-for="StarRating" type="number" min="1" max="5" />
        <span asp-validation-for="StarRating"></span>
    </div>
    <div class="flight-field wide-field">
        <label asp-for="Amenities"></label>
        <input asp-for="Amenities" placeholder="Wi-Fi, breakfast, parking" />
        <span asp-validation-for="Amenities"></span>
    </div>
    <div class="flight-field wide-field">
        <label asp-for="Photos"></label>
        <input asp-for="Photos" type="file" accept="image/jpeg,image/png,image/webp" multiple class="hotel-photo-upload" />
        <small>Multiple JPG, PNG or WEBP photos, up to 5 MB each. Images are resized and centre-cropped before upload.</small>
    </div>
    <label class="checkbox-field">
        <input asp-for="IsFeatured" />
        Featured in hotel search
    </label>
    <label class="checkbox-field">
        <input asp-for="IsActive" />
        Active and visible in hotel search
    </label>
</div>
