@model TravelPlanningSystem.Models.HotelRoom
@{ ViewData["Title"] = "Manage room"; }<div class="d-flex justify-content-between"><div><h1>@Model.HotelName</h1><p>@Model.RoomName · @Model.Destination</p></div><div><a asp-action="Edit" asp-route-id="@Model.HotelRoomId" class="btn btn-primary">Edit</a><a asp-action="Photos" asp-route-id="@Model.HotelRoomId" class="btn btn-outline-primary">Photos (@Model.Photos.Count)</a></div></div><div class="card p-4"><p>@Model.Description</p><p><strong>RM @Model.PricePerNight.ToString("N2")</strong> per night · Capacity @Model.Capacity · @Model.TotalRooms room(s)</p><p>@Model.Reservations.Count reservation(s), @Model.Reviews.Count review(s)</p><a asp-action="Delete" asp-route-id="@Model.HotelRoomId" class="btn btn-outline-danger align-self-start">Delete / deactivate</a></div>
