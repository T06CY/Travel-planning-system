<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const statusSelect =
                document.getElementById(
                    "bookingStatus");

            const cancelContainer =
                document.getElementById(
                    "cancelReasonContainer");

            const cancellationReason =
                document.getElementById(
                    "cancellationReason");


            function updateCancellationField() {

                if (
                    !statusSelect ||
                    !cancelContainer
                ) {
                    return;
                }

                const isCancelled =
                    statusSelect.value ===
                    "Cancelled";

                cancelContainer.style.display =
                    isCancelled
                        ? "block"
                        : "none";

                if (cancellationReason) {

                    cancellationReason.required =
                        isCancelled;

                }

            }


            statusSelect?.addEventListener(
                "change",
                updateCancellationField);


            updateCancellationField();

        });

</script>