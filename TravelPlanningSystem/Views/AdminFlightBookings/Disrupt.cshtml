@model TravelPlanningSystem.Models.Flight
@using TravelPlanningSystem.Models
@{ ViewData["Title"] = "Manage Flight Disruption"; }
<link rel="stylesheet" href="~/css/flight.css" asp-append-version="true" />
<div class="flight-admin-page"><div class="admin-page-header"><div><span class="flight-eyebrow">WEATHER & DISRUPTION</span><h1>Manage @Model.FlightNumber</h1><p>@Model.From → @Model.To · @Model.DepartureTime.ToString("dd MMM yyyy HH:mm") · @Model.AircraftModel</p></div><a asp-action="Weather" class="secondary-flight-btn">← Weather list</a></div>
<div class="disruption-layout"><div class="admin-flight-card disruption-card"><div class="disruption-title-row"><div><span class="flight-eyebrow">PASSENGER UPDATE</span><h2>Manage flight status</h2></div><span class="status-help"><i class="bi bi-broadcast-pin"></i> One update for every booking</span></div><p class="disruption-lead">Select the latest operational status, add an estimated schedule when needed, and send one clear update to all affected passengers.</p><form asp-action="Disrupt" method="post" class="disruption-form"><input type="hidden" name="flightId" value="@Model.FlightId" />@Html.AntiForgeryToken()<div class="flight-field"><label for="disruptionStatus">Flight status</label><select id="disruptionStatus" name="status">@foreach(var status in new[]{FlightStatus.Scheduled,FlightStatus.Boarding,FlightStatus.Delayed,FlightStatus.Rescheduled,FlightStatus.Diverted,FlightStatus.Cancelled,FlightStatus.Completed}){if(Model.Status == status){<option value="@status" selected>@status</option>}else{<option value="@status">@status</option>}}</select><small class="field-hint">This status appears in the admin list and passenger booking.</small></div><div id="scheduleFields" class="schedule-fields"><div class="schedule-fields-heading"><strong><i class="bi bi-clock-history"></i> Updated schedule</strong><span>Use for delay, reschedule or diversion</span></div><div class="schedule-grid"><div class="flight-field"><label for="estimatedDepartureTime">Estimated departure</label><input id="estimatedDepartureTime" name="estimatedDepartureTime" type="datetime-local" value="@(Model.EstimatedDepartureTime?.ToString("yyyy-MM-ddTHH:mm"))" /></div><div class="flight-field"><label for="estimatedArrivalTime">Estimated arrival</label><input id="estimatedArrivalTime" name="estimatedArrivalTime" type="datetime-local" value="@(Model.EstimatedArrivalTime?.ToString("yyyy-MM-ddTHH:mm"))" /></div></div></div><div class="flight-field"><label for="passengerMessage">Passenger message <span class="required-label">Required</span></label><textarea id="passengerMessage" name="message" rows="5" maxlength="500" placeholder="Example: Heavy rain has delayed this flight. New departure: 14:30. Please check in as normal."></textarea><small class="field-hint">A single message is saved to every affected booking.</small></div><div class="disruption-actions"><button class="primary-flight-btn" type="submit"><i class="bi bi-send"></i> Save status and notify passengers</button><span><i class="bi bi-shield-check"></i> Cancellation automatically creates a full refund record.</span></div></form></div><aside id="weatherAnimation" class="weather-animation-panel weather-mode-scheduled"><div class="weather-sky"><span class="weather-sun"></span><span class="weather-cloud cloud-one"></span><span class="weather-cloud cloud-two"></span><span class="weather-rain"></span></div><div class="weather-animation-copy"><span class="flight-eyebrow">LIVE CONDITIONS</span><strong id="weatherAnimationTitle">Operational conditions</strong><small id="weatherAnimationText">Flight currently scheduled. Continue monitoring live weather.</small></div></aside></div>
<script>const statusPicker=document.getElementById('disruptionStatus'),scheduleFields=document.getElementById('scheduleFields'),weatherPanel=document.getElementById('weatherAnimation'),weatherTitle=document.getElementById('weatherAnimationTitle'),weatherText=document.getElementById('weatherAnimationText');function updateDisruptionUi(){const s=statusPicker.value.toLowerCase();const needsSchedule=['delayed','rescheduled','diverted'].includes(s);scheduleFields.hidden=!needsSchedule;weatherPanel.className='weather-animation-panel weather-mode-'+s;weatherTitle.textContent=s==='delayed'?'Delay detected':s==='rescheduled'?'New schedule required':s==='diverted'?'Route diversion alert':s==='cancelled'?'Severe disruption alert':s==='completed'?'Flight completed':'Operational conditions';weatherText.textContent=s==='delayed'?'Add the best estimated departure and arrival times.':s==='rescheduled'?'Tell passengers the new planned schedule.':s==='diverted'?'Explain the changed route and timing to passengers.':s==='cancelled'?'Do not operate this flight. Affected passengers will be refunded.':s==='completed'?'This flight is complete.':'Flight currently scheduled. Continue monitoring live weather.'}statusPicker.addEventListener('change',updateDisruptionUi);updateDisruptionUi();document.querySelector('.disruption-form')?.addEventListener('submit',e=>{const b=e.currentTarget.querySelector('button[type=submit]');if(b){b.disabled=true;b.innerHTML='<i class="bi bi-hourglass-split"></i> Updating all passengers…';}});</script>
