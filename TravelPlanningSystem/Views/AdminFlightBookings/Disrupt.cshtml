@model TravelPlanningSystem.Models.Flight
@using TravelPlanningSystem.Models
@{ ViewData["Title"] = "Manage Flight Disruption"; }
<link rel="stylesheet" href="~/css/flight.css" asp-append-version="true" />
<div class="flight-admin-page"><div class="admin-page-header"><div><span class="flight-eyebrow">WEATHER & DISRUPTION</span><h1>Manage @Model.FlightNumber</h1><p>@Model.From → @Model.To · @Model.DepartureTime.ToString("dd MMM yyyy HH:mm") · @Model.AircraftModel</p></div><a asp-action="Weather" class="secondary-flight-btn">← Weather list</a></div>
<div class="disruption-layout"><div class="admin-flight-card disruption-card"><h2>Notify affected passengers</h2><p>Choose the operational status and write the message shown with their booking. Cancelling automatically marks every affected booking as fully refunded.</p><form asp-action="Disrupt" method="post" class="disruption-form"><input type="hidden" name="flightId" value="@Model.FlightId" />@Html.AntiForgeryToken()<div class="flight-field"><label>New flight status</label><select id="disruptionStatus" name="status">@foreach(var status in new[]{FlightStatus.Scheduled,FlightStatus.Boarding,FlightStatus.Delayed,FlightStatus.Cancelled}){if(Model.Status == status){<option value="@status" selected>@status</option>}else{<option value="@status">@status</option>}}</select></div><div class="flight-field"><label>Passenger message</label><textarea name="message" rows="5" maxlength="500" placeholder="Example: Heavy rain may delay departure. Please arrive at the airport as scheduled and check your email for updates."></textarea></div><button class="primary-flight-btn" type="submit"><i class="bi bi-send"></i> Save status and notify passengers</button></form></div><aside id="weatherAnimation" class="weather-animation-panel weather-mode-scheduled"><div class="weather-sky"><span class="weather-sun"></span><span class="weather-cloud cloud-one"></span><span class="weather-cloud cloud-two"></span><span class="weather-rain"></span></div><div class="weather-animation-copy"><span class="flight-eyebrow">LIVE CONDITIONS</span><strong id="weatherAnimationTitle">Operational conditions</strong><small id="weatherAnimationText">Flight currently scheduled. Continue monitoring live weather.</small></div></aside></div>
<script>const statusPicker=document.getElementById('disruptionStatus'),weatherPanel=document.getElementById('weatherAnimation'),weatherTitle=document.getElementById('weatherAnimationTitle'),weatherText=document.getElementById('weatherAnimationText');function updateWeatherAnimation(){const s=statusPicker.value.toLowerCase();weatherPanel.className='weather-animation-panel weather-mode-'+s;weatherTitle.textContent=s==='delayed'?'Weather risk detected':s==='cancelled'?'Severe disruption alert':'Operational conditions';weatherText.textContent=s==='delayed'?'Rain or operational conditions may affect departure.':s==='cancelled'?'Do not operate this flight. Affected passengers will be refunded.':'Flight currently scheduled. Continue monitoring live weather.'}statusPicker.addEventListener('change',updateWeatherAnimation);updateWeatherAnimation();document.querySelector('.disruption-form')?.addEventListener('submit',e=>{const b=e.currentTarget.querySelector('button[type=submit]');if(b){b.disabled=true;b.innerHTML='<i class="bi bi-hourglass-split"></i> Updating all passengers…';}});</script>
<script>document.querySelector('.disruption-form')?.addEventListener('submit',e=>{const b=e.currentTarget.querySelector('button[type=submit]');if(b){b.disabled=true;b.innerHTML='<i class="bi bi-hourglass-split"></i> Updating all passengers…';}});</script>
