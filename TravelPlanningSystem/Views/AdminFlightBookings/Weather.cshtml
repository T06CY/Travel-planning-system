@model IEnumerable<TravelPlanningSystem.Models.Flight>
@{ ViewData["Title"] = "Weather & Disruptions"; }
<link rel="stylesheet" href="~/css/flight.css" asp-append-version="true" />
@{ var disruptionMessages = (ViewBag.DisruptionMessages as IDictionary<int, string?>) ?? new Dictionary<int, string?>(); }
<div class="flight-admin-page"><div class="admin-page-header"><div><span class="flight-eyebrow">FLIGHT MANAGEMENT</span><h1>Weather & Disruptions</h1><p>Monitor upcoming flights and notify all affected passengers from one place.</p></div></div>
@if (TempData["Message"] is not null) { <div class="flight-alert success"><i class="bi bi-check-circle"></i> @TempData["Message"]</div> }
@if (TempData["Error"] is not null) { <div class="flight-alert error"><i class="bi bi-exclamation-circle"></i> @TempData["Error"]</div> }
<div class="admin-flight-card"><div class="weather-page-intro"><i class="bi bi-cloud-sun-fill"></i><div><strong>Live operational weather</strong><span>Search a flight, route, or departure city. Select Manage disruption to update one flight and all its bookings together.</span></div></div><form class="weather-search-bar" role="search"><i class="bi bi-search"></i><input id="weatherSearch" type="search" placeholder="Search flight, airline, route or city…" aria-label="Search weather flights" /><span id="weatherResultCount"></span></form><div class="admin-table-wrap"><table class="admin-flight-table"><thead><tr><th>Flight</th><th>Departure</th><th>Aircraft</th><th>Status</th><th>Weather</th><th>Passenger update</th><th>Action</th></tr></thead><tbody>
@foreach(var flight in Model){var hasMessage = disruptionMessages.TryGetValue(flight.FlightId, out var message);var displayedDeparture = flight.EstimatedDepartureTime ?? flight.DepartureTime;var hasEstimate = flight.EstimatedDepartureTime.HasValue;<tr data-weather-search="@flight.FlightNumber @flight.Airline?.AirlineName @flight.From @flight.To @flight.AircraftModel"><td><strong>@flight.FlightNumber</strong><small class="table-subtext">@flight.Airline?.AirlineName</small></td><td><strong>@flight.From → @flight.To</strong><small class="table-subtext">@(hasEstimate ? "Est. " : "")@displayedDeparture.ToString("dd MMM yyyy · HH:mm")</small>@if(hasEstimate){<span class="schedule-change-badge"><i class="bi bi-clock-history"></i> Updated time</span>}</td><td>@flight.AircraftModel</td><td><span class="booking-status status-@flight.Status.ToString().ToLowerInvariant()">@flight.Status</span></td><td><div class="booking-weather" data-weather-city="@flight.From"><span class="weather-loading"><i class="bi bi-cloud-sun"></i> Checking…</span></div></td><td>@if(hasMessage){<small class="disruption-message-preview"><i class="bi bi-megaphone"></i> @message</small>}else{<small class="table-subtext">No update sent</small>}</td><td><a asp-action="Disrupt" asp-route-flightId="@flight.FlightId" class="primary-flight-btn small-btn"><i class="bi bi-sliders"></i> Manage disruption</a></td></tr>}
</tbody></table></div></div></div>
@{ var weatherPage = (int?)ViewBag.Page ?? 1; var weatherPages = (int?)ViewBag.TotalPages ?? 1; var weatherTotal = (int?)ViewBag.TotalRecords ?? 0; var weatherFirst = weatherTotal == 0 ? 0 : ((weatherPage - 1) * 30) + 1; var weatherLast = Math.Min(weatherPage * 30, weatherTotal); }
<div class="admin-pagination-bar weather-pagination"><span>Showing @weatherFirst–@weatherLast of @weatherTotal flights</span>@if(weatherPages > 1){<nav class="admin-pagination" aria-label="Weather flight pages"><a class="@(weatherPage == 1 ? "disabled" : "")" asp-action="Weather" asp-route-page="@(weatherPage - 1)">Previous</a>@for(var p = 1; p <= weatherPages; p++){if(p <= 2 || p > weatherPages - 2 || Math.Abs(p - weatherPage) <= 1){<a class="@(p == weatherPage ? "active" : "")" asp-action="Weather" asp-route-page="@p">@p</a> } else if(p == 3 || p == weatherPages - 2){<span class="pagination-ellipsis">…</span>}}<a class="@(weatherPage == weatherPages ? "disabled" : "")" asp-action="Weather" asp-route-page="@(weatherPage + 1)">Next</a></nav>}</div>
<form class="weather-sort-form weather-sort-bottom" method="get"><label for="weatherSort">Sort by</label><select id="weatherSort" name="sort" onchange="this.form.submit()"><option value="departure" selected="@(ViewBag.Sort == "departure")">Earliest departure</option><option value="latest" selected="@(ViewBag.Sort == "latest")">Latest departure</option><option value="status" selected="@(ViewBag.Sort == "status")">Flight status</option></select><label for="weatherStatus">Status</label><select id="weatherStatus" name="status" onchange="this.form.submit()"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<FlightStatus>()){<option value="@status" selected="@(ViewBag.Status?.ToString() == status.ToString())">@status</option>}</select></form>
<script src="~/js/admin-weather.js" asp-append-version="true"></script>
<script>const sortControl=document.querySelector('.weather-sort-bottom'),searchControl=document.querySelector('.weather-search-bar');if(sortControl&&searchControl){searchControl.parentNode.insertBefore(sortControl,searchControl.nextSibling);sortControl.classList.add('weather-sort-outside');}</script>
<script>const weatherSearch=document.getElementById('weatherSearch'),weatherRows=[...document.querySelectorAll('[data-weather-search]')],weatherCount=document.getElementById('weatherResultCount');function filterWeather(){const q=weatherSearch.value.trim().toLowerCase();let n=0;weatherRows.forEach(r=>{const show=!q||r.dataset.weatherSearch.toLowerCase().includes(q);r.hidden=!show;if(show)n++});weatherCount.textContent=`${n} flight${n===1?'':'s'} shown`}weatherSearch.addEventListener('input',filterWeather);filterWeather();</script>
