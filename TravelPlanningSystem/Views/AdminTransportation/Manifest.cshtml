@model IEnumerable<TravelPlanningSystem.Models.Transportation.TransportationBooking>

@{
    var trip = (TravelPlanningSystem.Models.Transportation.Trip)ViewBag.Trip;
    ViewData["Title"] = $"Passenger Manifest - Trip #{trip.TripId}";
    var allPassengers = Model.SelectMany(b => b.Passengers).ToList();
    int totalBooked = allPassengers.Count;
    int boardedCount = allPassengers.Count(p => p.IsBoarded);
}

<style>
    .manifest-page { background: #f3f5fb; padding: 35px 0; min-height: 85vh; }
    .manifest-card { background: #fff; border-radius: 16px; padding: 30px; box-shadow: 0 8px 25px rgba(6,20,59,0.06); border: 1px solid #e2e8f0; }

    /* Print styling rules */
    @@media print {
        @@page {
            size: landscape;
            margin: 0.8cm 1cm;
        }
        
        nav, header, footer, .navbar, .sidebar, .no-print, .btn, .dashboard-heading {
            display: none !important;
        }

        body, .manifest-page {
            background: #fff !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
        }

        .container, .container-fluid, .manifest-card {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
            box-shadow: none !important;
            border: none !important;
        }

        .table-responsive {
            overflow: visible !important;
            display: block !important;
            width: 100% !important;
        }

        table {
            width: 100% !important;
            border-collapse: collapse !important;
            table-layout: auto !important;
        }

        table th, table td {
            border: 1px solid #334155 !important;
            padding: 8px 10px !important;
            font-size: 9.5pt !important;
            color: #000 !important;
            vertical-align: middle !important;
        }

        .table-dark th {
            background: #0f172a !important;
            color: #fff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .nowrap {
            white-space: nowrap !important;
        }

        .print-only {
            display: inline !important;
        }
        .screen-only {
            display: none !important;
        }
    }

    .print-only { display: none; }
</style>

<div class="manifest-page">
    <div class="container">
        
        <!-- Top Navigation & Action Controls -->
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                <i class="bi bi-arrow-left"></i> Back to Operations Hub
            </a>
            <div class="d-flex gap-2">
                <a asp-action="ExportManifest" asp-route-tripId="@trip.TripId" class="btn btn-outline-success fw-bold">
                    <i class="bi bi-file-earmark-excel"></i> Export CSV
                </a>
                <button onclick="window.print()" class="btn btn-primary fw-bold px-4">
                    <i class="bi bi-printer"></i> Print Boarding Sheet
                </button>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show no-print mb-4 shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show no-print mb-4 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Boarding Manifest Card -->
        <div class="manifest-card">
            
            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-1" style="color: #06143b;">Passenger Boarding Manifest</h2>
                    <p class="text-muted mb-0">Official Dispatch &amp; Passenger Manifest • TravelMate Operations</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary fs-6 px-3 py-2">Trip #@trip.TripId</span>
                    <small class="d-block text-muted mt-1">Generated: @DateTime.UtcNow.ToString("dd MMM yyyy, HH:mm") UTC</small>
                </div>
            </div>

            <!-- Trip Meta Information Banner -->
            <div class="row g-3 p-3 bg-light rounded-3 mb-4 border align-items-center">
                <div class="col-3">
                    <span class="text-muted small d-block">Route</span>
                    <strong class="fs-6 text-dark nowrap">@trip.Route?.Origin → @trip.Route?.Destination</strong>
                </div>
                <div class="col-3">
                    <span class="text-muted small d-block">Departure Time</span>
                    <strong class="fs-6 text-dark nowrap">@trip.DepartureTime.ToString("HH:mm, dd MMM yyyy")</strong>
                </div>
                <div class="col-3">
                    <span class="text-muted small d-block">Assigned Vehicle</span>
                    <strong class="fs-6 text-dark">@trip.Vehicle?.VehicleModel (@trip.Vehicle?.LicensePlate)</strong>
                </div>
                <div class="col-3 text-end">
                    <span class="text-muted small d-block">Boarding Headcount</span>
                    <strong class="fs-6 text-primary nowrap" id="headcountText">@boardedCount / @totalBooked Boarded</strong>
                    <span class="text-muted small nowrap">(@trip.TotalSeats Capacity)</span>
                </div>
            </div>

            <!-- Passenger Checklist Table -->
            <h5 class="fw-bold mb-3" style="color: #06143b;">Boarding Passenger Checklist</h5>
            
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="nowrap text-center" style="width: 80px;">Boarded</th>
                            <th class="nowrap text-center" style="width: 75px;">Seat</th>
                            <th>Passenger Full Name</th>
                            <th class="nowrap" style="width: 170px;">IC / Passport</th>
                            <th class="nowrap text-center" style="width: 90px;">Type</th>
                            <th class="nowrap" style="width: 180px;">Baggage</th>
                            <th class="nowrap" style="width: 170px;">Booking Ref</th>
                            <th class="no-print text-end" style="width: 140px;">Admin Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var b in Model)
                            {
                                var isCancelled = b.BookingStatus == "Cancelled";

                                @foreach (var p in b.Passengers)
                                {
                                    <tr id="row_@p.PassengerId" class="@(isCancelled ? "table-danger opacity-75" : p.IsBoarded ? "table-success" : "")">
                                        <!-- Check-in Status Column -->
                                        <td class="text-center">
                                            @if (!isCancelled)
                                            {
                                                <input type="checkbox" 
                                                       class="boarding-checkbox form-check-input screen-only" 
                                                       style="width: 20px; height: 20px; cursor: pointer;"
                                                       data-id="@p.PassengerId"
                                                       @(p.IsBoarded ? "checked" : "")
                                                       onchange="saveBoardingStatus(@p.PassengerId, this.checked)" />

                                                <span class="print-only fw-bold @(p.IsBoarded ? "text-success" : "text-muted")">
                                                    @(p.IsBoarded ? "☑ Boarded" : "☐ Unchecked")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Cancelled</span>
                                            }
                                        </td>

                                        <!-- Seat Number -->
                                        <td class="fw-bold fs-6 text-primary text-center nowrap">@p.SeatNumber</td>

                                        <!-- Passenger Full Name -->
                                        <td class="fw-bold">
                                            @p.FullName
                                            @if (p.HasTravelInsurance)
                                            {
                                                <span class="badge bg-info text-dark ms-1 no-print" style="font-size: 0.65rem;">Insured</span>
                                            }
                                            @if (isCancelled && !string.IsNullOrWhiteSpace(b.CancellationReason))
                                            {
                                                <small class="d-block text-danger fw-normal" style="font-size: 0.75rem;">
                                                    <i class="bi bi-info-circle"></i> @b.CancellationReason
                                                </small>
                                            }
                                        </td>

                                        <!-- IC / Passport Number -->
                                        <td class="font-monospace nowrap">@p.IdNumber</td>

                                        <!-- Passenger Type -->
                                        <td class="text-center nowrap"><span class="badge bg-light text-dark border">@p.PassengerType</span></td>

                                        <!-- Baggage Allowance -->
                                        <td class="nowrap small">@p.BaggageOption</td>

                                        <!-- Booking Reference -->
                                        <td class="font-monospace nowrap text-dark fw-bold small">@b.BookingReference</td>

                                        <!-- Admin Action Column (Screen Only) -->
                                        <td class="no-print text-end">
                                            @if (!isCancelled)
                                            {
                                                <button type="button" 
                                                        class="btn btn-sm btn-outline-danger admin-cancel-btn"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#adminCancelModal"
                                                        data-booking-id="@b.BookingId"
                                                        data-booking-ref="@b.BookingReference"
                                                        data-passenger-name="@p.FullName"
                                                        data-seat-number="@p.SeatNumber">
                                                    <i class="bi bi-x-circle"></i> Cancel Ticket
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Refunded</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-people display-6 d-block mb-2 text-muted"></i>
                                    No passengers have booked on this trip yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Terminal Signature Footer for Physical Prints -->
            <div class="mt-4 pt-3 border-top d-flex justify-content-between text-muted small">
                <span>Driver Signature: _______________________</span>
                <span>Station Dispatcher: _______________________</span>
            </div>

        </div>
    </div>
</div>

<!-- ===================================================== -->
<!-- ADMIN CANCELLATION MODAL DIALOG                       -->
<!-- ===================================================== -->
<div class="modal fade no-print" id="adminCancelModal" tabindex="-1" aria-labelledby="adminCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="CancelBooking" method="post" id="adminCancelForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" id="adminBookingIdInput" />
                <input type="hidden" name="returnTripId" value="@trip.TripId" />

                <div class="modal-header bg-danger text-white px-4 py-3">
                    <h5 class="modal-title fw-bold" id="adminCancelModalLabel">
                        <i class="bi bi-shield-exclamation me-2"></i> Administrator Ticket Cancellation
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-warning small border-0 mb-3">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                        Cancelling this ticket will immediately release the seat back to public inventory and mark the booking as refunded.
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Booking Reference</label>
                            <input type="text" id="adminModalBookingRef" class="form-control form-control-sm bg-light font-monospace fw-bold" readonly />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Passenger / Seat</label>
                            <input type="text" id="adminModalPassengerSeat" class="form-control form-control-sm bg-light fw-bold text-primary" readonly />
                        </div>
                    </div>

                    <!-- Dispatcher Reason Presets -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select Audit Reason Category <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="adminReasonPreset" onchange="applyAdminReason(this.value)">
                            <option value="">-- Choose administrative reason --</option>
                            <option value="Customer phone / counter request for cancellation">Customer requested cancellation via counter/phone</option>
                            <option value="Passenger no-show prior to terminal departure">Passenger no-show prior to departure cutoff</option>
                            <option value="Operational schedule change or bus breakdown">Operational schedule change or fleet breakdown</option>
                            <option value="Failed identity or passport security verification">Failed identity or passport verification</option>
                            <option value="Duplicate or fraudulent reservation override">Duplicate booking or payment chargeback</option>
                            <option value="Other">Other administrative reason (Specify below)</option>
                        </select>
                    </div>

                    <!-- Detailed Administrative Explanation -->
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Official Cancellation Explanation <span class="text-danger">*</span></label>
                        <textarea name="cancellationReason" 
                                  id="adminReasonTextarea" 
                                  class="form-control" 
                                  rows="3" 
                                  placeholder="Provide detailed administrative notes for this cancellation..." 
                                  required 
                                  minlength="5" 
                                  maxlength="400"></textarea>
                        <small class="text-muted d-block mt-1">Minimum 5 characters required for audit records.</small>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger fw-bold px-4">
                        <i class="bi bi-x-octagon-fill me-1"></i> Authorize Cancellation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript for Check-in Auto-save & Admin Cancellation Modal -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Event delegation to populate administrative cancellation modal
        document.querySelectorAll('.admin-cancel-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const bookingId = this.getAttribute('data-booking-id');
                const bookingRef = this.getAttribute('data-booking-ref');
                const passengerName = this.getAttribute('data-passenger-name');
                const seatNumber = this.getAttribute('data-seat-number');

                document.getElementById('adminBookingIdInput').value = bookingId;
                document.getElementById('adminModalBookingRef').value = bookingRef;
                document.getElementById('adminModalPassengerSeat').value = passengerName + ' (Seat ' + seatNumber + ')';

                // Reset inputs
                document.getElementById('adminReasonPreset').value = '';
                document.getElementById('adminReasonTextarea').value = '';
            });
        });
    });

    // Helper to auto-fill preset reason into admin textarea
    function applyAdminReason(val) {
        const textarea = document.getElementById('adminReasonTextarea');
        if (val && val !== 'Other') {
            textarea.value = val;
        } else if (val === 'Other') {
            textarea.value = '';
            textarea.placeholder = 'Type detailed administrative notes here...';
            textarea.focus();
        }
    }

    // Auto-save check-in boarding status via AJAX
    function saveBoardingStatus(passengerId, isBoarded) {
        const row = document.getElementById('row_' + passengerId);
        if (isBoarded) {
            row.classList.add('table-success');
        } else {
            row.classList.remove('table-success');
        }

        const formData = new FormData();
        formData.append('passengerId', passengerId);
        formData.append('isBoarded', isBoarded);

        fetch('@Url.Action("ToggleBoarding", "AdminTransportation")', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            const checkedCount = document.querySelectorAll('.boarding-checkbox:checked').length;
            const totalCount = document.querySelectorAll('.boarding-checkbox').length;
            document.getElementById('headcountText').innerText = checkedCount + ' / ' + totalCount + ' Boarded';
        })
        .catch(err => {
            console.error('Auto-save error:', err);
        });
    }
</script>