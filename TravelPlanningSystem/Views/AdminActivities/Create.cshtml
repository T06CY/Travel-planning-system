@model TravelPlanningSystem.ViewModels.ActivityFormViewModel

@{
    ViewData["Title"] = "Create Activity";
}

<link rel="stylesheet" href="~/css/activities.css" />

<div class="admin-page">
    <div class="container narrow-container">

        <div class="form-page-header">

            <a asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Activity Management
            </a>

            <h1>Create a New Activity</h1>

            <p>
                Add the essential information first.
                Sessions and photos can also be managed after saving.
            </p>

        </div>

        <partial name="_ActivityForm"
                 model="Model" />

    </div>
</div>