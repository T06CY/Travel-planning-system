    @@media(max-width:1200px) {

        .activity-form-layout {
            grid-template-columns: minmax(0, 1fr) 320px;
        }

        .pricing-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media(max-width:950px) {

        .activity-form-layout {
            grid-template-columns: 1fr;
        }

        .activity-form-sidebar {
            position: static;
        }

        .activity-preview-card {
            max-width: none;
        }
    }

    @@media(max-width:700px) {

        .activity-form-card {
            padding: 18px;
        }

        .form-grid-two,
        .visibility-grid {
            grid-template-columns: 1fr;
        }

        .pricing-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media(max-width:480px) {

        .pricing-grid {
            grid-template-columns: 1fr;
        }

        .activity-form-actions {
            grid-template-columns: 1fr;
        }
    }

</style>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const activityName =
                document.getElementById(
                    "ActivityName");

            const destination =
                document.getElementById(
                    "Destination");

            const locationInput =
                document.getElementById(
                    "Location");

            const description =
                document.getElementById(
                    "Description");

            const priceInput =
                document.getElementById(
                    "PricePerPerson");

            const duration =
                document.getElementById(
                    "DurationHours");

            const minimumParticipants =
                document.getElementById(
                    "MinimumParticipants");

            const maximumParticipants =
                document.getElementById(
                    "MaximumParticipants");

            const minimumAge =
                document.getElementById(
                    "MinimumAge");

            const photoInput =
                document.getElementById(
                    "activityPhotos");

            const previewName =
                document.getElementById(
                    "previewActivityName");

            const previewLocation =
                document.getElementById(
                    "previewLocation");

            const previewDescription =
                document.getElementById(
                    "previewDescription");

            const previewPrice =
                document.getElementById(
                    "previewPrice");

            const previewDuration =
                document.getElementById(
                    "previewDuration");

            const previewParticipants =
                document.getElementById(
                    "previewParticipants");

            const previewAge =
                document.getElementById(
                    "previewAge");

            const previewImage =
                document.getElementById(
                    "activityPreviewImage");

            const previewImagePlaceholder =
                document.getElementById(
                    "previewImagePlaceholder");

            const selectedPhotoInfo =
                document.getElementById(
                    "selectedPhotoInfo");

            const descriptionCounter =
                document.getElementById(
                    "descriptionCounter");

            const durationExample =
                document.getElementById(
                    "durationExample");

            const photoUploadBox =
                document.getElementById(
                    "photoUploadBox");


            function updateName() {

                if (!previewName) {
                    return;
                }

                const value =
                    activityName?.value.trim();

                previewName.textContent =
                    value ||
                    "Activity Name";

            }


            function updateLocation() {

                if (!previewLocation) {
                    return;
                }

                const destinationValue =
                    destination?.value.trim() ||
                    "Destination";

                const locationValue =
                    locationInput?.value.trim() ||
                    "Location";

                previewLocation.textContent =
                    destinationValue +
                    ", " +
                    locationValue;

            }


            function updateDescription() {

                if (previewDescription) {

                    const value =
                        description?.value.trim();

                    previewDescription.textContent =
                        value ||
                        "Add a description to give travellers an overview of this activity.";

                }

                if (
                    description &&
                    descriptionCounter
                ) {

                    descriptionCounter.textContent =
                        description.value.length +
                        " / 2000";

                }

            }


            function cleanPriceInput() {

                if (!priceInput) {
                    return;
                }

                let value =
                    priceInput.value;

                value =
                    value.replace(
                        /[^0-9.]/g,
                        "");

                const firstDot =
                    value.indexOf(".");

                if (firstDot !== -1) {

                    const integerPart =
                        value.substring(
                            0,
                            firstDot);

                    let decimalPart =
                        value.substring(
                            firstDot + 1);

                    decimalPart =
                        decimalPart.replace(
                            /\./g,
                            "");

                    decimalPart =
                        decimalPart.substring(
                            0,
                            2);

                    value =
                        integerPart +
                        "." +
                        decimalPart;

                }

                if (
                    value.startsWith(".")
                ) {

                    value =
                        "0" + value;

                }

                priceInput.value =
                    value;

            }


            function updatePricePreview() {

                if (
                    !priceInput ||
                    !previewPrice
                ) {
                    return;
                }

                const raw =
                    priceInput.value.trim();

                if (
                    raw === "" ||
                    raw === "." ||
                    raw === "0."
                ) {

                    previewPrice.textContent =
                        raw === "0."
                            ? "0.00"
                            : "0.00";

                    return;
                }

                const price =
                    Number.parseFloat(
                        raw);

                if (
                    Number.isNaN(price)
                ) {

                    previewPrice.textContent =
                        "0.00";

                    return;
                }

                previewPrice.textContent =
                    price.toLocaleString(
                        "en-MY",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });

            }


            function formatPriceOnBlur() {

                if (!priceInput) {
                    return;
                }

                const raw =
                    priceInput.value.trim();

                if (
                    raw === "" ||
                    raw === "."
                ) {
                    return;
                }

                const price =
                    Number.parseFloat(
                        raw);

                if (
                    Number.isNaN(price)
                ) {
                    return;
                }

                priceInput.value =
                    price.toFixed(2);

                updatePricePreview();

            }


            function updateDuration() {

                if (previewDuration) {

                    const value =
                        Number.parseFloat(
                            duration?.value);

                    previewDuration.textContent =
                        !Number.isNaN(value) &&
                        value > 0
                            ? value +
                              (value === 1
                                  ? " hr"
                                  : " hrs")
                            : "0 hrs";

                }

                if (!durationExample) {
                    return;
                }

                const value =
                    Number.parseFloat(
                        duration?.value);

                if (
                    Number.isNaN(value) ||
                    value <= 0
                ) {

                    durationExample.textContent =
                        "The session end time will be calculated automatically.";

                    return;
                }

                const startMinutes =
                    9 * 60;

                const totalMinutes =
                    startMinutes +
                    Math.round(
                        value * 60);

                const hours24 =
                    Math.floor(
                        totalMinutes / 60) %
                    24;

                const minutes =
                    totalMinutes % 60;

                const period =
                    hours24 >= 12
                        ? "PM"
                        : "AM";

                const hours12 =
                    hours24 % 12 === 0
                        ? 12
                        : hours24 % 12;

                const endTime =
                    hours12 +
                    ":" +
                    minutes
                        .toString()
                        .padStart(2, "0") +
                    " " +
                    period;

                durationExample.textContent =
                    "Example: If duration is " +
                    value +
                    " hour" +
                    (value === 1
                        ? ""
                        : "s") +
                    " and the session starts at 9:00 AM, the end time will be " +
                    endTime +
                    ".";

            }


            function updateParticipants() {

                if (!previewParticipants) {
                    return;
                }

                const min =
                    minimumParticipants?.value ||
                    "1";

                const max =
                    maximumParticipants?.value ||
                    "20";

                previewParticipants.textContent =
                    min +
                    " - " +
                    max;

            }


            function updateAge() {

                if (!previewAge) {
                    return;
                }

                const age =
                    minimumAge?.value ||
                    "0";

                previewAge.textContent =
                    "Age " +
                    age +
                    "+";

            }


            function showSelectedPhotos(
                files
            ) {

                if (
                    !files ||
                    files.length === 0
                ) {
                    return;
                }

                if (selectedPhotoInfo) {

                    selectedPhotoInfo.textContent =
                        files.length === 1
                            ? files[0].name
                            : files.length +
                              " photos selected";

                }

                const firstFile =
                    files[0];

                if (
                    !firstFile.type.startsWith(
                        "image/")
                ) {
                    return;
                }

                const reader =
                    new FileReader();

                reader.onload =
                    function (event) {

                        if (!previewImage) {
                            return;
                        }

                        previewImage.src =
                            event.target.result;

                        previewImage.style.display =
                            "block";

                        if (
                            previewImagePlaceholder
                        ) {

                            previewImagePlaceholder.style.display =
                                "none";

                        }

                    };

                reader.readAsDataURL(
                    firstFile);

            }


            activityName?.addEventListener(
                "input",
                updateName);

            destination?.addEventListener(
                "input",
                updateLocation);

            locationInput?.addEventListener(
                "input",
                updateLocation);

            description?.addEventListener(
                "input",
                updateDescription);


            priceInput?.addEventListener(
                "input",
                function () {

                    cleanPriceInput();
                    updatePricePreview();

                });


            priceInput?.addEventListener(
                "blur",
                formatPriceOnBlur);


            priceInput?.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "," &&
                        !this.value.includes(".")
                    ) {

                        event.preventDefault();

                        const start =
                            this.selectionStart;

                        const end =
                            this.selectionEnd;

                        this.value =
                            this.value.substring(
                                0,
                                start) +
                            "." +
                            this.value.substring(
                                end);

                        this.selectionStart =
                            this.selectionEnd =
                                start + 1;

                        this.dispatchEvent(
                            new Event(
                                "input",
                                {
                                    bubbles: true
                                }));

                    }

                });


            duration?.addEventListener(
                "input",
                updateDuration);

            minimumParticipants
                ?.addEventListener(
                    "input",
                    updateParticipants);

            maximumParticipants
                ?.addEventListener(
                    "input",
                    updateParticipants);

            minimumAge?.addEventListener(
                "input",
                updateAge);


            photoInput?.addEventListener(
                "change",
                function () {

                    showSelectedPhotos(
                        this.files);

                });


            if (photoUploadBox) {

                photoUploadBox.addEventListener(
                    "dragover",
                    function (event) {

                        event.preventDefault();

                        photoUploadBox
                            .classList
                            .add(
                                "dragging");

                    });


                photoUploadBox.addEventListener(
                    "dragleave",
                    function () {

                        photoUploadBox
                            .classList
                            .remove(
                                "dragging");

                    });


                photoUploadBox.addEventListener(
                    "drop",
                    function (event) {

                        event.preventDefault();

                        photoUploadBox
                            .classList
                            .remove(
                                "dragging");

                        if (
                            !photoInput ||
                            !event.dataTransfer.files.length
                        ) {
                            return;
                        }

                        photoInput.files =
                            event.dataTransfer.files;

                        showSelectedPhotos(
                            photoInput.files);

                    });

            }


            updateName();
            updateLocation();
            updateDescription();
            updatePricePreview();
            updateDuration();
            updateParticipants();
            updateAge();

        });

</script>