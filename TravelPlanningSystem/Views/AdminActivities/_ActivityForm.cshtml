        }

    .save-activity-button {
        border: none;
        background: linear-gradient( 135deg, #8b5cf6, #7c3aed);
        color: #ffffff;
        box-shadow: 0 7px 18px rgba(124, 58, 237, .22);
    }

        .save-activity-button:hover {
            background: linear-gradient( 135deg, #7c3aed, #6d28d9);
