@model TravelPlanningSystem.ViewModels.ActivityFormViewModel
@using System.Globalization

@{
    var isEdit = Model.ActivityId > 0;
    var formAction = isEdit ? "Edit" : "Create";

    var existingPhotoUrl =
        ViewBag.ExistingPhotoUrl as string;

    var priceValue =
        Model.PricePerPerson > 0
            ? Model.PricePerPerson.ToString("0.00", CultureInfo.InvariantCulture)
            : "";
}

<form asp-controller="AdminActivities"
      asp-action="@formAction"
      asp-route-id="@(isEdit ? Model.ActivityId : null)"
      method="post"
      enctype="multipart/form-data"
      id="activityForm">

    @Html.AntiForgeryToken()

    @if (isEdit)
    {
        <input asp-for="ActivityId"
               type="hidden" />
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger validation-summary">
    </div>

    <div class="activity-form-layout">

        <div class="activity-form-main">

            <div class="activity-form-card">

                <div class="activity-section-header">

                    <div class="section-number section-purple">
                        1
                    </div>

                    <div class="section-icon icon-purple">
                        <i class="bi bi-info-square"></i>
                    </div>

                    <div>
                        <h2>Basic Information</h2>

                        <p>
                            Describe what travellers will see
                            in the activity catalogue.
                        </p>
                    </div>

                </div>

                <div class="form-grid form-grid-two">

                    <div class="activity-field">

                        <label asp-for="ActivityName">
                            Activity Name
                            <span class="required">*</span>
                        </label>

                        <input asp-for="ActivityName"
                               class="activity-control"
                               placeholder="e.g. Cameron Highlands Tea Experience"
                               maxlength="120" />

                        <span asp-validation-for="ActivityName"
                              class="field-validation"></span>

                    </div>

                    <div class="activity-field">

                        <label asp-for="ActivityCategoryId">
                            Category
                            <span class="required">*</span>
                        </label>

                        <select asp-for="ActivityCategoryId"
                                asp-items="ViewBag.Categories"
                                class="activity-control activity-select">

                            <option value="">
                                Select Category
                            </option>

                        </select>

                        <span asp-validation-for="ActivityCategoryId"
                              class="field-validation"></span>

                    </div>

                </div>

                <div class="form-grid form-grid-two">

                    <div class="activity-field">

                        <label asp-for="Destination">
                            Destination
                            <span class="required">*</span>
                        </label>

                        <input asp-for="Destination"
                               class="activity-control"
                               placeholder="e.g. Langkawi, Kedah"
                               maxlength="80" />

                        <span asp-validation-for="Destination"
                              class="field-validation"></span>

                    </div>

                    <div class="activity-field">

                        <label asp-for="Location">
                            Location
                            <span class="required">*</span>
                        </label>

                        <input asp-for="Location"
                               class="activity-control"
                               placeholder="e.g. Pantai Cenang, Langkawi"
                               maxlength="180" />

                        <span asp-validation-for="Location"
                              class="field-validation"></span>

                    </div>

                </div>

                <div class="activity-field">

                    <label asp-for="Description">
                        Description
                        <span class="required">*</span>
                    </label>

                    <textarea asp-for="Description"
                              class="activity-control activity-textarea description-textarea"
                              maxlength="2000"
                              placeholder="Describe the activity, highlights, experience and what makes it special..."></textarea>

                    <div class="textarea-footer">

                        <span asp-validation-for="Description"
                              class="field-validation"></span>

                        <span id="descriptionCounter"
                              class="character-counter">
                            0 / 2000
                        </span>

                    </div>

                </div>

            </div>


            <div class="activity-form-card">

                <div class="activity-section-header">

                    <div class="section-number section-red">
                        2
                    </div>

                    <div class="section-icon icon-red">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div>
                        <h2>Pricing and Participation</h2>

                        <p>
                            Set the business rules used during booking.
                        </p>
                    </div>

                </div>

                <div class="pricing-grid">

                    <div class="activity-field">

                        <label for="PricePerPerson">
                            Price per Person
                            <span class="required">*</span>
                        </label>

                        <div class="input-addon-wrapper price-wrapper">

                            <span class="input-addon">
                                RM
                            </span>

                            <input id="PricePerPerson"
                                   name="PricePerPerson"
                                   type="text"
                                   inputmode="decimal"
                                   class="activity-control input-with-addon"
                                   value="@priceValue"
                                   placeholder="120.00"
                                   autocomplete="off"
                                   maxlength="10" />

                        </div>

                        <span asp-validation-for="PricePerPerson"
                              class="field-validation"></span>

                    </div>


                    <div class="activity-field">

                        <label asp-for="DurationHours">
                            Duration (Hours)
                            <span class="required">*</span>
                        </label>

                        <input asp-for="DurationHours"
                               type="number"
                               min="0.5"
                               max="72"
                               step="0.5"
                               class="activity-control"
                               placeholder="3" />

                        <span asp-validation-for="DurationHours"
                              class="field-validation"></span>

                    </div>


                    <div class="activity-field">

                        <label asp-for="MinimumParticipants">
                            Minimum Participants
                            <span class="required">*</span>
                        </label>

                        <input asp-for="MinimumParticipants"
                               type="number"
                               min="1"
                               max="100"
                               step="1"
                               class="activity-control"
                               placeholder="1" />

                        <span asp-validation-for="MinimumParticipants"
                              class="field-validation"></span>

                    </div>


                    <div class="activity-field">

                        <label asp-for="MaximumParticipants">
                            Maximum Participants
                            <span class="required">*</span>
                        </label>

                        <input asp-for="MaximumParticipants"
                               type="number"
                               min="1"
                               max="500"
                               step="1"
                               class="activity-control"
                               placeholder="20" />

                        <span asp-validation-for="MaximumParticipants"
                              class="field-validation"></span>

                    </div>


                    <div class="activity-field">

                        <label asp-for="MinimumAge">
                            Minimum Age
                        </label>

                        <input asp-for="MinimumAge"
                               type="number"
                               min="0"
                               max="100"
                               step="1"
                               class="activity-control"
                               placeholder="0" />

                        <span asp-validation-for="MinimumAge"
                              class="field-validation"></span>

                    </div>

                </div>


                <div class="duration-information">

                    <div class="duration-info-icon">
                        <i class="bi bi-info-lg"></i>
                    </div>

                    <div>
                        <strong>
                            Duration Information
                        </strong>

                        <span>
                            Duration automatically determines
                            the session end time.
                        </span>

                        <small id="durationExample">
                            Example: If duration is 3 hours
                            and the session starts at 9:00 AM,
                            the end time will be 12:00 PM.
                        </small>
                    </div>

                </div>

            </div>


            <div class="activity-form-card">

                <div class="activity-section-header">

                    <div class="section-number section-green">
                        3
                    </div>

                    <div class="section-icon icon-green">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>
                        <h2>Guest Information</h2>

                        <p>
                            Tell travellers what is included
                            and what to bring.
                        </p>
                    </div>

                </div>

                <div class="form-grid form-grid-two">

                    <div class="activity-field">

                        <label asp-for="IncludedItems">
                            What's Included
                        </label>

                        <textarea asp-for="IncludedItems"
                                  class="activity-control activity-textarea guest-textarea"
                                  maxlength="300"
                                  placeholder="e.g. Guided tour, entrance fees, refreshments..."></textarea>

                        <span asp-validation-for="IncludedItems"
                              class="field-validation"></span>

                    </div>


                    <div class="activity-field">

                        <label asp-for="WhatToBring">
                            What to Bring
                        </label>

                        <textarea asp-for="WhatToBring"
                                  class="activity-control activity-textarea guest-textarea"
                                  maxlength="300"
                                  placeholder="e.g. Comfortable shoes, sunscreen, camera..."></textarea>

                        <span asp-validation-for="WhatToBring"
                              class="field-validation"></span>

                    </div>

                </div>

            </div>


            <div class="activity-form-card">

                <div class="activity-section-header">

                    <div class="section-number section-orange">
                        4
                    </div>

                    <div class="section-icon icon-orange">
                        <i class="bi bi-image"></i>
                    </div>

                    <div>
                        <h2>Photo and Visibility</h2>

                        <p>
                            @if (isEdit)
                            {
                                <text>
                                    Upload a new photo to replace
                                    the current activity gallery.
                                </text>
                            }
                            else
                            {
                                <text>
                                    Upload activity photos and
                                    control customer visibility.
                                </text>
                            }
                        </p>
                    </div>

                </div>


                <div class="photo-upload-box"
                     id="photoUploadBox">

                    <input asp-for="Photos"
                           id="activityPhotos"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           multiple
                           hidden />

                    <label for="activityPhotos"
                           class="photo-upload-label">

                        <div class="upload-icon">
                            <i class="bi bi-cloud-arrow-up"></i>
                        </div>

                        <strong>
                            @(isEdit
                                ? "Replace Activity Photos"
                                : "Upload Activity Photos")
                        </strong>

                        <span>
                            Click to browse or drag photos here
                        </span>

                        <small>
                            JPG, PNG or WEBP · Maximum 5 MB each
                        </small>

                    </label>

                </div>

                <div id="selectedPhotoInfo"
                     class="selected-photo-info">
                </div>

                <span asp-validation-for="Photos"
                      class="field-validation"></span>


                <div class="visibility-grid">

                    <label class="visibility-option">

                        <div class="visibility-text">

                            <div class="visibility-icon active-visibility-icon">
                                <i class="bi bi-eye"></i>
                            </div>

                            <div>
                                <strong>Active</strong>

                                <span>
                                    Show this activity to customers.
                                </span>
                            </div>

                        </div>

                        <span class="switch-control">

                            <input asp-for="IsActive"
                                   type="checkbox" />

                            <span class="switch-slider"></span>

                        </span>

                    </label>


                    <label class="visibility-option">

                        <div class="visibility-text">

                            <div class="visibility-icon featured-visibility-icon">
                                <i class="bi bi-star"></i>
                            </div>

                            <div>
                                <strong>Featured</strong>

                                <span>
                                    Promote this activity to customers.
                                </span>
                            </div>

                        </div>

                        <span class="switch-control">

                            <input asp-for="IsFeatured"
                                   type="checkbox" />

                            <span class="switch-slider"></span>

                        </span>

                    </label>

                </div>

            </div>

        </div>


        <div class="activity-form-sidebar">

            <div class="activity-preview-card">

                <div class="preview-heading">

                    <div class="preview-heading-icon">
                        <i class="bi bi-eye"></i>
                    </div>

                    <div>
                        <h3>Activity Preview</h3>

                        <span>
                            Preview the activity before saving.
                        </span>
                    </div>

                </div>


                <div class="preview-image-area">

                    @if (!string.IsNullOrWhiteSpace(existingPhotoUrl))
                    {
                        <img id="activityPreviewImage"
                             src="@existingPhotoUrl"
                             alt="Activity preview"
                             class="preview-image" />

                        <div id="previewImagePlaceholder"
                             class="preview-image-placeholder"
                             style="display:none;">

                            <i class="bi bi-image"></i>

                            <strong>No image selected</strong>

                        </div>
                    }
                    else
                    {
                        <img id="activityPreviewImage"
                             src=""
                             alt="Activity preview"
                             class="preview-image"
                             style="display:none;" />

                        <div id="previewImagePlaceholder"
                             class="preview-image-placeholder">

                            <i class="bi bi-image"></i>

                            <strong>
                                No image selected
                            </strong>

                            <span>
                                Upload a photo to see a preview
                            </span>

                        </div>
                    }

                </div>


                <h2 id="previewActivityName"
                    class="preview-activity-name">

                    @(string.IsNullOrWhiteSpace(Model.ActivityName)
                        ? "Activity Name"
                        : Model.ActivityName)

                </h2>


                <div class="preview-location">

                    <i class="bi bi-geo-alt-fill"></i>

                    <span id="previewLocation">
                        @{
                            var previewDestination =
                                string.IsNullOrWhiteSpace(Model.Destination)
                                    ? "Destination"
                                    : Model.Destination;

                            var previewLocationText =
                                string.IsNullOrWhiteSpace(Model.Location)
                                    ? "Location"
                                    : Model.Location;
                        }

                        @previewDestination, @previewLocationText
                    </span>

                </div>


                <div class="preview-stat-grid">

                    <div class="preview-stat">

                        <i class="bi bi-clock"></i>

                        <span id="previewDuration">
                            @Model.DurationHours hrs
                        </span>

                    </div>


                    <div class="preview-stat">

                        <i class="bi bi-people"></i>

                        <span id="previewParticipants">
                            @Model.MinimumParticipants -
                            @Model.MaximumParticipants
                        </span>

                    </div>


                    <div class="preview-stat">

                        <i class="bi bi-person"></i>

                        <span id="previewAge">
                            Age @Model.MinimumAge+
                        </span>

                    </div>

                </div>


                <div class="preview-price">

                    RM
                    <span id="previewPrice">
                        @Model.PricePerPerson.ToString("N2")
                    </span>

                </div>

                <span class="preview-price-caption">
                    per person
                </span>


                <p id="previewDescription"
                   class="preview-description">

                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Add a description to give travellers an overview of this activity."
                        : Model.Description)

                </p>

            </div>


            <div class="activity-tips-card">

                <div class="tips-heading">

                    <div class="tips-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>

                    <h3>
                        Tips for a Great Activity Listing
                    </h3>

                </div>

                <ul>

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        Use a clear activity name.
                    </li>

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        Provide accurate activity information.
                    </li>

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        Upload a high-quality activity photo.
                    </li>

                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        Set realistic participant limits.
                    </li>

                </ul>

            </div>


            <div class="activity-form-actions">

                <a asp-action="@(isEdit ? "Details" : "Index")"
                   asp-route-id="@(isEdit ? Model.ActivityId : null)"
                   class="cancel-activity-button">

                    <i class="bi bi-x-lg"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="save-activity-button">

                    <i class="bi bi-check-lg"></i>

                    @(isEdit
                        ? "Save Changes"
                        : "Create Activity")

                </button>

            </div>

        </div>

    </div>

</form>


<style>

    .activity-form-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 22px;
        align-items: start;
    }

    .activity-form-main {
        min-width: 0;
    }

    .activity-form-card {
        margin-bottom: 20px;
        padding: 24px;
        background: #ffffff;
        border: 1px solid #ececf5;
        border-radius: 20px;
        box-shadow: 0 7px 25px rgba(15, 23, 42, .045);
    }

    .activity-section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .section-number {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 900;
    }

    .section-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 16px;
    }

    .section-purple {
        color: #7c3aed;
        background: #f3e8ff;
    }

    .icon-purple {
        color: #7c3aed;
        background: #faf5ff;
    }

    .section-red {
        color: #ef4444;
        background: #fee2e2;
    }

    .icon-red {
        color: #ef4444;
        background: #fff1f2;
    }

    .section-green {
        color: #16a34a;
        background: #dcfce7;
    }

    .icon-green {
        color: #16a34a;
        background: #f0fdf4;
    }

    .section-orange {
        color: #d97706;
        background: #fef3c7;
    }

    .icon-orange {
        color: #d97706;
        background: #fffbeb;
    }

    .activity-section-header h2 {
        margin: 0;
        color: #111827;
        font-size: 17px;
        font-weight: 850;
    }

    .activity-section-header p {
        margin: 3px 0 0;
        color: #9ca3af;
        font-size: 11px;
    }

    .form-grid {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .form-grid-two {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pricing-grid {
        display: grid;
        grid-template-columns: 1.1fr .95fr .95fr .95fr .8fr;
        gap: 12px;
        align-items: start;
    }

    .activity-field {
        min-width: 0;
    }

        .activity-field > label {
            display: block;
            margin-bottom: 7px;
            color: #374151;
            font-size: 11px;
            font-weight: 800;
        }

    .required {
        color: #ef4444;
    }

    .activity-control {
        width: 100%;
        height: 42px;
        padding: 0 12px;
        border: 1px solid #dfe3ec;
        border-radius: 10px;
        outline: none;
        background: #ffffff;
        color: #111827;
        font-family: inherit;
        font-size: 12px;
        transition: border-color .18s ease, box-shadow .18s ease;
        box-sizing: border-box;
    }

        .activity-control:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, .09);
        }

        .activity-control::placeholder {
            color: #b6bdc9;
        }

    .activity-select {
        cursor: pointer;
    }

    .activity-textarea {
        height: auto;
        min-height: 90px;
        padding: 11px 12px;
        resize: vertical;
        line-height: 1.55;
    }

    .description-textarea {
        min-height: 105px;
    }

    .guest-textarea {
        min-height: 88px;
    }

    .textarea-footer {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 5px;
    }

    .character-counter {
        margin-left: auto;
        color: #9ca3af;
        font-size: 9px;
    }

    .field-validation {
        display: block;
        min-height: 13px;
        margin-top: 4px;
        color: #dc2626;
        font-size: 9px;
        font-weight: 600;
    }

    .input-addon-wrapper {
        position: relative;
        display: flex;
        width: 100%;
    }

    .input-addon {
        width: 48px;
        height: 42px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dfe3ec;
        border-right: none;
        border-radius: 10px 0 0 10px;
        background: #f8fafc;
        color: #374151;
        font-size: 11px;
        font-weight: 850;
        box-sizing: border-box;
    }

    .input-with-addon {
        border-radius: 0 10px 10px 0;
    }

    .price-wrapper:focus-within .input-addon {
        border-color: #8b5cf6;
    }

    .duration-information {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-top: 3px;
        padding: 11px 14px;
        border: 1px solid #dbeafe;
        border-radius: 11px;
        background: #eff6ff;
    }

    .duration-info-icon {
        width: 27px;
        height: 27px;
        flex: 0 0 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #2563eb;
        color: #ffffff;
        font-size: 13px;
    }

    .duration-information strong {
        display: block;
        margin-bottom: 2px;
        color: #2563eb;
        font-size: 10px;
        font-weight: 850;
    }

    .duration-information span {
        display: block;
        color: #64748b;
        font-size: 9px;
    }

    .duration-information small {
        display: block;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 8px;
    }

    .photo-upload-box {
        position: relative;
        min-height: 135px;
        border: 2px dashed #d8dbea;
        border-radius: 14px;
        background: #fcfcff;
        transition: .18s ease;
    }

        .photo-upload-box:hover,
        .photo-upload-box.dragging {
            border-color: #8b5cf6;
            background: #faf7ff;
        }

    .photo-upload-label {
        min-height: 135px;
        width: 100%;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 18px;
        box-sizing: border-box;
    }

    .upload-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 7px;
        border-radius: 13px;
        background: #f5f3ff;
        color: #7c3aed;
        font-size: 19px;
    }

    .photo-upload-label strong {
        color: #111827;
        font-size: 11px;
        font-weight: 850;
    }

    .photo-upload-label span {
        margin-top: 3px;
        color: #7c3aed;
        font-size: 9px;
        font-weight: 700;
    }

    .photo-upload-label small {
        margin-top: 4px;
        color: #9ca3af;
        font-size: 8px;
    }

    .selected-photo-info {
        margin-top: 8px;
        color: #6b7280;
        font-size: 10px;
    }

    .visibility-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 18px;
    }

    .visibility-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 14px;
        border: 1px solid #e5e7eb;
        border-radius: 13px;
        background: #ffffff;
        cursor: pointer;
    }

    .visibility-text {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .visibility-icon {
        width: 35px;
        height: 35px;
        flex: 0 0 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 15px;
    }

    .active-visibility-icon {
        color: #16a34a;
        background: #ecfdf5;
    }

    .featured-visibility-icon {
        color: #d97706;
        background: #fffbeb;
    }

    .visibility-text strong {
        display: block;
        color: #111827;
        font-size: 11px;
    }

    .visibility-text span {
        display: block;
