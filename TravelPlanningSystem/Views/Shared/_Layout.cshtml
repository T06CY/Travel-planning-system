@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

@using System.Security.Claims

@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    string? userName = null;
    string? profilePicture = null;
    string? profileUrl = null;
    if (isAuth)
    {
        userName = User.FindFirst(ClaimTypes.Name)?.Value ?? User.Identity.Name;
        profilePicture = User.FindFirst("ProfilePictureUrl")?.Value;
        profileUrl = Url.Action("Profile", "Account");
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - TravelMate</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/travelmate.css" />
</head>

<body>
    <nav class="navbar navbar-expand-lg main-navbar">
        <div class="container-fluid px-5">
            <a class="navbar-brand logo-box" asp-controller="Home" asp-action="Index">
                <div class="logo-icon">
                    <i class="bi bi-airplane-fill"></i>
                </div>
                <div>
                    <h3>Travel<span>Mate</span></h3>
                    <small>Plan Smarter, Travel Better</small>
                </div>
            </a>

            <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav mx-auto nav-menu">

                    <li>
                        <a class="nav-link @(currentController == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                    </li>

                    <li>
                        <a class="nav-link @(currentController == "Flight" ? "active" : "")"
                           asp-controller="Flight" asp-action="Index">
                            <i class="bi bi-airplane"></i> Flights
                        </a>
                    </li>

                    <li>
                        <a class="nav-link @(currentController == "Hotel" ? "active" : "")"
                           asp-controller="Hotel" asp-action="Index">
                            <i class="bi bi-building"></i> Hotels
                        </a>
                    </li>

                    <li>
                        <a class="nav-link @(currentController == "Transportation" ? "active" : "")"
                           asp-controller="Transportation" asp-action="Index">
                            <i class="bi bi-car-front"></i> Transport
                        </a>
                    </li>

                    <li>
                        <a class="nav-link @(currentController == "Activity" || currentController == "ActivityBookings" ? "active" : "")"
                           asp-controller="Activity" asp-action="Index">
                            <i class="bi bi-ticket-perforated"></i> Activities
                        </a>
                    </li>

                    <li>
                        <a class="nav-link @(currentController == "Booking" || currentController == "HotelReservations" ? "active" : "")"
                           asp-controller="Booking" asp-action="Index">
                           <i class="bi bi-calendar-event"></i> My Bookings
                        </a>
                    </li>

                </ul>

                <div class="right-menu">
                    @if (isAuth)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="me-2">Hello, @userName</span>

                            @if (User.IsInRole("Administrator"))
                            {
                                <a class="btn btn-outline-primary btn-sm"
                                   asp-controller="AdminDashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            }

                            <a href="@profileUrl" class="d-inline-block" title="View profile" aria-label="Profile">
                                @if (!string.IsNullOrEmpty(profilePicture))
                                {
                                    <img src="@profilePicture" alt="Profile" class="rounded-circle" style="width:36px;height:36px;object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle" style="font-size:1.8rem;"></i>
                                }
                            </a>

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary">Logout</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-login" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-register" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
