@model TravelPlanningSystem.ViewModels.HotelPaymentViewModel

@{
    ViewData["Title"] = "Hotel Payment";
}

<link rel="stylesheet" href="~/css/activities.css" />

<div class="hotel-payment-page">

    <div class="container payment-container">

        <!-- PAGE HEADER -->
        <div class="payment-header">

            <a asp-action="Details"
               asp-route-id="@Model.HotelReservationId"
               class="back-link">
                <i class="bi bi-arrow-left"></i>
                Back to reservation
            </a>

            <div class="payment-heading">

                <span class="secure-label">
                    <i class="bi bi-shield-check"></i>
                    SECURE CHECKOUT
                </span>

                <h1>Complete your payment</h1>

                <p>
                    Choose your preferred payment method to confirm your reservation.
                </p>

            </div>

                        <div class="reservation-row">
                            <span class="reservation-label">Stay</span>
                            <strong>@Model.Nights night@(Model.Nights == 1 ? "" : "s")</strong>
                        </div>

        </div>


        <div class="payment-layout">


            <!-- LEFT PAYMENT FORM -->
            <form asp-action="Payment"
                  method="post"
                  class="payment-form"
                  id="hotelPaymentForm">

                <input asp-for="HotelReservationId"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- PAYMENT METHOD -->
                <section class="payment-section payment-method-section">

                    <div class="section-header">

                        <div class="section-icon">
                            <i class="bi bi-credit-card"></i>
                        </div>

                        <div class="section-title">

                            <span>CHOOSE ONE</span>

                            <h2>Payment Method</h2>

                        </div>

                    </div>


                    <div class="payment-options">


                        <!-- ONLINE BANKING -->
                        <label class="payment-option"
                               for="hotelPayFpx">

                            <input type="radio"
                                   asp-for="PaymentMethod"
                                   value="Online Banking (FPX)"
                                   id="hotelPayFpx" />

                            <div class="payment-option-content">

                                <div class="payment-option-top">

                                    <i class="bi bi-bank payment-icon"></i>

                                    <strong>
                                        Online Banking
                                    </strong>

                                </div>

                                <small>
                                    FPX
                                </small>

                                <i class="bi bi-check-circle-fill selected-icon"></i>

                            </div>

                        </label>



                        <!-- CREDIT CARD -->
                        <label class="payment-option"
                               for="hotelPayCard">

                            <input type="radio"
                                   asp-for="PaymentMethod"
                                   value="Credit / Debit Card"
                                   id="hotelPayCard" />

                            <div class="payment-option-content">

                                <div class="payment-option-top">

                                    <i class="bi bi-credit-card payment-icon"></i>

                                    <strong>
                                        Credit / Debit<br />
                                        Card
                                    </strong>

                                </div>

                                <small>
                                    Visa or Mastercard
                                </small>

                                <i class="bi bi-check-circle-fill selected-icon"></i>

                            </div>

                        </label>



                        <!-- TOUCH N GO -->
                        <label class="payment-option"
                               for="hotelPayTng">

                            <input type="radio"
                                   asp-for="PaymentMethod"
                                   value="Touch 'n Go eWallet"
                                   id="hotelPayTng" />

                            <div class="payment-option-content">

                                <div class="payment-option-top">

                                    <i class="bi bi-wallet2 payment-icon"></i>

                                    <strong>
                                        Touch 'n Go
                                    </strong>

                                </div>

                                <small>
                                    eWallet
                                </small>

                                <i class="bi bi-check-circle-fill selected-icon"></i>

                            </div>

                        </label>


                    </div>


                    <span asp-validation-for="PaymentMethod"
                          class="text-danger small">
                    </span>

                </section>



                <!-- PAYMENT BUTTON -->
                <div class="payment-action">

                    <button type="submit"
                            class="pay-button">

                        <span>
                            Pay RM @Model.TotalAmount.ToString("N2") Now
                        </span>

                        <i class="bi bi-arrow-right"></i>

                    </button>


                    <div class="secure-note">

                        <i class="bi bi-lock-fill"></i>

                        <span>
                            Safe &amp; secure 256-bit SSL checkout
                        </span>

                    </div>

                </div>


            </form>



            <!-- RIGHT PAYMENT SUMMARY -->
            <aside class="payment-summary">

                <span class="summary-label">
                    ORDER SUMMARY
                </span>

                <h2>
                    Payment Summary
                </h2>


                <div class="summary-reference">

                    <span>
                        Reservation     
                    </span>

                    <strong>
                        @Model.ReservationReference
                    </strong>

                </div>             

                <div class="summary-item">
                    <span>Room subtotal</span>
                    <strong>RM @Model.Subtotal.ToString("N2")</strong>
                </div>

                <div class="summary-item summary-voucher">
                    <span>Voucher</span>
                    <div>
                        <div class="input-group input-group-sm">
                            <input asp-for="VoucherCode" form="hotelPaymentForm" class="form-control" placeholder="Code" />
                            <button type="submit" form="hotelPaymentForm" name="action" value="apply" class="btn btn-outline-primary">Apply</button>
                        </div>
                        <small class="text-muted d-block">Try TRAVEL2026, PROMO10, or FLY50.</small>
                        @if (Model.DiscountAmount > 0)
                        {
                            <small class="text-success">- RM @Model.DiscountAmount.ToString("N2")</small>
                        }
                        <span asp-validation-for="VoucherCode" class="text-danger small d-block"></span>
                    </div>
                </div>

                <div class="summary-item">
                    <span>SST (10%)</span>
                    <strong>RM @Model.TaxAmount.ToString("N2")</strong>
                </div>


                <div class="summary-divider"></div>


                <div class="summary-item">

                    <span>
                        Hotel
                    </span>

                    <strong>
                        @Model.HotelName
                    </strong>

                </div>


                <div class="summary-item">

                    <span>
                        Room
                    </span>

                    <strong>
                        @Model.RoomName
                    </strong>

                </div>


                <div class="summary-divider"></div>


                <div class="summary-total">

                    <span>
                        Total amount
                    </span>

                    <strong>
                        RM @Model.TotalAmount.ToString("N2")
                    </strong>

                </div>


                <div class="summary-security">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Payment secured by TravelMate
                    </span>

                </div>

            </aside>


        </div>

    </div>

</div>


<style>

    /* =========================================
       PAGE
    ========================================= */

    .hotel-payment-page {
        min-height: calc(100vh - 100px);
        padding: 40px 0 70px;
        background: #f5f6f8;
    }


    .payment-container {
        max-width: 1150px;
    }


    /* =========================================
       HEADER
    ========================================= */

    .payment-header {
        margin-bottom: 30px;
    }


    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        color: #526ee8;
        text-decoration: none;

        font-size: .9rem;
        font-weight: 600;

        transition: .2s ease;
    }


    .back-link:hover {
        color: #3155d9;
        transform: translateX(-2px);
    }


    .payment-heading {
        margin-top: 24px;
    }


    .secure-label {

        display: inline-flex;
        align-items: center;
        gap: 7px;

        color: #526ee8;

        font-size: .7rem;
        font-weight: 800;

        letter-spacing: .12em;
    }


    .payment-heading h1 {

        margin: 8px 0 5px;

        color: #263a5a;

        font-size: 2.4rem;
        font-weight: 800;
    }


    .payment-heading p {

        margin: 0;

        color: #718096;

        font-size: .95rem;
    }



    /* =========================================
       MAIN LAYOUT
    ========================================= */

    .payment-layout {

        display: grid;

        grid-template-columns:
            minmax(0, 1.65fr)
            minmax(300px, .85fr);

        gap: 25px;

        align-items: start;
    }



    /* =========================================
       FORM
    ========================================= */

    .payment-form {

        background: #ffffff;

        border-radius: 18px;

        padding: 30px;

        border:
            1px solid #e3e7ee;

        box-shadow:
            0 8px 30px
            rgba(38, 58, 90, .05);
    }


    .payment-section + .payment-section {

        margin-top: 28px;

        padding-top: 28px;

        border-top:
            1px solid #e7eaf0;
    }



    /* =========================================
       SECTION HEADER
    ========================================= */

    .section-header {

        display: flex;

        align-items: center;

        gap: 14px;

        margin-bottom: 24px;
    }


    .section-icon {

        width: 48px;
        height: 48px;

        display: grid;

        place-items: center;

        border-radius: 14px;

        background: #eef1f8;

        color: #243b5d;

        font-size: 1.35rem;
    }


    .section-title span {

        display: block;

        margin-bottom: 2px;

        color: #526ee8;

        font-size: .7rem;

        font-weight: 800;

        letter-spacing: .12em;
    }


    .section-title h2 {

        margin: 0;

        color: #263a5a;

        font-size: 1.4rem;

        font-weight: 800;
    }



    /* =========================================
       RESERVATION
    ========================================= */

    .reservation-info {

        padding-top: 2px;
    }


    .reservation-row {

        display: grid;

        grid-template-columns:
            180px 1fr;

        align-items: center;

        padding: 13px 0;
    }


    .reservation-label {

        color: #718096;

        font-size: .95rem;
    }


    .reservation-row strong {

        color: #263a5a;

        font-size: .95rem;

        font-weight: 700;

        overflow-wrap: anywhere;
    }



    /* =========================================
       PAYMENT OPTIONS
    ========================================= */

    .payment-options {

        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 12px;
    }


    .payment-option {

        position: relative;

        display: block;

        cursor: pointer;
    }


    .payment-option input {

        position: absolute;

        opacity: 0;

        pointer-events: none;
    }


    .payment-option-content {

        position: relative;

        min-height: 120px;

        padding: 18px 16px;

        border-radius: 15px;

        border:
            1px solid #d8dee8;

        background:
            #fafbfc;

        transition:
            .2s ease;
    }


    .payment-option:hover
    .payment-option-content {

        border-color:
            #9aaaf4;

        background:
            #f6f8ff;
    }


    /* SELECTED */

    .payment-option input:checked
    + .payment-option-content {

        border-color:
            #526ee8;

        background:
            #f2f4ff;

        box-shadow:
            0 5px 16px
            rgba(82,110,232,.12);
    }



    /* PAYMENT OPTION TOP */

    .payment-option-top {

        display: flex;

        align-items: flex-start;

        gap: 10px;
    }


    .payment-icon {

        color:
            #526ee8;

        font-size:
            1.2rem;

        margin-top:
            1px;
    }


    .payment-option strong {

        color:
            #2c3e5b;

        font-size:
            1rem;

        font-weight:
            750;

        line-height:
            1.45;
    }


    .payment-option small {

        display:
            block;

        margin-top:
            12px;

        margin-left:
            34px;

        color:
            #718096;

        font-size:
            .8rem;
    }



    /* RADIO CIRCLE */

    .payment-option::before {

        content: "";

        position: absolute;

        top: 23px;
        left: 16px;

        width: 13px;
        height: 13px;

        border:
            1.5px solid #7d8796;

        border-radius:
            50%;

        background:
            white;

        z-index:
            5;
    }


    .payment-option::after {

        content: "";

        position: absolute;

        top: 26px;
        left: 19px;

        width: 7px;
        height: 7px;

        border-radius:
            50%;

        background:
            #526ee8;

        transform:
            scale(0);

        transition:
            .2s ease;

        z-index:
            6;
    }


    .payment-option:has(input:checked)::after {

        transform:
            scale(1);
    }


    /* Adjust content */

    .payment-option-top {

        padding-left:
            24px;
    }


    /* CHECK ICON */

    .selected-icon {

        position:
            absolute;

        right:
            14px;

        bottom:
            14px;

        color:
            #526ee8;

        opacity:
            0;

        transform:
            scale(.7);

        transition:
            .2s ease;
    }


    .payment-option input:checked
    + .payment-option-content
    .selected-icon {

        opacity:
            1;

        transform:
            scale(1);
    }



    /* =========================================
       PAYMENT BUTTON
    ========================================= */

    .payment-action {

        margin-top:
            30px;
    }


    .pay-button {

        width:
            100%;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        gap:
            14px;

        padding:
            18px;

        border:
            none;

        border-radius:
            14px;

        cursor:
            pointer;

        background:
            linear-gradient(
                135deg,
                #5a6fde,
                #3853ca
            );

        color:
            #ffffff;

        font-size:
            1rem;

        font-weight:
            800;

        box-shadow:
            0 10px 20px
            rgba(56,83,202,.22);

        transition:
            .2s ease;
    }


    .pay-button:hover {

        transform:
            translateY(-2px);

        box-shadow:
            0 14px 28px
            rgba(56,83,202,.3);
    }


    .pay-button i {

        font-size:
            1.1rem;
    }



    /* =========================================
       SECURE NOTE
    ========================================= */

    .secure-note {

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        gap:
            8px;

        margin-top:
            17px;

        color:
            #718096;

        font-size:
            .85rem;
    }


    .secure-note i {

        color:
            #2d9b6f;
    }



    /* =========================================
       PAYMENT SUMMARY
    ========================================= */

    .payment-summary {

        position:
            sticky;

        top:
            25px;

        padding:
            28px;

        border-radius:
            18px;

        background:
            #ffffff;

        border:
            1px solid #e3e7ee;

        box-shadow:
            0 8px 30px
            rgba(38,58,90,.05);
    }


    .summary-label {

        display:
            block;

        color:
            #526ee8;

        font-size:
            .7rem;

        font-weight:
            800;

        letter-spacing:
            .12em;
    }


    .payment-summary h2 {

        margin:
            8px 0 24px;

        color:
            #263a5a;

        font-size:
            1.45rem;

        font-weight:
            800;
    }



    /* REFERENCE */

    .summary-reference {

        display:
            flex;

        justify-content:
            space-between;

        gap:
            15px;

        padding:
            13px;

        border-radius:
            10px;

        background:
            #f4f6fb;

        font-size:
            .82rem;

        color:
            #718096;
    }


    .summary-reference strong {

        color:
            #2d3f5f;

        text-align:
            right;
    }



    /* SUMMARY ITEMS */

    .summary-item {

        display:
            flex;

        justify-content:
            space-between;

        gap:
            15px;

        padding:
            14px 0;

        color:
            #718096;

        font-size:
            .88rem;
    }


    .summary-item strong {

        max-width:
            60%;

        color:
            #2c3e5b;

        text-align:
            right;

        overflow-wrap:
            anywhere;
    }


    .summary-divider {

        height:
            1px;

        background:
            #e5e9f0;

        margin:
            8px 0;
    }



    /* TOTAL */

    .summary-total {

        display:
            flex;

        justify-content:
            space-between;

        align-items:
            center;

        gap:
            15px;

        padding:
            18px 0;
    }


    .summary-total span {

        color:
            #52627b;

        font-weight:
            600;
    }


    .summary-total strong {

        color:
            #263a5a;

        font-size:
            1.3rem;

        font-weight:
            800;

        white-space:
            nowrap;
    }



    /* SECURITY BOX */

    .summary-security {

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        gap:
            8px;

        margin-top:
            10px;

        padding:
            12px;

        border-radius:
            10px;

        background:
            #edf8f2;

        color:
            #31845f;

        font-size:
            .75rem;

        font-weight:
            600;
    }



    /* =========================================
       TABLET
    ========================================= */

    @@media (max-width: 900px) {

        .payment-layout {

            grid-template-columns:
                1fr;
        }


        .payment-summary {

            position:
                static;
        }

    }



    /* =========================================
       MOBILE
    ========================================= */

    @@media (max-width: 650px) {

        .hotel-payment-page {

            padding:
                25px 0 55px;
        }


        .payment-heading h1 {

            font-size:
                2rem;
        }


        .payment-form,
        .payment-summary {

            padding:
                20px;

            border-radius:
                15px;
        }


        .payment-options {

            grid-template-columns:
                1fr;
        }


        .payment-option-content {

            min-height:
                auto;
        }


        .reservation-row {

            grid-template-columns:
                1fr;

            gap:
                5px;
        }


        .summary-item {

            flex-direction:
                column;

            gap:
                5px;
        }


        .summary-item strong {

            max-width:
                100%;

            text-align:
                left;
        }

    }

</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}