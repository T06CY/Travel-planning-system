@model TravelPlanningSystem.Models.HotelReservation
<div class="container py-5"><h1>Cancel reservation</h1><p>Cancel @Model.HotelRoom?.HotelName — @Model.HotelRoom?.RoomName?</p><form asp-action="Cancel" method="post"><div class="mb-3"><label for="cancellationReason" class="form-label">Reason</label><textarea id="cancellationReason" name="cancellationReason" class="form-control" required maxlength="400"></textarea><span class="text-danger" asp-validation-for="CancellationReason"></span></div><button class="btn btn-danger">Confirm cancellation</button> <a asp-action="Details" asp-route-id="@Model.HotelReservationId" class="btn btn-outline-secondary">Keep reservation</a></form></div>
