@model IEnumerable<TravelPlanningSystem.Models.HotelReservation>
@{ ViewData["Title"] = "My hotel reservations"; }
<link rel="stylesheet" href="~/css/hotels.css" /><div class="container py-5"><h1>My hotel reservations</h1><div class="mb-4"><a asp-route-status="Confirmed">Confirmed</a> · <a asp-route-status="Completed">Completed</a> · <a asp-route-status="Cancelled">Cancelled</a> · <a asp-action="MyReservations">All</a></div>@if(!Model.Any()){<p>No hotel reservations found.</p>}else{<div class="row g-3">@foreach(var booking in Model){var photo=booking.HotelRoom?.Photos.FirstOrDefault(p=>p.IsPrimary)?.PhotoUrl ?? "/images/hero-beach.jpg";<div class="col-md-6"><div class="card h-100"><img src="@photo" class="card-img-top hotel-thumb" alt="@booking.HotelRoom?.RoomName" /><div class="card-body"><span class="badge text-bg-secondary">@booking.ReservationStatus</span><h4>@booking.HotelRoom?.HotelName</h4><p>@booking.HotelRoom?.RoomName<br />@booking.CheckInDate.ToString("dd MMM yyyy") – @booking.CheckOutDate.ToString("dd MMM yyyy")</p><a asp-action="Details" asp-route-id="@booking.HotelReservationId" class="btn btn-outline-primary">View reservation</a></div></div></div>}</div>}</div>
