@model TravelPlanningSystem.ViewModels.HotelReservationViewModel
@{ ViewData["Title"] = "Reserve room"; }
<link rel="stylesheet" href="~/css/activities.css" /><div class="form-page"><div class="container narrow-container"><div class="form-page-header"><a asp-controller="Hotel" asp-action="Details" asp-route-id="@Model.HotelRoomId"><i class="bi bi-arrow-left"></i> Back to room</a><h1>Complete your hotel reservation</h1></div><div class="checkout-layout"><form asp-action="Create" method="post" class="form-card"><input asp-for="HotelRoomId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CheckInDate" class="form-label"></label><input asp-for="CheckInDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></div><div class="col-md-6"><label asp-for="CheckOutDate" class="form-label"></label><input asp-for="CheckOutDate" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" /></div><div class="col-12"><label asp-for="GuestCount" class="form-label"></label><input asp-for="GuestCount" class="form-control" min="1" max="@Model.Capacity" /></div><div class="col-12"><label asp-for="ContactName" class="form-label"></label><input asp-for="ContactName" class="form-control" /></div><div class="col-md-6"><label asp-for="ContactEmail" class="form-label"></label><input asp-for="ContactEmail" class="form-control" /></div><div class="col-md-6"><label asp-for="ContactPhone" class="form-label"></label><input asp-for="ContactPhone" class="form-control" /></div></div><button class="btn btn-confirm-booking mt-4">Confirm reservation</button></form><aside class="summary-card"><span class="summary-label">Your stay</span><h3>@Model.HotelName</h3><p>@Model.RoomName</p><div class="summary-divider"></div><div class="summary-line"><span>Nightly rate</span><strong>RM @Model.PricePerNight.ToString("N2")</strong></div><small>The final total is calculated from your selected dates.</small></aside></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
