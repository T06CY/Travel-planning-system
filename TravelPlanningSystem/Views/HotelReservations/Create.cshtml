@model TravelPlanningSystem.ViewModels.HotelReservationViewModel
@{ ViewData["Title"] = "Reserve room"; }
<link rel="stylesheet" href="~/css/activities.css" />

<div class="form-page">
    <div class="container narrow-container">
        <div class="form-page-header">
            <a asp-controller="Hotel" asp-action="Details" asp-route-id="@Model.HotelRoomId"><i class="bi bi-arrow-left"></i> Back to room</a>
            <h1>Complete your hotel reservation</h1>
        </div>
        <div class="checkout-layout">
            <form asp-action="Create" method="post" class="form-card">
                <input asp-for="HotelRoomId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="CheckInDate" class="form-label"></label><input asp-for="CheckInDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                    <div class="col-md-6"><label asp-for="CheckOutDate" class="form-label"></label><input asp-for="CheckOutDate" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" /></div>
                    <div class="col-md-6"><label asp-for="CheckInTime" class="form-label"></label><input asp-for="CheckInTime" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="CheckOutTime" class="form-label"></label><input asp-for="CheckOutTime" class="form-control" /></div>
                    <div class="col-12"><label asp-for="GuestCount" class="form-label"></label><input asp-for="GuestCount" class="form-control" min="1" max="@Model.Capacity" /></div>

                    <div class="col-12">
                        <label class="form-label">Contact details</label>
                        <div class="booking-for-options">
                            <label class="booking-for-option"><input asp-for="BookingFor" type="radio" value="@TravelPlanningSystem.ViewModels.HotelReservationViewModel.BookForSelf" /> <span>Book For Self</span></label>
                            <label class="booking-for-option"><input asp-for="BookingFor" type="radio" value="@TravelPlanningSystem.ViewModels.HotelReservationViewModel.BookForOthers" /> <span>Book For Others</span></label>
                        </div>
                    </div>

                    <div class="col-12"><label asp-for="ContactName" class="form-label"></label><input asp-for="ContactName" class="form-control" autocomplete="name" /><span asp-validation-for="ContactName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="ContactEmail" class="form-label"></label><input asp-for="ContactEmail" class="form-control" readonly autocomplete="email" /><span asp-validation-for="ContactEmail" class="text-danger"></span></div>
                    <div class="col-md-6">
                        <label asp-for="ContactPhone" class="form-label"></label>
                        <div class="d-flex gap-2">
                            <select id="contactCountryCode" class="form-select" style="max-width:150px;" aria-label="Contact country code">
                                <option value="+60">+60 Malaysia</option>
                                <option value="+1">+1 USA</option>
                                <option value="+44">+44 UK</option>
                                <option value="+61">+61 Australia</option>
                                <option value="+65">+65 Singapore</option>
                                <option value="+91">+91 India</option>
                            </select>
                            <input id="contactLocalPhone" class="form-control" type="tel" autocomplete="tel-national" inputmode="tel" pattern="[0-9\s().-]{7,29}" maxlength="29" title="Enter a valid phone number using digits only." />
                        </div>
                        <input asp-for="ContactPhone" id="contactPhone" type="hidden" />
                        <span asp-validation-for="ContactPhone" class="text-danger"></span>
                    </div>
                </div>
                <button class="btn btn-confirm-booking mt-4">Confirm reservation</button>
            </form>
            <aside class="summary-card">
                <span class="summary-label">Your stay</span><h3>@Model.HotelName</h3><p>@Model.RoomName</p><div class="summary-divider"></div>
                <div class="summary-line"><span>Nightly rate</span><strong>RM <span id="nightlyRate">@Model.PricePerNight.ToString("N2")</span></strong></div>
                <div class="summary-line"><span>Nights</span><strong id="nightCount">—</strong></div>
                <div class="summary-line"><span>Total</span><strong>RM <span id="totalAmount">—</span></strong></div>
                <small id="priceMessage">The final total is calculated from your selected dates.</small>
            </aside>
        </div>
    </div>
</div>

<style>
    .booking-for-options { display: flex; gap: 12px; flex-wrap: wrap; }
    .booking-for-option { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid #dfe3eb; border-radius: 8px; cursor: pointer; }
    .booking-for-option:has(input:checked) { border-color: #5271ff; background: #f1f4ff; }
</style>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

<script>
    (() => {
        const options = document.querySelectorAll('input[name="BookingFor"]');
        const nameInput = document.getElementById('ContactName');
        const phoneInput = document.getElementById('contactLocalPhone');
        const phoneValue = document.getElementById('contactPhone');
        const countryCode = document.getElementById('contactCountryCode');
        const selfValue = '@TravelPlanningSystem.ViewModels.HotelReservationViewModel.BookForSelf';
        const priceUrl = '@Url.Action("CalculatePrice", "HotelReservations")';
        const roomId = document.getElementById('HotelRoomId').value;
        const priceFields = ['CheckInDate', 'CheckOutDate', 'CheckInTime', 'CheckOutTime'].map(id => document.getElementById(id));
        const nightlyRate = document.getElementById('nightlyRate');
        const nightCount = document.getElementById('nightCount');
        const totalAmount = document.getElementById('totalAmount');
        const priceMessage = document.getElementById('priceMessage');

        function updateContactFields() {
            const isSelf = document.querySelector('input[name="BookingFor"]:checked')?.value === selfValue;
            nameInput.readOnly = isSelf;
            phoneInput.readOnly = isSelf;
        }

        options.forEach(option => option.addEventListener('change', updateContactFields));

        async function updatePrice() {
            const [checkInDate, checkOutDate, checkInTime, checkOutTime] = priceFields.map(field => field.value);
            if (!checkInDate || !checkOutDate || !checkInTime || !checkOutTime) return;

            const query = new URLSearchParams({ roomId, checkInDate, checkOutDate, checkInTime, checkOutTime });
            try {
                const response = await fetch(`${priceUrl}?${query}`);
                if (!response.ok) throw new Error();
                const result = await response.json();
                nightlyRate.textContent = Number(result.pricePerNight).toFixed(2);
                nightCount.textContent = result.nights;
                totalAmount.textContent = Number(result.totalAmount).toFixed(2);
                priceMessage.textContent = 'Price updated.';
            } catch {
                nightCount.textContent = '—';
                totalAmount.textContent = '—';
                priceMessage.textContent = 'Select a valid check-in and check-out period.';
            }
        }

        priceFields.forEach(field => field.addEventListener('change', updatePrice));
        const storedPhone = phoneValue.value.trim();
        const codes = ['+60', '+1', '+44', '+61', '+65', '+91'];
        const storedCode = codes.find(code => storedPhone.startsWith(code));
        if (storedCode) {
            countryCode.value = storedCode;
            phoneInput.value = storedPhone.substring(storedCode.length).trim();
        } else {
            phoneInput.value = storedPhone;
        }

        document.querySelector('form')?.addEventListener('submit', event => {
            const digits = phoneInput.value.replace(/\D/g, '');
            if (digits.length < 7 || digits.length > 29) {
                event.preventDefault();
                phoneInput.setCustomValidity('Enter a valid phone number using digits only.');
                phoneInput.reportValidity();
                return;
            }

            phoneInput.setCustomValidity('');
            phoneValue.value = `${countryCode.value}${digits}`;
        });
        updateContactFields();
        updatePrice();
    })();
</script>
