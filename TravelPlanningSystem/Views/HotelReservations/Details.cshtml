@model TravelPlanningSystem.Models.HotelReservation

@{
    ViewData["Title"] = "Reservation Details";
}

<div class="reservation-page">

    <a asp-action="MyReservations"
       class="reservation-back">

        <i class="bi bi-arrow-left"></i>
        My Reservations
    </a>

    <div class="reservation-title">

        <div>
            <span class="reservation-eyebrow">
                HOTEL RESERVATION
            </span>

            <h1>@Model.ReservationReference</h1>

            <p>
                View your stay details and reservation information.
            </p>
        </div>

        <span class="reservation-status
            @Model.ReservationStatus.ToString().ToLower()">

            @Model.ReservationStatus

        </span>

    </div>


    <div class="reservation-grid">

        <!-- MAIN -->

        <div class="reservation-card main-card">

            <div class="hotel-summary">

                <div class="hotel-summary-icon">
                    <i class="bi bi-building"></i>
                </div>

                <div>
                    <span>Your Stay</span>
                    <h2>@Model.HotelRoom?.HotelName</h2>
                    <p>@Model.HotelRoom?.RoomName</p>
                </div>

            </div>


            <div class="stay-date-grid">

                <div class="stay-box">
                    <i class="bi bi-calendar-check"></i>

                    <span>Check-in</span>

                    <strong>
                        @Model.CheckInDate.ToString("dd MMM yyyy")
                    </strong>

                    <small>
                        @Model.CheckInTime
                    </small>
                </div>


                <div class="stay-arrow">
                    <i class="bi bi-arrow-right"></i>
                </div>


                <div class="stay-box">
                    <i class="bi bi-calendar-x"></i>

                    <span>Check-out</span>

                    <strong>
                        @Model.CheckOutDate.ToString("dd MMM yyyy")
                    </strong>

                    <small>
                        @Model.CheckOutTime
                    </small>
                </div>

            </div>


            <div class="reservation-info-grid">

                <div>
                    <span>
                        <i class="bi bi-people"></i>
                        Guests
                    </span>

                    <strong>@Model.GuestCount</strong>
                </div>

                <div>
                    <span>
                        <i class="bi bi-moon-stars"></i>
                        Room
                    </span>

                    <strong>@Model.HotelRoom?.RoomType</strong>
                </div>

                <div>
                    <span>
                        <i class="bi bi-geo-alt"></i>
                        Destination
                    </span>

                    <strong>@Model.HotelRoom?.Destination</strong>
                </div>

            </div>


            @if (Model.ReservationStatus ==
                 TravelPlanningSystem.Models.HotelReservationStatus.Confirmed)
            {
                <div class="reservation-actions">

                    <a asp-action="Cancel"
                       asp-route-id="@Model.HotelReservationId"
                       class="cancel-reservation-btn">

                        <i class="bi bi-x-circle"></i>
                        Cancel Reservation

                    </a>

                </div>
            }

        </div>


        <!-- PRICE -->

        <aside class="reservation-card price-card">

            <span class="price-label">
                Reservation Total
            </span>

            <h2>
                RM @Model.TotalAmount.ToString("N2")
            </h2>

            <div class="price-divider"></div>

            <div class="price-row">
                <span>Price per night</span>
                <strong>
                    RM @Model.PricePerNight.ToString("N2")
                </strong>
            </div>

            <div class="price-row">
                <span>Status</span>
                <strong>@Model.ReservationStatus</strong>
            </div>

            <div class="reference-box">
                <span>Reservation reference</span>
                <strong>@Model.ReservationReference</strong>
            </div>

        </aside>

    </div>

</div>

<style>

    .reservation-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 42px 24px 70px;
    }

    .reservation-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #536dfe;
        text-decoration: none;
        margin-bottom: 22px;
        font-weight: 600;
    }

    .reservation-title {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    .reservation-eyebrow {
        color: #536dfe;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
    }

    .reservation-title h1 {
        font-size: 35px;
        font-weight: 800;
        margin: 5px 0 5px;
    }

    .reservation-title p {
        color: #7d8496;
        margin: 0;
    }

    .reservation-status {
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 800;
    }

        .reservation-status.confirmed {
            background: #e7efff;
            color: #3156d3;
        }

        .reservation-status.completed {
            background: #e6f8ef;
            color: #168a5d;
        }

        .reservation-status.cancelled {
            background: #feecec;
            color: #d44242;
        }

    .reservation-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 22px;
    }

    .reservation-card {
        background: white;
        border: 1px solid #e7e8ef;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(30, 35, 70, .05);
    }

    .main-card {
        padding: 30px;
    }

    .hotel-summary {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 24px;
        border-bottom: 1px solid #ececf2;
    }

    .hotel-summary-icon {
        width: 55px;
        height: 55px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: #eef1ff;
        color: #536dfe;
        font-size: 24px;
    }

    .hotel-summary span {
        color: #8a90a1;
        font-size: 12px;
    }

    .hotel-summary h2 {
        margin: 2px 0;
        font-size: 24px;
    }

    .hotel-summary p {
        margin: 0;
        color: #72798b;
    }

    .stay-date-grid {
        display: grid;
        grid-template-columns: 1fr 40px 1fr;
        gap: 14px;
        align-items: center;
        margin: 28px 0;
    }

    .stay-box {
        background: #f8f9fd;
        padding: 18px;
        border-radius: 13px;
    }

        .stay-box i {
            display: block;
            color: #536dfe;
            margin-bottom: 7px;
        }

        .stay-box span,
        .stay-box strong,
        .stay-box small {
            display: block;
        }

        .stay-box span {
            color: #8b90a0;
            font-size: 12px;
        }

        .stay-box strong {
            margin: 4px 0;
        }

    .stay-arrow {
        text-align: center;
        color: #9ca2b3;
    }

    .reservation-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid #ececf2;
        border-bottom: 1px solid #ececf2;
    }

        .reservation-info-grid > div {
            padding: 20px 12px;
        }

        .reservation-info-grid span,
        .reservation-info-grid strong {
            display: block;
        }

        .reservation-info-grid span {
            color: #8a90a1;
            font-size: 12px;
            margin-bottom: 5px;
        }

    .reservation-actions {
        margin-top: 25px;
    }

    .cancel-reservation-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 11px 16px;
        border: 1px solid #ff5c66;
        color: #e44c56;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 700;
    }

        .cancel-reservation-btn:hover {
            background: #ff5c66;
            color: white;
        }

    .price-card {
        padding: 26px;
        height: fit-content;
        position: sticky;
        top: 100px;
    }

    .price-label {
        color: #7f8496;
        font-size: 13px;
    }

    .price-card h2 {
        font-size: 31px;
        margin: 8px 0;
        color: #26355d;
    }

    .price-divider {
        height: 1px;
        background: #ececf2;
        margin: 20px 0;
    }

    .price-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 13px;
    }

    .reference-box {
        margin-top: 20px;
        padding: 15px;
        background: #f4f6ff;
        border-radius: 10px;
    }

        .reference-box span,
        .reference-box strong {
            display: block;
        }

        .reference-box span {
            color: #7d8495;
            font-size: 11px;
            margin-bottom: 3px;
        }

    @@media (max-width: 850px) {
        .reservation-grid {
            grid-template-columns: 1fr;
        }

        .reservation-info-grid {
            grid-template-columns: 1fr;
        }

        .price-card {
            position: static;
        }
    }

</style>