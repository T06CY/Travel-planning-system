@model TravelPlanningSystem.Models.HotelReservation
@{ ViewData["Title"] = "Reservation details"; }
<div class="container py-5"><a asp-action="MyReservations">← My reservations</a><h1 class="mt-3">Reservation @Model.ReservationReference</h1><div class="card p-4"><span class="badge text-bg-secondary align-self-start">@Model.ReservationStatus</span><h3>@Model.HotelRoom?.HotelName</h3><p>@Model.HotelRoom?.RoomName</p><dl class="row"><dt class="col-sm-3">Stay</dt><dd class="col-sm-9">@Model.CheckInDate.ToString("dd MMM yyyy") – @Model.CheckOutDate.ToString("dd MMM yyyy")</dd><dt class="col-sm-3">Guests</dt><dd class="col-sm-9">@Model.GuestCount</dd><dt class="col-sm-3">Total</dt><dd class="col-sm-9">RM @Model.TotalAmount.ToString("N2")</dd></dl>@if(Model.ReservationStatus == TravelPlanningSystem.Models.HotelReservationStatus.Confirmed && Model.CheckInDate>DateTime.Today){<a asp-action="Cancel" asp-route-id="@Model.HotelReservationId" class="btn btn-outline-danger align-self-start">Cancel reservation</a>}@if(Model.ReservationStatus == TravelPlanningSystem.Models.HotelReservationStatus.Completed){<a asp-action="Review" asp-route-reservationId="@Model.HotelReservationId" class="btn btn-primary align-self-start">@(Model.Review is null ? "Write review" : "Edit review")</a>}</div></div>
