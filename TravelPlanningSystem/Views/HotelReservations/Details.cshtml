@model TravelPlanningSystem.Models.HotelReservation

@{
    ViewData["Title"] = "Reservation Details";
}

<div class="reservation-page-wrapper">
    <!-- Decorative background header -->
    <div class="page-header-bg"></div>

    <div class="reservation-container">

        <a asp-action="MyReservations" class="reservation-back">
            <i class="bi bi-arrow-left"></i>
            Back to Reservations
        </a>

        <div class="reservation-header">
            <div class="header-content">
                <span class="reservation-eyebrow">HOTEL RESERVATION</span>
                <h1>@Model.ReservationReference</h1>
                <p>Manage your stay details and view your booking information.</p>
            </div>
            <div class="header-status">
                <span class="status-badge status-@Model.ReservationStatus.ToString().ToLower()">
                    <span class="status-dot"></span>
                    @Model.ReservationStatus
                </span>
            </div>
        </div>

        <div class="reservation-grid">

            <!-- MAIN TICKET CARD -->
            <div class="card ticket-card">

                <div class="ticket-section hotel-info">
                    <div class="hotel-icon">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="hotel-details">
                        <span class="label">Your Destination</span>
                        <h2>@Model.HotelRoom?.HotelName</h2>
                        <p>@Model.HotelRoom?.RoomName</p>
                    </div>
                </div>

                <div class="ticket-section date-grid">
                    <div class="date-box">
                        <i class="bi bi-calendar2-check text-primary"></i>
                        <span class="label">Check-in</span>
                        <strong>@Model.CheckInDate.ToString("dd MMM yyyy")</strong>
                        <small>@Model.CheckInTime</small>
                    </div>

                    <div class="date-divider">
                        <div class="line"></div>
                        <i class="bi bi-moon-stars text-muted"></i>
                        <div class="line"></div>
                    </div>

                    <div class="date-box">
                        <i class="bi bi-calendar2-x text-danger"></i>
                        <span class="label">Check-out</span>
                        <strong>@Model.CheckOutDate.ToString("dd MMM yyyy")</strong>
                        <small>@Model.CheckOutTime</small>
                    </div>
                </div>

                <div class="ticket-section amenities-grid">
                    <div class="amenity">
                        <i class="bi bi-people"></i>
                        <div>
                            <span class="label">Guests</span>
                            <strong>@Model.GuestCount</strong>
                        </div>
                    </div>
                    <div class="amenity">
                        <i class="bi bi-door-open"></i>
                        <div>
                            <span class="label">Room Type</span>
                            <strong>@Model.HotelRoom?.RoomType</strong>
                        </div>
                    </div>
                    <div class="amenity">
                        <i class="bi bi-geo-alt"></i>
                        <div>
                            <span class="label">Location</span>
                            <strong>@Model.HotelRoom?.Destination</strong>
                        </div>
                    </div>
                </div>

                <!-- ACTIONS -->
                @if (Model.ReservationStatus == TravelPlanningSystem.Models.HotelReservationStatus.Confirmed ||
                     Model.ReservationStatus == TravelPlanningSystem.Models.HotelReservationStatus.Pending)
                {
                    <div class="ticket-section action-section">
                        @if (Model.ReservationStatus == TravelPlanningSystem.Models.HotelReservationStatus.Pending)
                        {
                            <a asp-action="Payment" asp-route-id="@Model.HotelReservationId" class="btn btn-primary">
                                <i class="bi bi-credit-card"></i> Pay Now
                            </a>
                        }
                        <a asp-action="Cancel" asp-route-id="@Model.HotelReservationId" class="btn btn-outline-danger">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    </div>
                }
                else if (Model.ReservationStatus == TravelPlanningSystem.Models.HotelReservationStatus.Completed)
                {
                    <div class="ticket-section action-section">
                        <a asp-action="Review" asp-route-reservationId="@Model.HotelReservationId" class="btn btn-warning">
                            <i class="bi bi-star-fill"></i> @(Model.Review is null ? "Write a Review" : "Edit Review")
                        </a>
                    </div>
                }

                <!-- BARCODE (Only if confirmed/completed) -->
                @if (Model.ReservationStatus == TravelPlanningSystem.Models.HotelReservationStatus.Confirmed ||
                     Model.ReservationStatus == TravelPlanningSystem.Models.HotelReservationStatus.Completed)
                {
                    <div class="ticket-cutout"></div>
                    <div class="ticket-section barcode-section">
                        <span class="label">Scan at Front Desk</span>
                        <svg id="bookingBarcode" role="img" aria-label="Barcode for reservation @Model.ReservationReference"></svg>
                        <strong class="barcode-text">@Model.ReservationReference</strong>
                    </div>

                    <script>
                                        (() => {
                                            const svg = document.getElementById('bookingBarcode');
                                            if (!svg) return;
                                            const value = '@Model.ReservationReference';
                                            const pattern = `101${Array.from(value).flatMap(char =>
                                                (char.charCodeAt(0) % 2 ? '1101001' : '1011011').split('')).join('')}101`;
                                            let x = 4;
                                            for (const bit of pattern) {
                                                if (bit === '1') {
                                                    const bar = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                                                    bar.setAttribute('x', x);
                                                    bar.setAttribute('y', 4);
                                                    bar.setAttribute('width', 2);
                                                    bar.setAttribute('height', 50);
                                                    bar.setAttribute('fill', '#1a1f36');
                                                    svg.appendChild(bar);
                                                }
                                                x += 2;
                                            }
                                            svg.setAttribute('viewBox', `0 0 ${x + 4} 58`);
                                        })();
                    </script>
                }
            </div>

            <!-- PRICE SUMMARY CARD -->
            <div class="side-column">
                <div class="card price-card">
                    <div class="price-header">
                        <span class="label">Total Amount</span>
                        <h2 class="total-price">RM @Model.TotalAmount.ToString("N2")</h2>
                    </div>

                    <div class="receipt-lines">
                        <div class="receipt-row">
                            <span class="text-muted">Price per night</span>
                            <strong>RM @Model.PricePerNight.ToString("N2")</strong>
                        </div>
                        <div class="receipt-row">
                            <span class="text-muted">Reservation Status</span>
                            <strong>@Model.ReservationStatus</strong>
                        </div>
                        <div class="receipt-row">
                            <span class="text-muted">Payment Status</span>
                            <span class="badge @(Model.PaymentStatus == "Paid" ? "badge-success" : "badge-warning")">
                                @Model.PaymentStatus
                            </span>
                        </div>
                        @if (Model.PaymentStatus == "Paid")
                        {
                            <div class="receipt-row">
                                <span class="text-muted">Payment Method</span>
                                <strong>@Model.PaymentMethod</strong>
                            </div>
                        }
                    </div>

                    <div class="reference-box mt-4">
                        <i class="bi bi-shield-check"></i>
                        <div>
                            <span class="label">Secure Booking ID</span>
                            <strong>@Model.ReservationReference</strong>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Base Variables & Setup */
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg-color: #f3f4f6;
        --card-bg: #ffffff;
        --text-main: #111827;
        --text-muted: #6b7280;
        --border-color: #e5e7eb;
        --radius: 20px;
        --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
    }

    .reservation-page-wrapper {
        position: relative;
        min-height: 100vh;
        background-color: var(--bg-color);
        padding-bottom: 80px;
        font-family: system-ui, -apple-system, sans-serif;
    }

    /* Overlapping Header Design */
    .page-header-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 320px;
        background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%);
        z-index: 0;
        border-bottom-left-radius: 40px;
        border-bottom-right-radius: 40px;
    }

    .reservation-container {
        position: relative;
        z-index: 1;
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px;
    }

    /* Typography & Utilities */
    .label {
        display: block;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        font-weight: 600;
        margin-bottom: 4px;
    }

    .text-primary {
        color: var(--primary) !important;
    }

    .text-danger {
        color: #ef4444 !important;
    }

    .text-muted {
        color: var(--text-muted) !important;
    }

    /* Header Section */
    .reservation-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 30px;
        transition: color 0.2s;
    }

        .reservation-back:hover {
            color: #fff;
        }

    .reservation-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 40px;
        color: white;
    }

    .reservation-eyebrow {
        color: #a5b4fc;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .reservation-header h1 {
        font-size: 40px;
        font-weight: 800;
        margin: 8px 0;
        letter-spacing: -1px;
    }

    .reservation-header p {
        color: #c7d2fe;
        margin: 0;
        font-size: 16px;
    }

    /* Status Badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 30px;
        font-weight: 700;
        font-size: 14px;
        text-transform: capitalize;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .status-confirmed .status-dot {
        background: #34d399;
        box-shadow: 0 0 10px #34d399;
    }

    .status-completed .status-dot {
        background: #60a5fa;
        box-shadow: 0 0 10px #60a5fa;
    }

    .status-cancelled .status-dot {
        background: #f87171;
        box-shadow: 0 0 10px #f87171;
    }

    /* Layout */
    .reservation-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 30px;
        align-items: start;
    }

    .card {
        background: var(--card-bg);
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    /* Ticket Card Styling */
    .ticket-card {
        display: flex;
        flex-direction: column;
    }

    .ticket-section {
        padding: 32px;
        border-bottom: 1px dashed var(--border-color);
    }

        .ticket-section:last-child {
            border-bottom: none;
        }

    .hotel-info {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .hotel-icon {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        background: #eef2ff;
        color: var(--primary);
        font-size: 28px;
        display: grid;
        place-items: center;
    }

    .hotel-details h2 {
        margin: 0 0 4px;
        font-size: 24px;
        color: var(--text-main);
        font-weight: 700;
    }

    .hotel-details p {
        margin: 0;
        color: var(--text-muted);
        font-size: 15px;
    }

    .date-grid {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f9fafb;
    }

    .date-box {
        flex: 1;
    }

        .date-box i {
            font-size: 24px;
            margin-bottom: 12px;
            display: block;
        }

        .date-box strong {
            display: block;
            font-size: 18px;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .date-box small {
            color: var(--text-muted);
            font-size: 14px;
        }

    .date-divider {
        display: flex;
        align-items: center;
        gap: 15px;
        flex: 1;
        justify-content: center;
    }

        .date-divider .line {
            height: 2px;
            width: 40px;
            background: var(--border-color);
        }

    .amenities-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .amenity {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

        .amenity i {
            font-size: 20px;
            color: #9ca3af;
        }

        .amenity strong {
            display: block;
            color: var(--text-main);
            font-size: 15px;
            margin-top: 2px;
        }

    /* Action Buttons */
    .action-section {
        display: flex;
        gap: 15px;
        background: #f9fafb;
    }

    .btn {
        flex: 1;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding: 14px 24px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }

        .btn-primary:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
        }

    .btn-outline-danger {
        background: transparent;
        border: 2px solid #fee2e2;
        color: #ef4444;
    }

        .btn-outline-danger:hover {
            background: #fef2f2;
            border-color: #f87171;
        }

    .btn-warning {
        background: #f59e0b;
        color: white;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
    }

        .btn-warning:hover {
            background: #d97706;
            transform: translateY(-2px);
        }

    /* Barcode Section with Cutout Effect */
    .ticket-cutout {
        height: 30px;
        background: radial-gradient(circle at 0 15px, transparent 15px, var(--card-bg) 16px) left, radial-gradient(circle at 100% 15px, transparent 15px, var(--card-bg) 16px) right;
        background-size: 51% 100%;
        background-repeat: no-repeat;
        border-top: 1px dashed var(--border-color);
        margin-top: -1px;
    }

    .barcode-section {
        text-align: center;
        padding-top: 10px;
        padding-bottom: 40px;
    }

    #bookingBarcode {
        width: 100%;
        max-width: 300px;
        height: auto;
        margin: 15px auto;
        display: block;
    }

    .barcode-text {
        font-family: monospace;
        font-size: 18px;
        letter-spacing: 4px;
        color: var(--text-main);
    }

    /* Price Card Sidebar */
    .price-card {
        padding: 32px;
        position: sticky;
        top: 30px;
    }

    .price-header {
        margin-bottom: 30px;
    }

    .total-price {
        font-size: 36px;
        font-weight: 800;
        color: var(--primary);
        margin: 5px 0 0;
    }

    .receipt-lines {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--border-color);
    }

    .receipt-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 15px;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .badge-success {
        background: #d1fae5;
        color: #059669;
    }

    .badge-warning {
        background: #fef3c7;
        color: #d97706;
    }

    .reference-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .reference-box i {
            font-size: 24px;
            color: #64748b;
        }

        .reference-box strong {
            font-family: monospace;
            font-size: 16px;
            color: var(--text-main);
        }

    /* Responsive */
    @@media (max-width: 900px) {
        .reservation-grid {
            grid-template-columns: 1fr;
        }

        .page-header-bg {
            height: 280px;
        }

        .reservation-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .amenities-grid {
            grid-template-columns: 1fr;
        }

        .date-grid {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }

        .date-divider {
            transform: rotate(90deg);
            margin: 20px 0;
        }

        .action-section {
            flex-direction: column;
        }
    }
</style>