@model TravelPlanningSystem.ViewModels.HotelReviewViewModel

@{
    ViewData["Title"] = "Hotel Review";
}

<div class="review-page">
    <div class="review-card">
        <a asp-action="MyReservations" class="review-back"><i class="bi bi-arrow-left"></i> My Reservations</a>
        <div class="review-icon"><i class="bi bi-star-fill"></i></div>
        <h1>@(string.IsNullOrWhiteSpace(Model.RoomName) ? "Review your stay" : $"Review {Model.RoomName}")</h1>
        <p class="review-subtitle">Share your experience to help other travelers.</p>

        <form asp-action="Review" method="post">
            <input asp-for="HotelReservationId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-4">
                <label asp-for="Rating" class="review-label">Your rating</label>
                <select asp-for="Rating" class="form-select review-input">
                    @for (var i = 5; i >= 1; i--)
                    {
                        <option value="@i">@i star@(i > 1 ? "s" : "")</option>
                    }
                </select>
                <span asp-validation-for="Rating" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Comment" class="review-label">Your review</label>
                <textarea asp-for="Comment" class="form-control review-input" rows="6" placeholder="What did you like about your stay?"></textarea>
                <span asp-validation-for="Comment" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn review-submit w-100">Save review <i class="bi bi-arrow-right ms-1"></i></button>
        </form>
    </div>
</div>

<style>
    .review-page { min-height: calc(100vh - 80px); display: grid; place-items: center; padding: 48px 16px; background: #f7f8fb; }
    .review-card { width: min(100%, 560px); padding: 36px; border: 1px solid #e6e9ef; border-radius: 22px; background: #fff; box-shadow: 0 14px 38px rgba(31, 45, 72, .08); }
    .review-back { display: inline-flex; align-items: center; gap: 7px; margin-bottom: 24px; color: #536dfe; font-weight: 700; text-decoration: none; }
    .review-icon { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 18px; border-radius: 16px; background: #fff4d9; color: #f0a400; font-size: 23px; }
    .review-card h1 { margin: 0; color: #1d2940; font-size: 28px; font-weight: 800; }
    .review-subtitle { margin: 8px 0 28px; color: #7a8799; }
    .review-label { margin-bottom: 8px; color: #344054; font-size: 13px; font-weight: 700; }
    .review-input { border-color: #e1e6ee; border-radius: 11px; }
    .review-input:focus { border-color: #536dfe; box-shadow: 0 0 0 4px rgba(83, 109, 254, .12); }
    .review-submit { min-height: 48px; border: 0; border-radius: 11px; background: #536dfe; color: #fff; font-weight: 700; }
    .review-submit:hover { background: #4055d6; color: #fff; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
