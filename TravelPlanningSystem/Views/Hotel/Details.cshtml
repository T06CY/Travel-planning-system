@model TravelPlanningSystem.Models.HotelRoom
@{ ViewData["Title"] = Model.RoomName; var photo = Model.Photos.FirstOrDefault(p => p.IsPrimary)?.PhotoUrl ?? Model.Photos.FirstOrDefault()?.PhotoUrl ?? "/images/hero-beach.jpg"; var rating = Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0; }
<link rel="stylesheet" href="~/css/hotels.css" /><section class="activity-detail-page"><div class="container"><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> All hotels</a><div class="detail-hero"><img src="@photo" alt="@Model.RoomName" /><div><span class="eyebrow">@Model.StarRating-star hotel</span><h1>@Model.HotelName</h1><h3>@Model.RoomName</h3><p><i class="bi bi-geo-alt"></i> @Model.Address, @Model.Destination</p><p>@Model.Description</p><p><i class="bi bi-people"></i> Sleeps up to @Model.Capacity &nbsp; <i class="bi bi-star-fill"></i> @(rating > 0 ? rating.ToString("0.0") : "New")</p><h3>RM @Model.PricePerNight.ToString("N2") <small>/ night</small></h3><a asp-controller="HotelReservations" asp-action="Create" asp-route-roomId="@Model.HotelRoomId" class="btn btn-confirm-booking">Reserve this room</a></div></div><div class="detail-panel"><h3>Amenities</h3><p>@(string.IsNullOrWhiteSpace(Model.Amenities) ? "Contact the hotel for amenity details." : Model.Amenities)</p></div><div class="detail-panel"><h3>Guest reviews</h3>@if(!Model.Reviews.Any()){<p>No reviews yet.</p>}else{@foreach(var review in Model.Reviews.OrderByDescending(x=>x.CreatedAt)){<div class="review"><strong>@review.Rating <i class="bi bi-star-fill"></i></strong><p>@review.Comment</p><small>@review.CreatedAt.ToString("dd MMM yyyy")</small></div>}}</div></div></section>
