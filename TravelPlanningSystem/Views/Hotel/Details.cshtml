@model TravelPlanningSystem.Models.HotelRoom

@{
    ViewData["Title"] = Model.HotelName;

    var primaryPhoto = Model.Photos?
        .OrderByDescending(p => p.IsPrimary)
        .ThenBy(p => p.DisplayOrder)
        .FirstOrDefault();

    var primaryPhotoUrl =
        primaryPhoto?.PhotoUrl
        ?? "/images/hotels/uploads/no-image.jpg";

    var amenities = string.IsNullOrWhiteSpace(Model.Amenities)
        ? new List<string>()
        : Model.Amenities
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(a => a.Trim())
            .ToList();

    var reviewCount = Model.Reviews?.Count ?? 0;

    var averageRating =
        reviewCount > 0
            ? Model.Reviews!.Average(r => r.Rating)
            : 0;

    var mapQuery = Uri.EscapeDataString($"{Model.Address}, {Model.Destination}");
    var googleMapsUrl = $"https://www.google.com/maps/search/?api=1&query={mapQuery}";
    var googleMapsEmbedUrl = $"https://www.google.com/maps?q={mapQuery}&output=embed";
}

<style>

    /* =========================================================
       PAGE
    ========================================================= */

    .hotel-details-page {
        min-height: calc(100vh - 80px);
        padding: 38px 0 80px;
        background: #f7f8fb;
    }

    .hotel-details-container {
        width: min(1240px, calc(100% - 48px));
        margin: 0 auto;
    }


    /* =========================================================
       BACK LINK
    ========================================================= */

    .hotel-back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 24px;
        color: #ff5964;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none;
    }

        .hotel-back-link:hover {
            color: #e74751;
        }


    /* =========================================================
       MAIN CARD
    ========================================================= */

    .hotel-main-card {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 34px;
        padding: 26px;
        border: 1px solid #e6e9ef;
        border-radius: 24px;
        background: white;
        box-shadow: 0 14px 38px rgba(31, 45, 72, 0.08);
    }


    /* =========================================================
       IMAGE
    ========================================================= */

    .hotel-image-panel {
        position: relative;
        min-height: 470px;
        overflow: hidden;
        border-radius: 20px;
        background: #eef1f5;
    }

        .hotel-image-panel img {
            width: 100%;
            height: 100%;
            min-height: 470px;
            object-fit: cover;
        }

    .hotel-star-badge {
        position: absolute;
        top: 18px;
        left: 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(24, 35, 56, 0.88);
        color: white;
        font-size: 12px;
        font-weight: 800;
        backdrop-filter: blur(8px);
    }

        .hotel-star-badge i {
            color: #ffd85a;
        }


    /* =========================================================
       INFO PANEL
    ========================================================= */

    .hotel-info-panel {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .hotel-category {
        margin-bottom: 8px;
        color: #ff5964;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .hotel-info-panel h1 {
        margin: 0;
        color: #1d2940;
        font-size: 40px;
        font-weight: 800;
        line-height: 1.18;
        letter-spacing: -0.8px;
    }

    .hotel-room-name {
        margin: 8px 0 0;
        color: #25324a;
        font-size: 23px;
        font-weight: 700;
    }


    /* =========================================================
       LOCATION
    ========================================================= */

    .hotel-location {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-top: 16px;
        color: #687386;
        font-size: 14px;
        line-height: 1.6;
    }

        .hotel-location i {
            margin-top: 3px;
            color: #ff5964;
        }

    .hotel-map-card {
        margin-top: 24px;
        overflow: hidden;
        border: 1px solid #e6e9ef;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 10px 28px rgba(31, 45, 72, .06);
    }

    .hotel-map-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
    }

    .hotel-map-header h2 {
        margin: 0;
        color: #1d2940;
        font-size: 19px;
        font-weight: 800;
    }

    .hotel-map-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #ff5964;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .hotel-map-link:hover {
        color: #e74751;
    }

    .hotel-map-frame {
        display: block;
        width: 100%;
        height: 300px;
        border: 0;
    }

    @@media (max-width: 650px) {
        .hotel-map-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }


    /* =========================================================
       DESCRIPTION
    ========================================================= */

    .hotel-description {
        margin-top: 18px;
        color: #667085;
        font-size: 15px;
        line-height: 1.75;
    }


    /* =========================================================
       META
    ========================================================= */

    .hotel-meta {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .hotel-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #647084;
        font-size: 14px;
    }

        .hotel-meta-item i {
            color: #ff5964;
        }


    /* =========================================================
       PRICE AREA
    ========================================================= */

    .hotel-price-box {
        margin-top: 26px;
        padding: 20px;
        border: 1px solid #e7eaf0;
        border-radius: 17px;
        background: #fbfcfe;
    }

    .hotel-price-label {
        display: block;
        color: #8c96a7;
        font-size: 12px;
    }

    .hotel-price {
        margin-top: 3px;
        color: #17233a;
        font-size: 31px;
        font-weight: 800;
    }

        .hotel-price small {
            color: #7f899a;
            font-size: 15px;
            font-weight: 600;
        }


    /* =========================================================
       RESERVE BUTTON
    ========================================================= */

    .reserve-hotel-btn {
        width: 100%;
        min-height: 54px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        margin-top: 15px;
        border: none;
        border-radius: 13px;
        background: linear-gradient( 135deg, #ff5964, #ff666f );
        color: white;
        text-decoration: none;
        font-size: 15px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(255, 89, 100, 0.22);
        transition: 0.2s ease;
    }

        .reserve-hotel-btn:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 16px 32px rgba(255, 89, 100, 0.30);
        }


    /* =========================================================
       SECTION CARDS
    ========================================================= */

    .hotel-detail-card {
        margin-top: 24px;
        padding: 26px;
        border: 1px solid #e6e9ef;
        border-radius: 20px;
        background: white;
        box-shadow: 0 8px 26px rgba(31, 45, 72, 0.04);
    }

    .hotel-section-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .hotel-section-heading-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: #fff0f1;
        color: #ff5964;
        font-size: 17px;
    }

    .hotel-section-heading h2 {
        margin: 0;
        color: #1d2940;
        font-size: 23px;
        font-weight: 800;
    }


    /* =========================================================
       AMENITIES
    ========================================================= */

    .amenities-list {
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
    }

    .amenity-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 14px;
        border: 1px solid #e5e9f0;
        border-radius: 12px;
        background: #f9fafc;
        color: #536074;
        font-size: 13px;
        font-weight: 700;
    }

        .amenity-chip i {
            color: #4059ff;
        }


    /* =========================================================
       REVIEWS SUMMARY
    ========================================================= */

    .review-summary {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 20px;
        padding: 16px;
        border-radius: 14px;
        background: #fafbfe;
    }

    .review-score {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 16px;
        background: #1e2a40;
        color: white;
        font-size: 22px;
        font-weight: 800;
    }

    .review-summary-text strong {
        display: block;
        color: #1d2940;
        font-size: 15px;
    }

    .review-summary-text span {
        color: #8993a4;
        font-size: 13px;
    }


    /* =========================================================
       REVIEWS
    ========================================================= */

    .review-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .review-item {
        padding: 17px;
        border: 1px solid #edf0f4;
        border-radius: 14px;
        background: #fcfdff;
    }

    .review-item-top {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 8px;
    }

    .review-stars {
        color: #ffba38;
    }

    .review-item p {
        margin: 0;
        color: #657084;
        font-size: 14px;
        line-height: 1.7;
    }


    /* =========================================================
       NO REVIEWS
    ========================================================= */

    .no-review {
        padding: 32px;
        border: 1px dashed #dfe4ec;
        border-radius: 15px;
        background: #fafbfc;
        text-align: center;
    }

        .no-review i {
            display: block;
            margin-bottom: 9px;
            color: #c5cbd6;
            font-size: 30px;
        }

        .no-review strong {
            display: block;
            color: #344057;
        }

        .no-review span {
            color: #929baa;
            font-size: 13px;
        }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 900px) {

        .hotel-main-card {
            grid-template-columns: 1fr;
        }

        .hotel-image-panel,
        .hotel-image-panel img {
            min-height: 350px;
        }
    }

    @@media (max-width: 600px) {

        .hotel-details-container {
            width: calc(100% - 28px);
        }

        .hotel-main-card {
            padding: 16px;
        }

        .hotel-info-panel h1 {
            font-size: 31px;
        }

        .hotel-image-panel,
        .hotel-image-panel img {
            min-height: 260px;
        }
    }

</style>


<section class="hotel-details-page">

    <div class="hotel-details-container">


        <!-- BACK -->
        <a asp-controller="Hotel"
           asp-action="Index"
           class="hotel-back-link">

            <i class="bi bi-arrow-left"></i>
            All hotels

        </a>


        <!-- =====================================================
             MAIN HOTEL CARD
        ====================================================== -->
        <div class="hotel-main-card">


            <!-- IMAGE -->
            <div class="hotel-image-panel">

                <img src="@primaryPhotoUrl"
                     alt="@Model.HotelName"
                     onerror="this.src='/images/hotels/uploads/no-image.jpg';" />


                <div class="hotel-star-badge">

                    <i class="bi bi-star-fill"></i>

                    @Model.StarRating Star Hotel

                </div>

            </div>


            <!-- INFORMATION -->
            <div class="hotel-info-panel">


                <div class="hotel-category">

                    @Model.StarRating-STAR HOTEL

                </div>


                <h1>
                    @Model.HotelName
                </h1>


                <div class="hotel-room-name">

                    @Model.RoomName

                </div>


                <div class="hotel-location">

                    <i class="bi bi-geo-alt"></i>

                    <span>
                        @Model.Address, @Model.Destination
                    </span>

                </div>

                <div class="hotel-map-card">
                    <div class="hotel-map-header">
                        <h2><i class="bi bi-map me-2"></i>Hotel location</h2>
                        <a class="hotel-map-link"
                           href="@googleMapsUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            Open in Google Maps <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                    <iframe class="hotel-map-frame"
                            src="@googleMapsEmbedUrl"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            title="Map showing @Model.HotelName">
                    </iframe>
                </div>


                <div class="hotel-description">

                    @Model.Description

                </div>


                <!-- META -->
                <div class="hotel-meta">

                    <div class="hotel-meta-item">

                        <i class="bi bi-people"></i>

                        Sleeps up to @Model.Capacity

                    </div>


                    <div class="hotel-meta-item">

                        <i class="bi bi-door-open"></i>

                        @Model.RoomType

                    </div>


                    <div class="hotel-meta-item">

                        <i class="bi bi-star-fill"></i>

                        @if (reviewCount > 0)
                        {
                            <span>
                                @averageRating.ToString("0.0")
                                (@reviewCount review@(reviewCount == 1 ? "" : "s"))
                            </span>
                        }
                        else
                        {
                            <span>
                                New
                            </span>
                        }

                    </div>

                </div>


                <!-- PRICE -->
                <div class="hotel-price-box">

                    <span class="hotel-price-label">
                        From
                    </span>


                    <div class="hotel-price">

                        RM @Model.PricePerNight.ToString("N2")

                        <small>
                            / night
                        </small>

                    </div>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="HotelReservations"
                           asp-action="Create"
                           asp-route-roomId="@Model.HotelRoomId"
                           class="reserve-hotel-btn">

                            <i class="bi bi-calendar-check"></i>

                            Reserve this room

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           asp-route-returnUrl="@Url.Action("Create", "HotelReservations", new { roomId = Model.HotelRoomId })"
                           class="reserve-hotel-btn">

                            <i class="bi bi-box-arrow-in-right"></i>

                            Login to reserve this room

                        </a>
                    }

                </div>


            </div>


        </div>



        <!-- =====================================================
             AMENITIES
        ====================================================== -->
        <div class="hotel-detail-card">


            <div class="hotel-section-heading">

                <div class="hotel-section-heading-icon">

                    <i class="bi bi-stars"></i>

                </div>


                <h2>
                    Amenities
                </h2>

            </div>


            @if (amenities.Any())
            {
                <div class="amenities-list">

                    @foreach (var amenity in amenities)
                    {

                        <div class="amenity-chip">

                            @if (amenity.Contains("Wi-Fi", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-wifi"></i>
                            }
                            else if (amenity.Contains("Air", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-snow"></i>
                            }
                            else if (amenity.Contains("Breakfast", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-cup-hot"></i>
                            }
                            else if (amenity.Contains("Parking", StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-car-front"></i>
                            }
                            else
                            {
                                <i class="bi bi-check-circle"></i>
                            }

                            @amenity

                        </div>

                    }

                </div>
            }
            else
            {
                <span>
                    No amenities information available.
                </span>
            }


        </div>



        <!-- =====================================================
             REVIEWS
        ====================================================== -->
        <div class="hotel-detail-card">


            <div class="hotel-section-heading">

                <div class="hotel-section-heading-icon">

                    <i class="bi bi-chat-square-heart"></i>

                </div>


                <h2>
                    Guest reviews
                </h2>

            </div>


            @if (reviewCount > 0)
            {

                <!-- SUMMARY -->
                <div class="review-summary">

                    <div class="review-score">

                        @averageRating.ToString("0.0")

                    </div>


                    <div class="review-summary-text">

                        <strong>
                            Guest rating
                        </strong>

                        <span>
                            Based on @reviewCount review@(reviewCount == 1 ? "" : "s")
                        </span>

                    </div>

                </div>


                <!-- REVIEW LIST -->
                <div class="review-list">


                    @foreach (var review in Model.Reviews!)
                    {

                        <div class="review-item">


                            <div class="review-item-top">


                                <strong>
                                    Guest review
                                </strong>


                                <div class="review-stars">

                                    @for (int i = 1; i <= 5; i++)
                                    {

                                        if (i <= review.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }

                                    }

                                </div>


                            </div>


                            <p>
                                @review.Comment
                            </p>


                        </div>

                    }


                </div>

            }
            else
            {

                <div class="no-review">

                    <i class="bi bi-chat-square"></i>

                    <strong>
                        No reviews yet
                    </strong>

                    <span>
                        Be the first guest to review this hotel after your stay.
                    </span>

                </div>

            }


        </div>


    </div>

</section>