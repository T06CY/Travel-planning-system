@model TravelPlanningSystem.ViewModels.HotelSearchViewModel
<div id="hotelTotalCount" data-total="@Model.TotalItems" hidden></div>
@if (!Model.Rooms.Any()) { <div class="empty-state"><i class="bi bi-building-x"></i><h3>No rooms found</h3><p>Try changing your dates or filters.</p></div> } else { <div class="activity-card-grid">@foreach(var room in Model.Rooms) { var photo = room.Photos.FirstOrDefault(p => p.IsPrimary)?.PhotoUrl ?? room.Photos.FirstOrDefault()?.PhotoUrl ?? "/images/hero-beach.jpg"; var rating = room.Reviews.Any() ? room.Reviews.Average(x => x.Rating) : 0; <article class="activity-card"><div class="card-image-wrap"><img src="@photo" alt="@room.RoomName" /><span class="category-badge">@room.StarRating <i class="bi bi-star-fill"></i></span></div><div class="card-body-custom"><div class="location"><i class="bi bi-geo-alt-fill"></i>@room.Destination</div><h3>@room.HotelName</h3><h5>@room.RoomName</h5><p class="description">@room.Description</p><div class="meta-row"><span><i class="bi bi-people"></i> Up to @room.Capacity</span><span><i class="bi bi-star-fill"></i> @(rating > 0 ? rating.ToString("0.0") : "New")</span></div><div class="card-footer-custom"><div class="price"><small>From</small><strong>RM @room.PricePerNight.ToString("N2")</strong><span>/ night</span></div><a asp-action="Details" asp-route-id="@room.HotelRoomId" class="btn btn-view-activity">View room <i class="bi bi-arrow-right"></i></a></div></div></article> }</div><nav class="activity-pagination">@for(var i=1;i<=Model.TotalPages;i++){ if(i==Model.Page){<span class="page-button active">@i</span>}else{<a class="page-button" asp-route-Search="@Model.Search" asp-route-Destination="@Model.Destination" asp-route-CheckIn="@Model.CheckIn" asp-route-CheckOut="@Model.CheckOut" asp-route-Guests="@Model.Guests" asp-route-MaxPrice="@Model.MaxPrice" asp-route-Sort="@Model.Sort" asp-route-Page="@i">@i</a>} }</nav> }
