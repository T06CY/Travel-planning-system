@model TravelPlanningSystem.ViewModels.HotelSearchViewModel
@{ ViewData["Title"] = "Hotels"; }
<link rel="stylesheet" href="~/css/hotels.css" asp-append-version="true" />
<section class="hotel-hero"><div class="container"><span class="eyebrow"><i class="bi bi-buildings"></i> Stay your way</span><h1>Find your perfect <span>hotel room.</span></h1><p>Search room availability, compare stays and reserve in minutes.</p><form id="hotelSearchForm" class="hotel-search-panel" method="get"><div class="search-grid"><div class="field field-wide"><label>Where are you staying?</label><input asp-for="Search" class="form-control" placeholder="Hotel, room or destination" /></div><div class="field"><label asp-for="CheckIn">Check-in</label><input asp-for="CheckIn" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></div><div class="field"><label asp-for="CheckOut">Check-out</label><input asp-for="CheckOut" type="date" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" /></div><button class="btn btn-activity-search"><i class="bi bi-search"></i> Search</button></div></form></div></section>
<section class="activity-section"><div class="container"><div class="content-grid"><aside class="filter-card"><div class="filter-heading"><h5>Filter rooms</h5><button type="button" id="clearFilters" class="btn-link-clean">Clear all</button></div><div class="filter-group"><label>Destination</label><select form="hotelSearchForm" asp-for="Destination" class="form-select auto-filter"><option value="">All destinations</option>@foreach(var destination in Model.Destinations) { <option value="@destination">@destination</option> }</select></div><div class="filter-group"><label asp-for="Guests"></label><input form="hotelSearchForm" asp-for="Guests" type="number" min="1" class="form-control auto-filter" /></div><div class="filter-group"><label>Maximum RM per night</label><input form="hotelSearchForm" asp-for="MaxPrice" class="form-control auto-filter" /></div></aside><div><div class="results-toolbar"><div><span class="results-count">@Model.TotalItems rooms found</span><small>Availability is confirmed before reservation.</small></div><select form="hotelSearchForm" asp-for="Sort" class="form-select auto-filter sort-select"><option value="featured">Recommended</option><option value="price-low">Price: Low to High</option><option value="price-high">Price: High to Low</option><option value="rating">Highest Rated</option><option value="name">Name A–Z</option></select></div><div id="hotelResults"><partial name="_HotelCards" model="Model" /></div></div></div></div></section>
@section Scripts { <script src="~/js/hotel-search.js" asp-append-version="true"></script> }
