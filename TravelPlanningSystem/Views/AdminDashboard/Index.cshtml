@model TravelPlanningSystem.ViewModels.AdminDashboardViewModel
@inject TravelPlanningSystem.Data.AppDbContext DbContext

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="dashboard-page">

    <!-- ===================================================== -->
    <!-- PAGE HEADING                                          -->
    <!-- ===================================================== -->
    <div class="dashboard-heading">
        <div>
            <span class="dashboard-eyebrow">
                TRAVELMATE ADMINISTRATION
            </span>
            <h1>
                TravelMate Admin Dashboard
            </h1>
            <p>
                Manage the Travel Planning System from one central administration dashboard.
            </p>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- USERS & STAFF                                         -->
    <!-- ===================================================== -->
    <div class="section-heading mt-4">
        <div>
            <span class="dashboard-eyebrow">
                USERS &amp; STAFF
            </span>
            <h2>
                Accounts Overview
            </h2>
            <p>
                A quick view of registered customers and staff accounts.
            </p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- RECENT USERS -->
        <div class="col-12 col-xl-6">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-heading">
                    <div>
                        <h3>Recent Users</h3>
                        <p>Latest registered application users.</p>
                    </div>
                </div>

                @if (!Model.Users.Any())
                {
                    <div class="dashboard-empty">
                        <i class="bi bi-people"></i>
                        <h4>No users</h4>
                        <p>There are no registered users yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table dashboard-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Tier</th>
                                    <th>Points</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.Users)
                                {
                                    <tr>
                                        <td>@(u.FirstName) @u.LastName</td>
                                        <td>@u.Email</td>
                                        <td>@u.LoyaltyTier</td>
                                        <td>@u.RewardPoints</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>

        <!-- STAFF USERS -->
        <div class="col-12 col-xl-6">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-heading">
                    <div>
                        <h3>Staff Users</h3>
                        <p>Administrative and support staff accounts.</p>
                    </div>
                </div>

                @if (!Model.StaffUsers.Any())
                {
                    <div class="dashboard-empty">
                        <i class="bi bi-person-badge"></i>
                        <h4>No staff users</h4>
                        <p>There are no staff accounts yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table dashboard-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Access</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.StaffUsers)
                                {
                                    <tr>
                                        <td>@(s.FirstName) @s.LastName</td>
                                        <td>@s.Email</td>
                                        <td>@(s.StaffRole?.RoleName ?? "-")</td>
                                        <td>@s.AccessLevel</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- SYSTEM MANAGEMENT                                     -->
    <!-- ===================================================== -->
    <div class="dashboard-panel mb-4">
        <div class="dashboard-panel-heading">
            <div>
                <h3>System Management</h3>
                <p>Manage the different travel services in the TravelMate system.</p>
            </div>
        </div>

        <div class="team-module-grid">
            <!-- FLIGHT -->
            <a asp-controller="AdminFlights" asp-action="Index" class="team-module-card text-decoration-none">
                <div class="team-module-icon flight-module">
                    <i class="bi bi-airplane"></i>
                </div>
                <div>
                    <strong>Flight Management</strong>
                    <span>Flight management and bookings</span>
                </div>
            </a>

            <!-- HOTEL -->
            <a asp-controller="AdminRooms" asp-action="Index" class="team-module-card text-decoration-none">
                <div class="team-module-icon hotel-module">
                    <i class="bi bi-building"></i>
                </div>
                <div>
                    <strong>Hotel Reservation</strong>
                    <span>Rooms and hotel reservations</span>
                </div>
            </a>

            <!-- TRANSPORTATION (已激活) -->
            <a asp-controller="AdminTransportation" asp-action="Index" class="team-module-card text-decoration-none">
                <div class="team-module-icon transport-module">
                    <i class="bi bi-bus-front"></i>
                </div>
                <div>
                    <strong>Transportation Operations</strong>
                    <span>Fleet management, routes & schedules</span>
                </div>
                <span class="active-module-badge">Active</span>
            </a>

            <!-- ACTIVITIES -->
            <a asp-controller="AdminActivities" asp-action="Index" class="team-module-card activity-module-card">
                <div class="team-module-icon activity-module">
                    <i class="bi bi-ticket-perforated"></i>
                </div>
                <div>
                    <strong>Activities</strong>
                    <span>Activity catalog, booking and maintenance</span>
                </div>
                <span class="active-module-badge">Active</span>
            </a>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- ⭐ TRANSPORTATION MANAGEMENT (交通专属统计总览板块)  -->
    <!-- ===================================================== -->
    @{
        var transRoutesCount = DbContext.Routes.Count(r => r.IsActive);
        var transVehiclesCount = DbContext.Vehicles.Count(v => v.IsActive);
        var transTripsCount = DbContext.Trips.Count(t => t.IsActive);
        var transBookingsCount = DbContext.TransportationBookings.Count();
        var transRevenue = DbContext.TransportationBookings.Where(b => b.BookingStatus == "Confirmed").Sum(b => (decimal?)b.TotalAmount) ?? 0m;

        var transConfirmed = DbContext.TransportationBookings.Count(b => b.BookingStatus == "Confirmed");
        var transCancelled = DbContext.TransportationBookings.Count(b => b.BookingStatus == "Cancelled");
        var recentTransBookings = DbContext.TransportationBookings
            .OrderByDescending(b => b.BookingDate)
            .Take(5)
            .ToList();
    }

    <div class="section-heading mt-5">
        <div>
            <span class="dashboard-eyebrow">
                TRANSPORTATION MANAGEMENT
            </span>
            <h2>
                Transportation Overview
            </h2>
            <p>
                Current statistics for vehicle fleet, intercity routes, schedules and ticket reservations.
            </p>
        </div>
        <a asp-controller="AdminTransportation" asp-action="Index" class="dashboard-add-button">
            <i class="bi bi-speedometer2"></i>
            Manage Operations
        </a>
    </div>

    <!-- 4 大交通运营 KPI 指标卡片 -->
    <div class="dashboard-stat-grid">
        <div class="dashboard-stat-card stat-blue">
            <div>
                <span>Active Routes</span>
                <h2>@transRoutesCount</h2>
                <small>@transVehiclesCount active fleet vehicles</small>
            </div>
            <div class="stat-icon">
                <i class="bi bi-signpost-split"></i>
            </div>
        </div>

        <div class="dashboard-stat-card stat-green">
            <div>
                <span>Scheduled Trips</span>
                <h2>@transTripsCount</h2>
                <small>Published departures</small>
            </div>
            <div class="stat-icon">
                <i class="bi bi-calendar-week"></i>
            </div>
        </div>

        <div class="dashboard-stat-card stat-pink">
            <div>
                <span>Total Bookings</span>
                <h2>@transBookingsCount</h2>
                <small>Tickets issued</small>
            </div>
            <div class="stat-icon">
                <i class="bi bi-ticket-perforated"></i>
            </div>
        </div>

        <div class="dashboard-stat-card stat-purple">
            <div>
                <span>Total Revenue</span>
                <h2>RM @transRevenue.ToString("N2")</h2>
                <small>Excluding cancelled tickets</small>
            </div>
            <div class="stat-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
        </div>
    </div>

    <!-- 交通状态徽章 -->
    <div class="booking-status-grid mb-4">
        <div class="booking-status-card">
            <div class="booking-status-icon confirmed-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <span>Confirmed</span>
                <strong>@transConfirmed</strong>
            </div>
        </div>
        <div class="booking-status-card">
            <div class="booking-status-icon cancelled-icon">
                <i class="bi bi-x-circle"></i>
            </div>
            <div>
                <span>Cancelled / Refunded</span>
                <strong>@transCancelled</strong>
            </div>
        </div>
    </div>

    <!-- 最新交通预订列表 -->
    <section class="dashboard-panel mb-5">
        <div class="dashboard-panel-heading">
            <div>
                <h3>Recent Transportation Bookings</h3>
                <p>Latest customer bus and coach reservations.</p>
            </div>
            <a asp-controller="AdminTransportation" asp-action="Index">
                View All in Operations Hub <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (!recentTransBookings.Any())
        {
            <div class="dashboard-empty">
                <i class="bi bi-ticket-detailed"></i>
                <h4>No transportation bookings yet</h4>
                <p>Transportation bookings will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table dashboard-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Customer</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in recentTransBookings)
                        {
                            <tr>
                                <td>
                                    <strong>@b.BookingReference</strong><br />
                                    <small class="text-muted">@b.BookingDate.ToString("dd MMM yyyy, HH:mm")</small>
                                </td>
                                <td>
                                    <strong>@b.ContactName</strong><br />
                                    <small class="text-muted">@b.ContactEmail</small>
                                </td>
                                <td><strong>RM @b.TotalAmount.ToString("N2")</strong></td>
                                <td>
                                    <span class="status-pill status-@b.BookingStatus.ToLower()">
                                        @b.BookingStatus
                                    </span>
                                </td>
                                <td>@b.PaymentMethod</td>
                                <td>
                                    <a asp-controller="Transportation" asp-action="Confirmation" asp-route-id="@b.BookingId" target="_blank" class="dashboard-view-button" title="View E-Ticket">
                                        <i class="bi bi-qr-code"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- ===================================================== -->
    <!-- FLIGHT MANAGEMENT                                     -->
    <!-- ===================================================== -->
    <div class="section-heading mt-5">
        <div>
            <span class="dashboard-eyebrow">
                FLIGHT MANAGEMENT
            </span>
            <h2>
                Flight Overview
            </h2>
            <p>
                Current statistics for flights and flight bookings.
            </p>
        </div>
        <a asp-controller="AdminFlights" asp-action="Index" class="dashboard-add-button">
            <i class="bi bi-sliders"></i>
            Manage Flights
        </a>
    </div>

    <div class="dashboard-stat-grid">
        <div class="dashboard-stat-card stat-blue">
            <div>
                <span>Total Flights</span>
                <h2>@Model.TotalFlights</h2>
                <small>@Model.ActiveFlights active flights</small>
            </div>
            <div class="stat-icon"><i class="bi bi-airplane"></i></div>
        </div>
        <div class="dashboard-stat-card stat-green">
            <div>
                <span>Flight Bookings</span>
                <h2>@Model.FlightBookings</h2>
                <small>All flight reservations</small>
            </div>
            <div class="stat-icon"><i class="bi bi-calendar-check"></i></div>
        </div>
        <div class="dashboard-stat-card stat-purple">
            <div>
                <span>Flight Revenue</span>
                <h2>RM @Model.FlightRevenue.ToString("N2")</h2>
                <small>Excluding cancelled bookings</small>
            </div>
            <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
        </div>
        <div class="dashboard-stat-card stat-pink">
            <div>
                <span>Seats Reserved</span>
                <h2>@Model.ReservedFlightSeats</h2>
                <small>Passenger seats assigned</small>
            </div>
            <div class="stat-icon"><i class="bi bi-person-check"></i></div>
        </div>
    </div>

    <section class="dashboard-panel flight-analytics-panel">
        <div class="dashboard-panel-heading">
            <div>
                <h3>Flight analytics</h3>
                <p>Demand, capacity and schedule analysis for the local booking inventory.</p>
            </div>
            <a asp-controller="AdminFlights" asp-action="Index">View flights <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="flight-analytics-kpis">
            <div><span>Average price</span><strong>RM @Model.AverageFlightPrice.ToString("N2")</strong></div>
            <div><span>Available seats</span><strong>@Model.AvailableFlightSeats / @Model.FlightSeatCapacity</strong></div>
            <div><span>Delayed flights</span><strong>@Model.DelayedFlights</strong></div>
            <div><span>Cancelled flights</span><strong>@Model.CancelledFlights</strong></div>
        </div>
        <div class="flight-analytics-columns">
            <div>
                <h4>Flights by airline</h4>
                @if (!Model.FlightsByAirline.Any())
                {
                    <p class="analytics-empty">No active flight data yet.</p>
                }
                @foreach (var item in Model.FlightsByAirline)
                {
                    <div class="analytics-bar-row">
                        <span>@item.Label</span><strong>@item.Count <small>(@item.Percentage%)</small></strong>
                        <div><i style="width:@item.Percentage%"></i></div>
                    </div>
                }
            </div>
            <div>
                <h4>Top routes</h4>
                @if (!Model.FlightsByRoute.Any())
                {
                    <p class="analytics-empty">Routes appear after customers search or book flights.</p>
                }
                @foreach (var item in Model.FlightsByRoute)
                {
                    <div class="analytics-route-row"><span>@item.Label</span><strong>@item.Count</strong></div>
                }
            </div>
        </div>
        @{
            var cabinReservedTotal = Model.SeatsByCabin.Sum(item => item.Reserved);
            var cabinColors = new[] { "#315ff4", "#e4a514", "#8a5bd6" };
            var cabinGradient = cabinReservedTotal == 0
                ? "conic-gradient(#e7edf6 0 100%)"
                : $"conic-gradient({cabinColors[0]} 0 {Model.SeatsByCabin[0].Reserved * 100m / cabinReservedTotal:0.##}%, {cabinColors[1]} {Model.SeatsByCabin[0].Reserved * 100m / cabinReservedTotal:0.##}% {(Model.SeatsByCabin[0].Reserved + Model.SeatsByCabin[1].Reserved) * 100m / cabinReservedTotal:0.##}%, {cabinColors[2]} {(Model.SeatsByCabin[0].Reserved + Model.SeatsByCabin[1].Reserved) * 100m / cabinReservedTotal:0.##}% 100%)";
        }
        <div class="flight-cabin-report">
            <div class="flight-cabin-report-heading">
                <div><h4>Seat demand by cabin</h4><p>Reserved seats across active flights.</p></div>
                <span class="flight-report-total">@cabinReservedTotal reserved</span>
            </div>
            <div class="flight-cabin-report-body">
                <div class="flight-cabin-pie" style="background:@cabinGradient" role="img" aria-label="Reserved seats by cabin"></div>
                <div class="flight-cabin-legend">
                    @for (var cabinIndex = 0; cabinIndex < Model.SeatsByCabin.Count; cabinIndex++)
                    {
                        var cabin = Model.SeatsByCabin[cabinIndex];
                        var cabinPercent = cabinReservedTotal == 0 ? 0 : Math.Round(cabin.Reserved * 100m / cabinReservedTotal, 1);
                        <div class="flight-cabin-legend-row"><span><i style="background:@cabinColors[cabinIndex]"></i>@cabin.Label</span><strong>@cabin.Reserved <small>(@cabinPercent%)</small></strong><em>@cabin.Available available</em></div>
                    }
                </div>
            </div>
            <small class="flight-report-note">Capacity is split by cabin using the aircraft seat layout. Cancelled bookings are excluded.</small>
        </div>
    </section>

    <div class="booking-status-grid mb-4">
        <a asp-controller="AdminFlightBookings" asp-action="Index" asp-route-status="Pending" class="booking-status-card">
            <div class="booking-status-icon pending-icon"><i class="bi bi-hourglass-split"></i></div>
            <div><span>Pending</span><strong>@Model.FlightPendingBookings</strong></div>
        </a>
        <a asp-controller="AdminFlightBookings" asp-action="Index" asp-route-status="Confirmed" class="booking-status-card">
            <div class="booking-status-icon confirmed-icon"><i class="bi bi-check-circle"></i></div>
            <div><span>Confirmed</span><strong>@Model.FlightConfirmedBookings</strong></div>
        </a>
        <a asp-controller="AdminFlightBookings" asp-action="Index" asp-route-status="Completed" class="booking-status-card">
            <div class="booking-status-icon completed-icon"><i class="bi bi-check2-all"></i></div>
            <div><span>Completed</span><strong>@Model.FlightCompletedBookings</strong></div>
        </a>
        <a asp-controller="AdminFlightBookings" asp-action="Index" asp-route-status="Cancelled" class="booking-status-card">
            <div class="booking-status-icon cancelled-icon"><i class="bi bi-x-circle"></i></div>
            <div><span>Cancelled</span><strong>@Model.FlightCancelledBookings</strong></div>
        </a>
    </div>

    <section class="dashboard-panel mb-5">
        <div class="dashboard-panel-heading">
            <div>
                <h3>Recent Flight Bookings</h3>
                <p>Latest customer flight reservations.</p>
            </div>
            <a asp-controller="AdminFlightBookings" asp-action="Index">View All <i class="bi bi-arrow-right"></i></a>
        </div>
        @if (!Model.RecentFlightBookings.Any())
        {
            <div class="dashboard-empty">
                <i class="bi bi-airplane"></i>
                <h4>No flight bookings yet</h4>
                <p>Flight bookings will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table dashboard-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Customer</th>
                            <th>Route</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.RecentFlightBookings)
                        {
                            var firstFlight = booking.Segments.OrderBy(s => s.SegmentOrder).FirstOrDefault()?.Flight;
                            var lastFlight = booking.Segments.OrderBy(s => s.SegmentOrder).LastOrDefault()?.Flight;
                            <tr>
                                <td><strong>@booking.BookingReference</strong><br /><small>@booking.BookingDate.ToString("dd MMM yyyy")</small></td>
                                <td><strong>@booking.ContactName</strong><br /><small>@booking.ContactEmail</small></td>
                                <td>@firstFlight?.From → @lastFlight?.To</td>
                                <td><strong>RM @booking.TotalAmount.ToString("N2")</strong></td>
                                <td><span class="status-pill status-@booking.Status.ToString().ToLower()">@booking.Status</span></td>
                                <td><a asp-controller="AdminFlightBookings" asp-action="Details" asp-route-id="@booking.FlightBookingId" class="dashboard-view-button"><i class="bi bi-eye"></i></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- ===================================================== -->
    <!-- ACTIVITY MANAGEMENT                                   -->
    <!-- ===================================================== -->
    <div class="section-heading">
        <div>
            <span class="dashboard-eyebrow">ACTIVITY MANAGEMENT</span>
            <h2>Activity Overview</h2>
            <p>Current statistics for activity management and activity bookings.</p>
        </div>
        <a asp-controller="AdminActivities" asp-action="Create" class="dashboard-add-button">
            <i class="bi bi-plus-lg"></i> Add Activity
        </a>
    </div>

    <div class="dashboard-stat-grid">
        <div class="dashboard-stat-card stat-pink">
            <div>
                <span>Total Activities</span>
                <h2>@Model.TotalActivities</h2>
                <small>@Model.ActiveActivities active activities</small>
            </div>
            <div class="stat-icon"><i class="bi bi-ticket-perforated"></i></div>
        </div>
        <div class="dashboard-stat-card stat-blue">
            <div>
                <span>Activity Bookings</span>
                <h2>@Model.TotalBookings</h2>
                <small>All activity reservations</small>
            </div>
            <div class="stat-icon"><i class="bi bi-calendar-check"></i></div>
        </div>
        <div class="dashboard-stat-card stat-green">
            <div>
                <span>Upcoming Sessions</span>
                <h2>@Model.UpcomingSessions</h2>
                <small>Active upcoming activity sessions</small>
            </div>
            <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
        </div>
        <div class="dashboard-stat-card stat-purple">
            <div>
                <span>Activity Revenue</span>
                <h2>RM @Model.TotalRevenue.ToString("N2")</h2>
                <small>Excluding cancelled activity bookings</small>
            </div>
            <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
        </div>
    </div>

    <div class="booking-status-grid">
        <a asp-controller="AdminActivityBookings" asp-action="Index" asp-route-status="Pending" class="booking-status-card">
            <div class="booking-status-icon pending-icon"><i class="bi bi-hourglass-split"></i></div>
            <div><span>Pending</span><strong>@Model.PendingBookings</strong></div>
        </a>
        <a asp-controller="AdminActivityBookings" asp-action="Index" asp-route-status="Confirmed" class="booking-status-card">
            <div class="booking-status-icon confirmed-icon"><i class="bi bi-check-circle"></i></div>
            <div><span>Confirmed</span><strong>@Model.ConfirmedBookings</strong></div>
        </a>
        <a asp-controller="AdminActivityBookings" asp-action="Index" asp-route-status="Completed" class="booking-status-card">
            <div class="booking-status-icon completed-icon"><i class="bi bi-check2-all"></i></div>
            <div><span>Completed</span><strong>@Model.CompletedBookings</strong></div>
        </a>
        <a asp-controller="AdminActivityBookings" asp-action="Index" asp-route-status="Cancelled" class="booking-status-card">
            <div class="booking-status-icon cancelled-icon"><i class="bi bi-x-circle"></i></div>
            <div><span>Cancelled</span><strong>@Model.CancelledBookings</strong></div>
        </a>
    </div>

    <div class="activity-analytics-grid">
        <section class="activity-analytics-card">
            <div class="activity-analytics-heading">
                <div>
                    <span class="activity-analytics-eyebrow">BOOKING ANALYTICS</span>
                    <h3>Booking Status Overview</h3>
                    <p>Current distribution of activity booking statuses.</p>
                </div>
                <div class="activity-analytics-icon">
                    <i class="bi bi-pie-chart"></i>
                </div>
            </div>

            <div class="activity-doughnut-wrap">
                <canvas id="activityBookingStatusChart"></canvas>
                <div class="activity-doughnut-center">
                    <strong>@Model.TotalBookings</strong>
                    <span>Total Bookings</span>
                </div>
            </div>

            <div class="activity-chart-legend">
                <div class="activity-legend-item">
                    <span class="activity-legend-dot pending"></span>
                    <div><small>Pending</small><strong>@Model.PendingBookings</strong></div>
                </div>
                <div class="activity-legend-item">
                    <span class="activity-legend-dot confirmed"></span>
                    <div><small>Confirmed</small><strong>@Model.ConfirmedBookings</strong></div>
                </div>
                <div class="activity-legend-item">
                    <span class="activity-legend-dot completed"></span>
                    <div><small>Completed</small><strong>@Model.CompletedBookings</strong></div>
                </div>
                <div class="activity-legend-item">
                    <span class="activity-legend-dot cancelled"></span>
                    <div><small>Cancelled</small><strong>@Model.CancelledBookings</strong></div>
                </div>
            </div>
        </section>

        <section class="activity-analytics-card">
            <div class="activity-analytics-heading">
                <div>
                    <span class="activity-analytics-eyebrow">ACTIVITY PERFORMANCE</span>
                    <h3>Management Summary</h3>
                    <p>A visual summary of the activity module performance.</p>
                </div>
                <div class="activity-analytics-icon blue">
                    <i class="bi bi-bar-chart-line"></i>
                </div>
            </div>

            <div class="activity-bar-wrap">
                <canvas id="activityPerformanceChart"></canvas>
            </div>

            <div class="activity-performance-summary">
                <div>
                    <span>Active Activities</span>
                    <strong>@Model.ActiveActivities</strong>
                </div>
                <div>
                    <span>Upcoming Sessions</span>
                    <strong>@Model.UpcomingSessions</strong>
                </div>
                <div>
                    <span>Revenue</span>
                    <strong>RM @Model.TotalRevenue.ToString("N2")</strong>
                </div>
            </div>
        </section>
    </div>

    <div class="dashboard-lower-grid">
        <section class="dashboard-panel">
            <div class="dashboard-panel-heading">
                <div>
                    <h3>Recent Activity Bookings</h3>
                    <p>Latest customer activity reservations.</p>
                </div>
                <a asp-controller="AdminActivityBookings" asp-action="Index">View All <i class="bi bi-arrow-right"></i></a>
            </div>
            @if (!Model.RecentBookings.Any())
            {
                <div class="dashboard-empty">
                    <i class="bi bi-calendar2-x"></i>
                    <h4>No bookings yet</h4>
                    <p>Activity bookings will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table dashboard-table">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Customer</th>
                                <th>Activity</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td><strong>@booking.BookingReference</strong><br /><small>@booking.BookingDate.ToString("dd MMM yyyy")</small></td>
                                    <td><strong>@booking.ContactName</strong><br /><small>@booking.ContactEmail</small></td>
                                    <td>@booking.ActivitySession?.Activity?.ActivityName</td>
                                    <td><strong>RM @booking.TotalAmount.ToString("N2")</strong></td>
                                    <td><span class="status-pill status-@booking.BookingStatus.ToString().ToLower()">@booking.BookingStatus</span></td>
                                    <td><a asp-controller="AdminActivityBookings" asp-action="Details" asp-route-id="@booking.ActivityBookingId" class="dashboard-view-button"><i class="bi bi-eye"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="dashboard-panel quick-action-panel">
            <div class="dashboard-panel-heading">
                <div>
                    <h3>Activity Quick Actions</h3>
                    <p>Manage your activities.</p>
                </div>
            </div>
            <div class="quick-action-list">
                <a asp-controller="AdminActivities" asp-action="Create">
                    <div class="quick-action-icon purple-action"><i class="bi bi-plus-lg"></i></div>
                    <div><strong>Add New Activity</strong><span>Create a new travel activity.</span></div>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a asp-controller="AdminActivities" asp-action="Index">
                    <div class="quick-action-icon blue-action"><i class="bi bi-pencil-square"></i></div>
                    <div><strong>Manage Activities</strong><span>Edit activities, sessions and photos.</span></div>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a asp-controller="AdminActivityBookings" asp-action="Index">
                    <div class="quick-action-icon green-action"><i class="bi bi-calendar-check"></i></div>
                    <div><strong>Manage Activity Bookings</strong><span>Review and update customer bookings.</span></div>
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </section>
    </div>

    <!-- ===================================================== -->
    <!-- HOTEL MANAGEMENT                                      -->
    <!-- ===================================================== -->
    <div class="section-heading mt-5">
        <div>
            <span class="dashboard-eyebrow">HOTEL MANAGEMENT</span>
            <h2>Hotel Overview</h2>
            <p>Current statistics for hotel rooms and reservations.</p>
        </div>
        <a asp-controller="AdminRooms" asp-action="Create" class="dashboard-add-button">
            <i class="bi bi-plus-lg"></i> Add Hotel Room
        </a>
    </div>

    <div class="dashboard-stat-grid">
        <div class="dashboard-stat-card stat-blue">
            <div>
                <span>Total Hotel Rooms</span>
                <h2>@Model.TotalHotelRooms</h2>
                <small>@Model.ActiveHotelRooms active room listings</small>
            </div>
            <div class="stat-icon"><i class="bi bi-building"></i></div>
        </div>
        <div class="dashboard-stat-card stat-green">
            <div>
                <span>Hotel Reservations</span>
                <h2>@Model.TotalHotelReservations</h2>
                <small>All hotel reservations</small>
            </div>
            <div class="stat-icon"><i class="bi bi-calendar2-check"></i></div>
        </div>
        <div class="dashboard-stat-card stat-pink">
            <div>
                <span>Upcoming Stays</span>
                <h2>@Model.UpcomingHotelReservations</h2>
                <small>Confirmed or completed stays</small>
            </div>
            <div class="stat-icon"><i class="bi bi-calendar2-week"></i></div>
        </div>
        <div class="dashboard-stat-card stat-purple">
            <div>
                <span>Hotel Revenue</span>
                <h2>RM @Model.HotelRevenue.ToString("N2")</h2>
                <small>Excluding cancelled reservations</small>
            </div>
            <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
        </div>
    </div>

    <div class="booking-status-grid mb-4">
        <a asp-controller="AdminHotelReservations" asp-action="Index" asp-route-status="Confirmed" class="booking-status-card">
            <div class="booking-status-icon confirmed-icon"><i class="bi bi-check-circle"></i></div>
            <div><span>Confirmed</span><strong>@Model.ConfirmedHotelReservations</strong></div>
        </a>
        <a asp-controller="AdminHotelReservations" asp-action="Index" asp-route-status="Completed" class="booking-status-card">
            <div class="booking-status-icon completed-icon"><i class="bi bi-check2-all"></i></div>
            <div><span>Completed</span><strong>@Model.CompletedHotelReservations</strong></div>
        </a>
        <a asp-controller="AdminHotelReservations" asp-action="Index" asp-route-status="Cancelled" class="booking-status-card">
            <div class="booking-status-icon cancelled-icon"><i class="bi bi-x-circle"></i></div>
            <div><span>Cancelled</span><strong>@Model.CancelledHotelReservations</strong></div>
        </a>
    </div>

    <section class="dashboard-panel mb-5">
        <div class="dashboard-panel-heading">
            <div>
                <h3>Recent Hotel Reservations</h3>
                <p>Latest customer hotel reservations.</p>
            </div>
            <a asp-controller="AdminHotelReservations" asp-action="Index">View All <i class="bi bi-arrow-right"></i></a>
        </div>
        @if (!Model.RecentHotelReservations.Any())
        {
            <div class="dashboard-empty">
                <i class="bi bi-calendar2-x"></i>
                <h4>No hotel reservations yet</h4>
                <p>Hotel reservations will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table dashboard-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Customer</th>
                            <th>Room</th>
                            <th>Check-in</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in Model.RecentHotelReservations)
                        {
                            <tr>
                                <td><strong>@reservation.ReservationReference</strong><br /><small>@reservation.ReservationDate.ToString("dd MMM yyyy")</small></td>
                                <td><strong>@reservation.ContactName</strong><br /><small>@reservation.ContactEmail</small></td>
                                <td>@reservation.HotelRoom?.HotelName<br /><small>@reservation.HotelRoom?.RoomName</small></td>
                                <td>@reservation.CheckInDate.ToString("dd MMM yyyy")</td>
                                <td><strong>RM @reservation.TotalAmount.ToString("N2")</strong></td>
                                <td><span class="status-pill status-@reservation.ReservationStatus.ToString().ToLower()">@reservation.ReservationStatus</span></td>
                                <td><a asp-controller="AdminHotelReservations" asp-action="Details" asp-route-id="@reservation.HotelReservationId" class="dashboard-view-button"><i class="bi bi-eye"></i></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>

<style>
    .dashboard-heading {
        display: block !important;
        width: 100%;
        margin-bottom: 24px;
    }

        .dashboard-heading > div {
            width: 100%;
        }

    .section-heading {
        width: 100%;
    }

    .dashboard-panel {
        min-width: 0;
    }

        .dashboard-panel .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

    .dashboard-table {
        width: 100%;
    }

    @@media (min-width: 1200px) {
        .row.g-4 > .col-xl-6 {
            display: flex;
        }

            .row.g-4 > .col-xl-6 > .dashboard-panel {
                width: 100%;
            }
    }
</style>


<style>
    .activity-analytics-grid {
        display: grid;
        grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
        gap: 18px;
        margin: 20px 0 22px;
    }

    .activity-analytics-card {
        min-width: 0;
        padding: 20px;
        background: #fff;
        border: 1px solid #e8eaf0;
        border-radius: 18px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, .035);
    }

    .activity-analytics-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
    }

    .activity-analytics-eyebrow {
        display: block;
        margin-bottom: 5px;
        color: #8b5cf6;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: .11em;
    }

    .activity-analytics-heading h3 {
        margin: 0;
        color: #111827;
        font-size: 17px;
        font-weight: 850;
    }

    .activity-analytics-heading p {
        margin: 4px 0 0;
        color: #94a3b8;
        font-size: 10px;
    }

    .activity-analytics-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #f5f3ff;
        color: #7c3aed;
        font-size: 19px;
    }

        .activity-analytics-icon.blue {
            background: #eff6ff;
            color: #3b82f6;
        }

    .activity-doughnut-wrap {
        position: relative;
        width: 100%;
        max-width: 290px;
        height: 240px;
        margin: 0 auto;
    }

    .activity-doughnut-center {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        pointer-events: none;
    }

        .activity-doughnut-center strong {
            color: #111827;
            font-size: 28px;
            font-weight: 900;
            line-height: 1;
        }

        .activity-doughnut-center span {
            margin-top: 5px;
            color: #94a3b8;
            font-size: 9px;
            font-weight: 700;
        }

    .activity-chart-legend {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 9px;
        margin-top: 10px;
    }

    .activity-legend-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 10px;
        border-radius: 10px;
        background: #f8fafc;
    }

    .activity-legend-dot {
        width: 9px;
        height: 9px;
        flex: 0 0 9px;
        border-radius: 50%;
    }

        .activity-legend-dot.pending {
            background: #f59e0b;
        }

        .activity-legend-dot.confirmed {
            background: #10b981;
        }

        .activity-legend-dot.completed {
            background: #3b82f6;
        }

        .activity-legend-dot.cancelled {
            background: #ef4444;
        }

    .activity-legend-item small {
        display: block;
        color: #94a3b8;
        font-size: 8px;
    }

    .activity-legend-item strong {
        display: block;
        margin-top: 1px;
        color: #111827;
        font-size: 13px;
        font-weight: 850;
    }

    .activity-bar-wrap {
        position: relative;
        width: 100%;
        height: 270px;
    }

    .activity-performance-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 9px;
        margin-top: 12px;
    }

        .activity-performance-summary > div {
            padding: 10px;
            border-radius: 10px;
            background: #f8fafc;
            text-align: center;
        }

        .activity-performance-summary span {
            display: block;
            color: #94a3b8;
            font-size: 8px;
        }

        .activity-performance-summary strong {
            display: block;
            margin-top: 3px;
            color: #111827;
            font-size: 12px;
            font-weight: 850;
        }

    @@media(max-width: 1100px) {
        .activity-analytics-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width: 650px) {
        .activity-chart-legend,
        .activity-performance-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
    const statusCanvas = document.getElementById("activityBookingStatusChart");

    if (statusCanvas && window.Chart) {
    new Chart(statusCanvas, {
    type: "doughnut",
    data: {
    labels: ["Pending", "Confirmed", "Completed", "Cancelled"],
    datasets: [{
    data: [
    @Model.PendingBookings,
    @Model.ConfirmedBookings,
    @Model.CompletedBookings,
    @Model.CancelledBookings
    ],
    backgroundColor: [
    "#f59e0b",
    "#10b981",
    "#3b82f6",
    "#ef4444"
    ],
    borderColor: "#ffffff",
    borderWidth: 5,
    hoverOffset: 4
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    cutout: "72%",
    plugins: {
    legend: { display: false },
    tooltip: {
    callbacks: {
    label: function (context) {
    return context.label + ": " + context.raw;
    }
    }
    }
    }
    }
    });
    }

    const performanceCanvas = document.getElementById("activityPerformanceChart");

    if (performanceCanvas && window.Chart) {
    new Chart(performanceCanvas, {
    type: "bar",
    data: {
    labels: [
    "Total Activities",
    "Active Activities",
    "Bookings",
    "Upcoming Sessions"
    ],
    datasets: [{
    data: [
    @Model.TotalActivities,
    @Model.ActiveActivities,
    @Model.TotalBookings,
    @Model.UpcomingSessions
    ],
    backgroundColor: [
    "rgba(244, 114, 182, .78)",
    "rgba(139, 92, 246, .78)",
    "rgba(59, 130, 246, .78)",
    "rgba(45, 212, 191, .78)"
    ],
    borderRadius: 9,
    borderSkipped: false,
    maxBarThickness: 58
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    scales: {
    y: {
    beginAtZero: true,
    ticks: {
    precision: 0,
    color: "#94a3b8",
    font: { size: 9 }
    },
    grid: {
    color: "rgba(148,163,184,.13)"
    },
    border: { display: false }
    },
    x: {
    ticks: {
    color: "#64748b",
    font: { size: 9 }
    },
    grid: { display: false },
    border: { display: false }
    }
    },
    plugins: {
    legend: { display: false },
    tooltip: {
    displayColors: false
    }
    }
    }
    });
    }
    });
</script>
