@model TravelPlanningSystem.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="dashboard-page">

    <div class="dashboard-heading">

        <div>

            <span class="dashboard-eyebrow">
                TRAVELMATE ADMINISTRATION
            </span>

            <h1>
                TravelMate Admin Dashboard
            </h1>

            <p>
                Manage the Travel Planning System
                from one central administration dashboard.
            </p>

        </div>

    <div class="section-heading mt-4">

        <div>

            <span class="dashboard-eyebrow">
                USERS & STAFF
            </span>

            <h2>
                Accounts Overview
            </h2>

            <p>
                A quick view of registered customers and staff accounts.
            </p>

        </div>

    </div>

    <div class="row mb-4">

        <div class="col-md-6">

            <section class="dashboard-panel">

                <div class="dashboard-panel-heading">

                    <div>

                        <h3>
                            Recent Users
                        </h3>

                        <p>
                            Latest registered application users.
                        </p>

                    </div>

                </div>

                @if (!Model.Users.Any())
                {
                    <div class="dashboard-empty">
                        <i class="bi bi-people"></i>
                        <h4>No users</h4>
                        <p>There are no registered users yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table dashboard-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Tier</th>
                                    <th>Points</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.Users)
                                {
                                    <tr>
                                        <td>@(u.FirstName) @u.LastName</td>
                                        <td>@u.Email</td>
                                        <td>@u.LoyaltyTier</td>
                                        <td>@u.RewardPoints</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

        <div class="col-md-6">

            <section class="dashboard-panel">

                <div class="dashboard-panel-heading">

                    <div>

                        <h3>
                            Staff Users
                        </h3>

                        <p>
                            Administrative and support staff accounts.
                        </p>

                    </div>

                </div>

                @if (!Model.StaffUsers.Any())
                {
                    <div class="dashboard-empty">
                        <i class="bi bi-person-badge"></i>
                        <h4>No staff users</h4>
                        <p>There are no staff accounts yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table dashboard-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Access</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.StaffUsers)
                                {
                                    <tr>
                                        <td>@(s.FirstName) @s.LastName</td>
                                        <td>@s.Email</td>
                                        <td>@(s.StaffRole?.RoleName ?? "-")</td>
                                        <td>@s.AccessLevel</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>

    </div>

    </div>

    <div class="dashboard-panel mb-4">

        <div class="dashboard-panel-heading">

            <div>

                <h3>
                    System Management
                </h3>

                <p>
                    Manage the different travel services in the TravelMate system.
                </p>

            </div>

        </div>


        <div class="team-module-grid">


            <!-- FLIGHT -->

            <div class="team-module-card">

                <div class="team-module-icon flight-module">

                    <i class="bi bi-airplane"></i>

                </div>

                <div>

                    <strong>
                        Flight Management
                    </strong>

                    <span>
                        Flight management and bookings
                    </span>

                </div>

            </div>


            <!-- HOTEL -->

            <div class="team-module-card">

                <div class="team-module-icon hotel-module">

                    <i class="bi bi-building"></i>

                </div>

                <div>

                    <strong>
                        Hotel Reservation
                    </strong>

                    <span>
                        Rooms and hotel reservations
                    </span>

                </div>

            </div>


            <!-- TRANSPORTATION -->

            <div class="team-module-card">

                <div class="team-module-icon transport-module">

                    <i class="bi bi-car-front"></i>

                </div>

                <div>

                    <strong>
                        Transportation
                    </strong>

                    <span>
                        Transportation management and bookings
                    </span>

                </div>

            </div>


            <!-- ACTIVITIES -->

            <a asp-controller="AdminActivities"
               asp-action="Index"
               class="team-module-card activity-module-card">

                <div class="team-module-icon activity-module">

                    <i class="bi bi-ticket-perforated"></i>

                </div>

                <div>

                    <strong>
                        Activities
                    </strong>

                    <span>
                        Activity catalog, booking and maintenance
                    </span>

                </div>

                <span class="active-module-badge">
                    Active
                </span>

            </a>

        </div>

    </div>


    <div class="section-heading">

        <div>

            <span class="dashboard-eyebrow">
                ACTIVITY MANAGEMENT
            </span>

            <h2>
                Activity Overview
            </h2>

            <p>
                Current statistics for activity management
                and activity bookings.
            </p>

        </div>


        <a asp-controller="AdminActivities"
           asp-action="Create"
           class="dashboard-add-button">

            <i class="bi bi-plus-lg"></i>

            Add Activity

        </a>

    </div>

    <div class="dashboard-stat-grid">


        <!-- TOTAL ACTIVITIES -->

        <div class="dashboard-stat-card stat-pink">

            <div>

                <span>
                    Total Activities
                </span>

                <h2>
                    @Model.TotalActivities
                </h2>

                <small>
                    @Model.ActiveActivities active activities
                </small>

            </div>

            <div class="stat-icon">

                <i class="bi bi-ticket-perforated"></i>

            </div>

        </div>


        <!-- ACTIVITY BOOKINGS -->

        <div class="dashboard-stat-card stat-blue">

            <div>

                <span>
                    Activity Bookings
                </span>

                <h2>
                    @Model.TotalBookings
                </h2>

                <small>
                    All activity reservations
                </small>

            </div>

            <div class="stat-icon">

                <i class="bi bi-calendar-check"></i>

            </div>

        </div>


        <!-- UPCOMING SESSIONS -->

        <div class="dashboard-stat-card stat-green">

            <div>

                <span>
                    Upcoming Sessions
                </span>

                <h2>
                    @Model.UpcomingSessions
                </h2>

                <small>
                    Active upcoming activity sessions
                </small>

            </div>

            <div class="stat-icon">

                <i class="bi bi-clock-history"></i>

            </div>

        </div>


        <!-- ACTIVITY REVENUE -->

        <div class="dashboard-stat-card stat-purple">

            <div>

                <span>
                    Activity Revenue
                </span>

                <h2>
                    RM @Model.TotalRevenue.ToString("N2")
                </h2>

                <small>
                    Excluding cancelled activity bookings
                </small>

            </div>

            <div class="stat-icon">

                <i class="bi bi-cash-stack"></i>

            </div>

        </div>

    </div>

    <div class="booking-status-grid">


        <!-- PENDING -->

        <a asp-controller="AdminActivityBookings"
           asp-action="Index"
           asp-route-status="Pending"
           class="booking-status-card">

            <div class="booking-status-icon pending-icon">

                <i class="bi bi-hourglass-split"></i>

            </div>

            <div>

                <span>
                    Pending
                </span>

                <strong>
                    @Model.PendingBookings
                </strong>

            </div>

        </a>


        <!-- CONFIRMED -->

        <a asp-controller="AdminActivityBookings"
           asp-action="Index"
           asp-route-status="Confirmed"
           class="booking-status-card">

            <div class="booking-status-icon confirmed-icon">

                <i class="bi bi-check-circle"></i>

            </div>

            <div>

                <span>
                    Confirmed
                </span>

                <strong>
                    @Model.ConfirmedBookings
                </strong>

            </div>

        </a>


        <!-- COMPLETED -->

        <a asp-controller="AdminActivityBookings"
           asp-action="Index"
           asp-route-status="Completed"
           class="booking-status-card">

            <div class="booking-status-icon completed-icon">

                <i class="bi bi-check2-all"></i>

            </div>

            <div>

                <span>
                    Completed
                </span>

                <strong>
                    @Model.CompletedBookings
                </strong>

            </div>

        </a>


        <!-- CANCELLED -->

        <a asp-controller="AdminActivityBookings"
           asp-action="Index"
           asp-route-status="Cancelled"
           class="booking-status-card">

            <div class="booking-status-icon cancelled-icon">

                <i class="bi bi-x-circle"></i>

            </div>

            <div>

                <span>
                    Cancelled
                </span>

                <strong>
                    @Model.CancelledBookings
                </strong>

            </div>

        </a>

    </div>

    <div class="dashboard-lower-grid">


        <!-- RECENT ACTIVITY BOOKINGS -->

        <section class="dashboard-panel">

            <div class="dashboard-panel-heading">

                <div>

                    <h3>
                        Recent Activity Bookings
                    </h3>

                    <p>
                        Latest customer activity reservations.
                    </p>

                </div>


                <a asp-controller="AdminActivityBookings"
                   asp-action="Index">

                    View All

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            @if (!Model.RecentBookings.Any())
            {
                <div class="dashboard-empty">

                    <i class="bi bi-calendar2-x"></i>

                    <h4>
                        No bookings yet
                    </h4>

                    <p>
                        Activity bookings will appear here.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table dashboard-table">

                        <thead>

                            <tr>

                                <th>
                                    Reference
                                </th>

                                <th>
                                    Customer
                                </th>

                                <th>
                                    Activity
                                </th>

                                <th>
                                    Total
                                </th>

                                <th>
                                    Status
                                </th>

                                <th></th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>

                                    <!-- REFERENCE -->

                                    <td>

                                        <strong>
                                            @booking.BookingReference
                                        </strong>

                                        <small>
                                            @booking.BookingDate.ToString("dd MMM yyyy")
                                        </small>

                                    </td>


                                    <!-- CUSTOMER -->

                                    <td>

                                        <strong>
                                            @booking.ContactName
                                        </strong>

                                        <small>
                                            @booking.ContactEmail
                                        </small>

                                    </td>


                                    <!-- ACTIVITY -->

                                    <td>

                                        @booking.ActivitySession?.Activity?.ActivityName

                                    </td>


                                    <!-- TOTAL -->

                                    <td>

                                        <strong>
                                            RM @booking.TotalAmount.ToString("N2")
                                        </strong>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span class="status-pill status-@booking.BookingStatus.ToString().ToLower()">

                                            @booking.BookingStatus

                                        </span>

                                    </td>


                                    <!-- VIEW -->

                                    <td>

                                        <a asp-controller="AdminActivityBookings"
                                           asp-action="Details"
                                           asp-route-id="@booking.ActivityBookingId"
                                           class="dashboard-view-button">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </section>

        <section class="dashboard-panel quick-action-panel">

            <div class="dashboard-panel-heading">

                <div>

                    <h3>
                        Activity Quick Actions
                    </h3>

                    <p>
                        Manage your activities.
                    </p>

                </div>

            </div>


            <div class="quick-action-list">


                <!-- ADD ACTIVITY -->

                <a asp-controller="AdminActivities"
                   asp-action="Create">

                    <div class="quick-action-icon purple-action">

                        <i class="bi bi-plus-lg"></i>

                    </div>

                    <div>

                        <strong>
                            Add New Activity
                        </strong>

                        <span>
                            Create a new travel activity.
                        </span>

                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>


                <!-- MANAGE ACTIVITIES -->

                <a asp-controller="AdminActivities"
                   asp-action="Index">

                    <div class="quick-action-icon blue-action">

                        <i class="bi bi-pencil-square"></i>

                    </div>

                    <div>

                        <strong>
                            Manage Activities
                        </strong>

                        <span>
                            Edit activities, sessions and photos.
                        </span>

                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>


                <!-- MANAGE BOOKINGS -->

                <a asp-controller="AdminActivityBookings"
                   asp-action="Index">

                    <div class="quick-action-icon green-action">

                        <i class="bi bi-calendar-check"></i>

                    </div>

                    <div>

                        <strong>
                            Manage Activity Bookings
                        </strong>

                        <span>
                            Review and update customer bookings.
                        </span>

                    </div>

                    <i class="bi bi-chevron-right"></i>

                </a>

            </div>

        </section>

    </div>

</div>