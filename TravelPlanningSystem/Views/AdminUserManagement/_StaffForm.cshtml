@model TravelPlanningSystem.ViewModels.StaffManagementInput

@{
    var roles = ViewBag.StaffRoles as IEnumerable<TravelPlanningSystem.Models.StaffRole> ?? Enumerable.Empty<TravelPlanningSystem.Models.StaffRole>();
    var storedPhone = Model.PhoneNumber?.Trim() ?? string.Empty;
    var countryCodes = new[] { "+60", "+1", "+44", "+61", "+65", "+91" };
    var selectedCountryCode = countryCodes.FirstOrDefault(code => storedPhone.StartsWith(code, StringComparison.Ordinal)) ?? "+60";
    var localPhone = storedPhone.StartsWith(selectedCountryCode, StringComparison.Ordinal)
        ? storedPhone[selectedCountryCode.Length..].TrimStart()
        : storedPhone;
}

<div class="row g-3">
    <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name" required maxlength="100" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" autocomplete="family-name" required maxlength="100" /><span asp-validation-for="LastName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" autocomplete="email" required maxlength="150" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <div class="d-flex gap-2">
            <select class="form-select staff-country-code" style="max-width:150px;" aria-label="Phone country code">
                <option value="+60" selected="@(selectedCountryCode == "+60")">+60 Malaysia</option>
                <option value="+1" selected="@(selectedCountryCode == "+1")">+1 USA</option>
                <option value="+44" selected="@(selectedCountryCode == "+44")">+44 UK</option>
                <option value="+61" selected="@(selectedCountryCode == "+61")">+61 Australia</option>
                <option value="+65" selected="@(selectedCountryCode == "+65")">+65 Singapore</option>
                <option value="+91" selected="@(selectedCountryCode == "+91")">+91 India</option>
            </select>
            <input class="form-control staff-local-phone" value="@localPhone" type="tel" autocomplete="tel-national" inputmode="tel" maxlength="19" pattern="[0-9\s().-]{7,19}" title="Enter a valid phone number using digits only." />
        </div>
        <input asp-for="PhoneNumber" class="staff-phone-value" type="hidden" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="col-md-6"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control" required maxlength="100" /><span asp-validation-for="Department" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="RoleId" class="form-label">Role</label><select asp-for="RoleId" class="form-select" required><option value="">Select role</option>@foreach (var role in roles) { <option value="@role.RoleId">@role.RoleName</option> }</select><span asp-validation-for="RoleId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="AccessLevel" class="form-label"></label><input asp-for="AccessLevel" type="number" class="form-control" min="1" max="10" required /><span asp-validation-for="AccessLevel" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" required><option value="">Select status</option><option>Active</option><option>Inactive</option><option>Suspended</option></select><span asp-validation-for="Status" class="text-danger"></span></div>
    @if (ViewContext.RouteData.Values["action"]?.ToString() == "CreateStaff")
    {
        <div class="col-12"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" type="password" autocomplete="new-password" minlength="8" required /><small class="text-muted">Use at least 8 characters.</small><span asp-validation-for="Password" class="text-danger"></span></div>
    }
</div>

<script>
    (() => {
        const form = document.currentScript.closest('form');
        const country = form?.querySelector('.staff-country-code');
        const local = form?.querySelector('.staff-local-phone');
        const value = form?.querySelector('.staff-phone-value');
        if (!form || !country || !local || !value) return;

        form.addEventListener('submit', event => {
            const digits = local.value.replace(/\D/g, '');
            if (digits && (digits.length < 7 || digits.length > 19)) {
                event.preventDefault();
                local.setCustomValidity('Enter a valid phone number using digits only.');
                local.reportValidity();
                return;
            }

            local.setCustomValidity('');
            value.value = digits ? `${country.value}${digits}` : '';
        });
    })();
</script>
