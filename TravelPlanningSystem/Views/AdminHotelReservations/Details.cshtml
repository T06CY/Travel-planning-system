@model TravelPlanningSystem.Models.HotelReservation

@{
    ViewData["Title"] = "Hotel Reservation Details";
    var photo = Model.HotelRoom?.Photos.FirstOrDefault(p => p.IsPrimary)?.PhotoUrl
        ?? Model.HotelRoom?.Photos.FirstOrDefault()?.PhotoUrl
        ?? "/images/hotels/uploads/no-image.jpg";
}

<a asp-action="Index" class="text-decoration-none">
    <i class="bi bi-arrow-left"></i> Back to hotel reservations
</a>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mt-3 mb-4">
    <div>
        <h1 class="mb-1">Reservation @Model.ReservationReference</h1>
        <p class="text-muted mb-0">Created @Model.ReservationDate.ToString("dd MMM yyyy, hh:mm tt")</p>
    </div>

    <span class="badge fs-6 @(Model.ReservationStatus switch {
        TravelPlanningSystem.Models.HotelReservationStatus.Confirmed => "text-bg-primary",
        TravelPlanningSystem.Models.HotelReservationStatus.Completed => "text-bg-success",
        _ => "text-bg-secondary"
    })">
        @Model.ReservationStatus
    </span>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm overflow-hidden">
            <img src="@photo" alt="@Model.HotelRoom?.RoomName" style="width:100%;height:280px;object-fit:cover;" />
            <div class="card-body">
                <h4>@Model.HotelRoom?.HotelName</h4>
                <p class="mb-1">@Model.HotelRoom?.RoomName</p>
                <small class="text-muted">@Model.HotelRoom?.Destination</small>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-4">
            <h4 class="mb-3">Reservation Details</h4>

            <dl class="row mb-0">
                <dt class="col-sm-4">Guest</dt>
                <dd class="col-sm-8">@Model.ContactName</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.ContactEmail</dd>

                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8">@Model.ContactPhone</dd>

                <dt class="col-sm-4">Check-in</dt>
                <dd class="col-sm-8">@Model.CheckInDate.ToString("dd MMM yyyy") @Model.CheckInTime.ToString("hh\\:mm")</dd>

                <dt class="col-sm-4">Check-out</dt>
                <dd class="col-sm-8">@Model.CheckOutDate.ToString("dd MMM yyyy") @Model.CheckOutTime.ToString("hh\\:mm")</dd>

                <dt class="col-sm-4">Guests</dt>
                <dd class="col-sm-8">@Model.GuestCount</dd>

                <dt class="col-sm-4">Nightly rate</dt>
                <dd class="col-sm-8">RM @Model.PricePerNight.ToString("N2")</dd>

                <dt class="col-sm-4">Total amount</dt>
                <dd class="col-sm-8"><strong>RM @Model.TotalAmount.ToString("N2")</strong></dd>

                @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                {
                    <dt class="col-sm-4">Cancellation reason</dt>
                    <dd class="col-sm-8">@Model.CancellationReason</dd>
                }
            </dl>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 mt-4">
    <h4>Update Reservation Status</h4>
    <p class="text-muted">Use this for administrative reservation management.</p>

    <div class="d-flex flex-wrap gap-2">
        @foreach (var status in Enum.GetValues<TravelPlanningSystem.Models.HotelReservationStatus>())
        {
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.HotelReservationId" />
                <input type="hidden" name="status" value="@status" />
                <button type="submit"
                        class="btn @(Model.ReservationStatus == status ? "btn-secondary" : "btn-outline-primary")"
                        disabled="@(Model.ReservationStatus == status)">
                    Mark @status
                </button>
            </form>
        }
    </div>
</div>
