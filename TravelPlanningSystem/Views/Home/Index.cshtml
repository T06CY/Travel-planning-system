@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-overlay"></div>

    <div class="container-fluid px-5 hero-content">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h2 class="script-title">Your Journey,</h2>
                <h1>Our Passion</h1>
                <div class="underline"></div>

                <p>
                    Everything you need to plan, book and enjoy<br />
                    an unforgettable trip.
                </p>

                <div class="hero-buttons">
                    <a class="btn main-btn" asp-controller="Flight" asp-action="Index">
                        Plan My Trip <i class="bi bi-arrow-right"></i>
                    </a>

                    <a class="btn outline-btn" asp-controller="Activity" asp-action="Index">
                        Explore Activities <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-5 d-none d-lg-block">
                <div class="promo-card">
                    <h4>Weekend Escape?</h4>
                    <p>Find short getaways<br />near you</p>

                    <a asp-controller="Activity" asp-action="Index">
                        Discover Now <i class="bi bi-arrow-right"></i>
                    </a>

                    <div class="bag-img">🧳</div>
                </div>

                <div class="slider-dot">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="route-animation-section" aria-label="Travel route animation">
    <div class="route-animation-card">
        <div class="route-animation-copy">
            <span class="route-eyebrow"><i class="bi bi-compass"></i> YOUR NEXT ADVENTURE</span>
            <h2>Take the scenic route.</h2>
            <p>Explore new places, compare flight schedules and make every journey memorable.</p>
            <div class="route-highlights"><span><i class="bi bi-calendar2-check"></i> Flexible dates</span><span><i class="bi bi-tags"></i> Clear fares</span><span><i class="bi bi-shield-check"></i> Secure booking</span></div>
            <a class="route-cta" asp-controller="Flight" asp-action="Index">Plan your trip <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="route-animation" aria-hidden="true">
            <div class="route-grid"></div>
            <svg class="route-map-line" viewBox="0 0 620 260" preserveAspectRatio="none"><path d="M42 201 C145 226 192 55 305 113 S455 205 576 48"></path></svg>
            <span class="route-stop stop-kl"><i class="bi bi-geo-alt-fill"></i><b>Kuala Lumpur</b></span>
            <span class="route-stop stop-sg"><i class="bi bi-geo-alt-fill"></i><b>Singapore</b></span>
            <span class="route-stop stop-tokyo"><i class="bi bi-geo-alt-fill"></i><b>Tokyo</b></span>
            <span class="route-plane"><i class="bi bi-airplane-fill"></i></span>
            <span class="route-distance"><i class="bi bi-stars"></i> Go further</span>
        </div>
    </div>
</section>

<section class="services">
    <div class="section-heading">
        <div class="line"></div>
        <i class="bi bi-send"></i>
        <h2>Explore Our Services</h2>
        <div class="line"></div>
        <p>Choose any service to start planning your perfect trip</p>
    </div>

    <div class="container-fluid px-5">
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="service-card flight-card">
                    <div class="service-img">✈️</div>
                    <h3>Flight Booking</h3>
                    <p>Find and book the best flights at amazing prices.</p>
                    <a asp-controller="Flight" asp-action="Index">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-card hotel-card">
                    <div class="service-img">🏨</div>
                    <h3>Hotel Reservation</h3>
                    <p>Discover comfortable stays that suit your style.</p>
                    <a asp-controller="Hotel" asp-action="Index">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-card transport-card">
                    <div class="service-img">🚗</div>
                    <h3>Transportation</h3>
                    <p>Book airport transfers, taxis, buses and more.</p>
                    <a asp-controller="Transportation" asp-action="Index">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-card activity-card">
                    <div class="service-img">🎈</div>
                    <h3>Activities</h3>
                    <p>Explore top attractions and fun local experiences.</p>
                    <a asp-controller="Activity" asp-action="Index">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="features">
            <span><i class="bi bi-shield-check"></i> Secure Payments</span>
            <span>•</span>
            <span>24/7 Support</span>
            <span>•</span>
            <span>Best Price Guarantee</span>
        </div>
    </div>
</section>
