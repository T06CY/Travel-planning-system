@model TravelPlanningSystem.Models.ActivityBooking

@{
    ViewData["Title"] = "Activity E-Ticket";

    var activityName =
        Model.ActivitySession?.Activity?.ActivityName
        ?? "Activity";

    var activityLocation =
        Model.ActivitySession?.Activity?.Location
        ?? "-";

    var sessionDate =
        Model.ActivitySession?.SessionDate;

    var sessionStartTime =
        Model.ActivitySession != null
            ? DateTime.Today
                .Add(Model.ActivitySession.StartTime)
                .ToString("h:mm tt")
            : "-";

    var sessionEndTime =
        Model.ActivitySession != null
            ? DateTime.Today
                .Add(Model.ActivitySession.EndTime)
                .ToString("h:mm tt")
            : "-";
}

<link rel="stylesheet"
      href="~/css/activities.css"
      asp-append-version="true" />

<div class="ticket-page">

    <div class="ticket-toolbar no-print">

        <a asp-action="Details"
           asp-route-id="@Model.ActivityBookingId">

            <i class="bi bi-arrow-left"></i>

            Booking Details

        </a>

        <button type="button"
                onclick="window.print()"
                class="btn btn-view-activity">

            <i class="bi bi-printer"></i>

            Print / Save as PDF

        </button>

    </div>


    <div class="ticket">

        <div class="ticket-brand">

            <div class="ticket-logo">

                <i class="bi bi-airplane-fill"></i>

            </div>

            <div>

                <h2>
                    Travel<span>Mate</span>
                </h2>

                <small>
                    Activity E-Ticket
                </small>

            </div>

            <span class="status-pill status-@Model.BookingStatus.ToString().ToLower()">

                @Model.BookingStatus

            </span>

        </div>


        <div class="ticket-hero">

            <span>
                Booking Reference
            </span>

            <strong>
                @Model.BookingReference
            </strong>

            <h1>
                @activityName
            </h1>

            <p>

                <i class="bi bi-geo-alt-fill"></i>

                @activityLocation

            </p>

        </div>


        <div class="ticket-grid">

            <div>

                <span>
                    Date
                </span>

                <strong>
                    @(sessionDate?.ToString("dd MMM yyyy") ?? "-")
                </strong>

            </div>

            <div>

                <span>
                    Time
                </span>

                <strong>
                    @sessionStartTime
                    -
                    @sessionEndTime
                </strong>

            </div>

            <div>

                <span>
                    Lead Traveller
                </span>

                <strong>
                    @Model.ContactName
                </strong>

            </div>

            <div>

                <span>
                    Participants
                </span>

                <strong>
                    @Model.ParticipantCount
                </strong>

            </div>

            <div>

                <span>
                    Price per Person
                </span>

                <strong>
                    RM @Model.PricePerPerson.ToString("N2")
                </strong>

            </div>

            <div>

                <span>
                    Total Amount
                </span>

                <strong>
                    RM @Model.TotalAmount.ToString("N2")
                </strong>

            </div>

            <div>

                <span>
                    Contact
                </span>

                <strong>
                    @Model.ContactPhone
                </strong>

            </div>

            <div>

                <span>
                    Payment
                </span>

                <strong>
                    @Model.PaymentStatus
                </strong>

            </div>

            <div>

                <span>
                    Payment Method
                </span>

                <strong>
                    @Model.PaymentMethod
                </strong>

            </div>

        </div>


        <div class="ticket-code">

            <div class="real-qr">

                @if (ViewBag.QrCode != null)
                {
                    <img src="@ViewBag.QrCode"
                         alt="QR Code for booking @Model.BookingReference"
                         class="ticket-qr-code" />
                }
                else
                {
                    <div class="qr-unavailable">

                        <i class="bi bi-qr-code"></i>

                        <span>
                            QR code unavailable
                        </span>

                    </div>
                }

            </div>


            <div class="ticket-checkin-info">

                <strong>
                    Present this QR code at check-in
                </strong>

                <p>
                    Arrive at least 15 minutes before the activity starts.
                    Scan the QR code to view the booking information or
                    provide the booking reference to the operator.
                </p>

                <div class="ticket-checkin-reference">

                    <span>
                        Booking Reference
                    </span>

                    <strong>
                        @Model.BookingReference
                    </strong>

                </div>

            </div>

        </div>


        <div class="ticket-footer">

            Generated on
            @DateTime.Now.ToString("dd MMM yyyy, h:mm tt")
            · TravelMate Activities

        </div>

    </div>

</div>