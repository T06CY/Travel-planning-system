@model TravelPlanningSystem.ViewModels.ActivityReviewViewModel

@{
    ViewData["Title"] = "Write Review";
}

<link rel="stylesheet"
      href="~/css/activities.css"
      asp-append-version="true" />

<div class="activity-review-page">

    <div class="review-container">

        <div class="review-back-row">

            <a asp-controller="ActivityBookings"
               asp-action="Details"
               asp-route-id="@Model.ActivityBookingId"
               class="review-back-link">

                <i class="bi bi-arrow-left"></i>
                Booking Details

            </a>

        </div>

        <div class="review-card">

            <div class="review-heading">

                <span class="review-eyebrow">
                    SHARE YOUR EXPERIENCE
                </span>

                <h1>
                    @Model.ActivityName
                </h1>

                <p>
                    Your review helps other travellers make better choices.
                </p>

            </div>

            <form asp-controller="ActivityBookings"
                  asp-action="Review"
                  method="post"
                  id="reviewForm">

                @Html.AntiForgeryToken()

                <input asp-for="ActivityBookingId"
                       type="hidden" />

                <input asp-for="ActivityName"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="review-validation-summary">
                </div>

                <div class="rating-section">

                    <label>
                        Your Rating
                    </label>

                    <div class="star-rating"
                         id="starRating">

                        @for (
                            var ratingValue = 1;
                            ratingValue <= 5;
                            ratingValue++
                        )
                        {
                            <button type="button"
                                    class="star-button @(Model.Rating >= ratingValue ? "selected" : "")"
                                    data-rating="@ratingValue"
                                    aria-label="@ratingValue star">

                                <i class="bi bi-star-fill"></i>

                            </button>
                        }

                    </div>

                    <input asp-for="Rating"
                           type="hidden"
                           id="Rating" />

                    <div class="rating-text"
                         id="ratingText">

                        @if (Model.Rating == 1)
                        {
                            <text>Poor</text>
                        }
                        else if (Model.Rating == 2)
                        {
                            <text>Fair</text>
                        }
                        else if (Model.Rating == 3)
                        {
                            <text>Good</text>
                        }
                        else if (Model.Rating == 4)
                        {
                            <text>Very Good</text>
                        }
                        else if (Model.Rating == 5)
                        {
                            <text>Excellent</text>
                        }
                        else
                        {
                            <text>Select your rating</text>
                        }

                    </div>

                    <span asp-validation-for="Rating"
                          class="review-validation">
                    </span>

                </div>

                <div class="review-comment-section">

                    <div class="review-label-row">

                        <label asp-for="Comment">
                            Comment
                        </label>

                        <span id="commentCounter">
                            0 / 800
                        </span>

                    </div>

                    <textarea asp-for="Comment"
                              id="reviewComment"
                              class="review-comment-input"
                              maxlength="800"
                              placeholder="What did you enjoy? What should future travellers know?"></textarea>

                    <span asp-validation-for="Comment"
                          class="review-validation">
                    </span>

                </div>

                <div class="review-notice">

                    <i class="bi bi-info-circle"></i>

                    <div>
                        <strong>
                            One review per booking
                        </strong>

                        <span>
                            Your review can only be submitted once.
                            Please check your rating and comment before submitting.
                        </span>
                    </div>

                </div>

                <div class="review-actions">

                    <a asp-controller="ActivityBookings"
                       asp-action="Details"
                       asp-route-id="@Model.ActivityBookingId"
                       class="review-cancel-button">

                        <i class="bi bi-x-lg"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="review-submit-button">

                        <i class="bi bi-star-fill"></i>

                        <span>
                            Save Review
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<style>

    .activity-review-page {
        min-height: calc(100vh - 80px);
        padding: 38px 20px 70px;
        background: #f7f8fc;
    }

    .review-container {
        width: min(1050px, 100%);
        margin: 0 auto;
    }

    .review-back-row {
        margin-bottom: 14px;
    }

    .review-back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #ff5b61;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
    }

        .review-back-link:hover {
            color: #e34850;
        }

    .review-card {
        padding: 42px;
        border: 1px solid #e8eaf0;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 12px 35px rgba(20, 31, 55, .06);
    }

    .review-heading {
        margin-bottom: 28px;
    }

    .review-eyebrow {
        display: block;
        margin-bottom: 12px;
        color: #ff5b61;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.2px;
    }

    .review-heading h1 {
        margin: 0;
        color: #1d2941;
        font-size: 32px;
        font-weight: 950;
        letter-spacing: -.6px;
    }

    .review-heading p {
        margin: 8px 0 0;
        color: #778195;
        font-size: 12px;
    }

    .rating-section {
        margin-bottom: 26px;
    }

        .rating-section > label {
            display: block;
            margin-bottom: 9px;
            color: #273146;
            font-size: 11px;
            font-weight: 850;
        }

    .star-rating {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .star-button {
        width: 38px;
        height: 42px;
        padding: 0;
        border: 0;
        background: transparent;
        color: #d9dde5;
        font-size: 29px;
        cursor: pointer;
        transition: color .15s ease, transform .15s ease;
    }

        .star-button:hover,
        .star-button.hovered,
        .star-button.selected {
            color: #ffa313;
        }

        .star-button:hover {
            transform: scale(1.08);
        }

    .rating-text {
        min-height: 17px;
        margin-top: 4px;
        color: #8a94a5;
        font-size: 9px;
        font-weight: 700;
    }

    .review-comment-section {
        margin-top: 5px;
    }

    .review-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 8px;
    }

        .review-label-row label {
            color: #273146;
            font-size: 11px;
            font-weight: 850;
        }

        .review-label-row span {
            color: #9ba3b2;
            font-size: 8px;
        }

    .review-comment-input {
        width: 100%;
        min-height: 165px;
        padding: 14px;
        border: 1px solid #dfe3ea;
        border-radius: 11px;
        outline: none;
        resize: vertical;
        background: #ffffff;
        color: #273146;
        font-family: inherit;
        font-size: 11px;
        line-height: 1.6;
        box-sizing: border-box;
        transition: border-color .18s ease, box-shadow .18s ease;
    }

        .review-comment-input:focus {
            border-color: #ff8a8e;
            box-shadow: 0 0 0 3px rgba(255, 91, 97, .08);
        }

        .review-comment-input::placeholder {
            color: #a2a9b5;
        }

    .review-validation {
        display: block;
        min-height: 15px;
        margin-top: 5px;
        color: #ef4444;
        font-size: 9px;
        font-weight: 700;
    }

    .review-validation-summary {
        margin-bottom: 15px;
        color: #dc2626;
        font-size: 10px;
    }

        .review-validation-summary:empty {
            display: none;
        }

    .review-notice {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 18px;
        padding: 12px 14px;
        border: 1px solid #dbeafe;
        border-radius: 10px;
        background: #eff6ff;
    }

        .review-notice > i {
            color: #2563eb;
            font-size: 15px;
        }

        .review-notice strong {
            display: block;
            color: #2563eb;
            font-size: 9px;
            font-weight: 850;
        }

        .review-notice span {
            display: block;
            margin-top: 2px;
            color: #64748b;
            font-size: 8px;
        }

    .review-actions {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 10px;
        margin-top: 22px;
    }

    .review-cancel-button,
    .review-submit-button {
        height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 10px;
        font-weight: 850;
        text-decoration: none;
        cursor: pointer;
    }

    .review-cancel-button {
        border: 1px solid #dfe3e9;
        background: #ffffff;
        color: #687386;
    }

        .review-cancel-button:hover {
            background: #f8fafc;
            color: #273146;
        }

    .review-submit-button {
        border: 0;
        background: #ff5b61;
        color: #ffffff;
        box-shadow: 0 8px 20px rgba(255, 91, 97, .18);
    }

        .review-submit-button:hover {
            background: #ea4c54;
        }

    @@media(max-width:700px) {

        .activity-review-page {
            padding: 25px 14px 50px;
        }

        .review-card {
            padding: 24px;
        }

        .review-heading h1 {
            font-size: 25px;
        }

        .review-actions {
            grid-template-columns: 1fr;
        }

        .review-cancel-button {
            order: 2;
        }

        .review-submit-button {
            order: 1;
        }
    }

</style>

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const ratingInput =
                document.getElementById(
                    "Rating");

            const starButtons =
                document.querySelectorAll(
                    ".star-button");

            const ratingText =
                document.getElementById(
                    "ratingText");

            const commentInput =
                document.getElementById(
                    "reviewComment");

            const commentCounter =
                document.getElementById(
                    "commentCounter");


            const ratingNames = {
                1: "Poor",
                2: "Fair",
                3: "Good",
                4: "Very Good",
                5: "Excellent"
            };


            function updateStars(
                rating)
            {
                starButtons.forEach(
                    function (button) {

                        const value =
                            parseInt(
                                button.dataset.rating);

                        button.classList.toggle(
                            "selected",
                            value <= rating);

                    });


                if (ratingText) {

                    ratingText.textContent =
                        ratingNames[rating]
                        ?? "Select your rating";

                }
            }


            starButtons.forEach(
                function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            const rating =
                                parseInt(
                                    this.dataset.rating);

                            if (ratingInput) {

                                ratingInput.value =
                                    rating;

                            }

                            updateStars(
                                rating);

                        });


                    button.addEventListener(
                        "mouseenter",
                        function () {

                            const rating =
                                parseInt(
                                    this.dataset.rating);

                            starButtons.forEach(
                                function (star) {

                                    const value =
                                        parseInt(
                                            star.dataset.rating);

                                    star.classList.toggle(
                                        "hovered",
                                        value <= rating);

                                });

                        });


                    button.addEventListener(
                        "mouseleave",
                        function () {

                            starButtons.forEach(
                                function (star) {

                                    star.classList.remove(
                                        "hovered");

                                });

                        });

                });


            function updateCommentCounter()
            {
                if (
                    !commentInput ||
                    !commentCounter
                ) {
                    return;
                }

                commentCounter.textContent =
                    commentInput.value.length +
                    " / 800";
            }


            commentInput?.addEventListener(
                "input",
                updateCommentCounter);


            const initialRating =
                parseInt(
                    ratingInput?.value || "0");


            updateStars(
                initialRating);


            updateCommentCounter();

        });

</script>