@model TravelPlanningSystem.ViewModels.ActivityBookingViewModel
@{
    ViewData["Title"] = "Book Activity";
}
<link rel="stylesheet" href="~/css/activities.css" />

<div class="form-page">
    <div class="container narrow-container">
        <div class="form-page-header"><a asp-controller="Activity" asp-action="Details" asp-route-id="@Model.ActivityId"><i class="bi bi-arrow-left"></i> Back to activity</a><h1>Complete your reservation</h1><p>Enter your contact details and review the booking total.</p></div>
        <div class="checkout-layout">
            <form asp-action="Create" method="post" class="form-card" id="bookingForm">
                <input asp-for="ActivityId" type="hidden" /><input asp-for="ActivitySessionId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
                <div class="form-section-title"><span>1</span><div><h3>Traveller information</h3><p>We will send the confirmation to these contact details.</p></div></div>
                <div class="row g-3">
                    <div class="col-12"><label asp-for="ContactName" class="form-label"></label><input asp-for="ContactName" class="form-control form-control-lg" placeholder="Full name" /><span asp-validation-for="ContactName" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="ContactEmail" class="form-label"></label><input asp-for="ContactEmail" class="form-control form-control-lg" placeholder="name@example.com" /><span asp-validation-for="ContactEmail" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="ContactPhone" class="form-label"></label><input asp-for="ContactPhone" class="form-control form-control-lg" placeholder="012-3456789" /><span asp-validation-for="ContactPhone" class="text-danger"></span></div>
                </div>
                <hr />
                <div class="form-section-title"><span>2</span><div><h3>Participants</h3><p>Choose the total number of people joining.</p></div></div>
                <label asp-for="ParticipantCount" class="form-label"></label>
                <select asp-for="ParticipantCount" class="form-select form-select-lg" id="participantCount">
                    @for (var i = 1; i <= Math.Min(Model.AvailableSlots, 20); i++)
                    {
                        <option value="@i">@i participant@(i > 1 ? "s" : "")</option>
                    }
                </select>
                <span asp-validation-for="ParticipantCount" class="text-danger"></span>
                <button type="submit" class="btn btn-confirm-booking"><i class="bi bi-lock-fill"></i> Confirm reservation</button>
                <p class="form-security"><i class="bi bi-shield-lock"></i> Your information is used only for this booking.</p>
            </form>
            <aside class="summary-card">
                <span class="summary-label">Activity summary</span><h3>@Model.ActivityName</h3><p><i class="bi bi-geo-alt"></i> @Model.Destination</p>
                <div class="summary-divider"></div>
                <div class="summary-line"><span>Price per person</span><strong>RM @Model.PricePerPerson.ToString("N2")</strong></div>
                <div class="summary-line"><span>Participants</span><strong id="participantText">1</strong></div>
                <div class="summary-divider"></div>
                <div class="summary-total"><span>Total amount</span><strong id="bookingTotal">RM @Model.PricePerPerson.ToString("N2")</strong></div>
                <small>No hidden fees are added to your booking.</small>
            </aside>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>window.activityPrice = @Model.PricePerPerson.ToString(System.Globalization.CultureInfo.InvariantCulture);</script>
    <script src="~/js/activity-booking.js"></script>
}
